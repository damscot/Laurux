Public Sub T13ParseDivers()

  Dim sPage As String
  Dim aRes As String[]

  TestKit.Check("T13/Fcolr/complet", Utils.Fcolr("background: 123; font: x; foreground: 456;"))
  TestKit.Check("T13/Fcolr/sans_espace", Utils.Fcolr("background:123;font:x;foreground:456"))
  TestKit.Check("T13/Fcolr/vide", Utils.Fcolr(""))
  TestKit.Check("T13/Fcolr/majuscules", Utils.Fcolr("Background: &HFF00FF&; Foreground: &H000000&"))
  ' Fcoulfond met la chaîne en minuscules puis compare à "R"/"G"/"B" : jamais trouvé (candidat anomalie)
  TestKit.Check("T13/Fcoulfond/RGB", Utils.Fcoulfond("R: 1,G: 2,B: 3"))
  TestKit.Check("T13/Fcoulfond/vide", Utils.Fcoulfond(""))
  ' Nsoc renvoie une String déclarée String[] : erreur de type à chaque appel (candidat anomalie)
  Try aRes = Utils.Nsoc("01:Soc")
  If Error Then
    TestKit.Check("T13/Nsoc/01:Soc", "ERREUR: " & Error.Text)
  Else
    TestKit.Check("T13/Nsoc/01:Soc", aRes)
  Endif
  Try aRes = Utils.Nsoc("01")
  If Error Then
    TestKit.Check("T13/Nsoc/sans", "ERREUR: " & Error.Text)
  Else
    TestKit.Check("T13/Nsoc/sans", aRes)
  Endif
  TestKit.Check("T13/PageFormatSupported", Utils.PageFormatSupported())
  For Each sPage In ["A4 Portrait", "A4 Paysage", "A5 Portrait", "A5 Paysage", "Lettre"]
    TestKit.Check("T13/PageFormat/" & sPage, Utils.PageFormatGetX(sPage) & "x" & Utils.PageFormatGetY(sPage))
  Next
  TestKit.Check("T13/Coulfd", Utils.Coulfd())

End

Public Sub T14Option()

  Dim aValeurs As Variant[] = [Null, "0", "1", False, True]
  Dim vBois, vPp As Variant
  Dim i, j As Integer

  For i = 0 To aValeurs.Max
    For j = 0 To aValeurs.Max
      vBois = aValeurs[i]
      vPp = aValeurs[j]
      Start.LocalSettings["/Soc01/bois"] = vBois
      Start.LocalSettings["/Soc01/pp"] = vPp
      TestKit.Check("T14/bois=" & TestKit.Canonique(vBois) & "/pp=" & TestKit.Canonique(vPp), Utils.Option())
    Next
  Next

End

