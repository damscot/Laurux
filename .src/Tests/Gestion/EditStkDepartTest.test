' Gambas test file

''Tests de EditStkDepart (.hidden/reference/.src/Gestion/option/EditStkDepart.class/test.md, EDITSTKDEPART-T01 à T06).
''Valeurs attendues : assets/EditStkDepartTest/expected.txt, produites dans le clone de référence.
''Le rapport (gb.report) est construit sans impression ; on relève les textes des ReportLabel dans l'ordre de
''l'arbre (pdftotext ne rend rien sur une édition gb.report). Jeu editstkdepart_shared/cmat_base.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01StockFin", "Stock de fin : textes du rapport (régies, sous-totaux par degré, totaux)")
  TestKit.Desc("T02StockDepart", "Stock de départ (art_stkdep) : textes du rapport")
  TestKit.Desc("T03Inventaire", "Inventaire fin d'année (Fiches_Inv) : textes du rapport")
  TestKit.Desc("T04InventaireTournant", "Inventaire tournant (Fiches_InvT) : textes du rapport")
  TestKit.Desc("T05RegieVide", "Article à code régie vide (art_dra = '') : textes du rapport (A01 figée)")
  TestKit.Desc("T06AucunArticle", "Aucun article soumis à régie : rapport sans ligne, Application.Busy revenu à 0")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "EditStkDepartTest")
  TestKit.OuvreBase("editstkdepart_shared/cmat_base")

End

Private Sub Textes(hObj As Object, aRes As String[])

  Dim hChild As Object
  Dim cChildren As Object

  If Object.Type(hObj) = "ReportLabel" Then aRes.Add(Object.GetProperty(hObj, "Text"))
  Try cChildren = Object.GetProperty(hObj, "Children")
  If Error Then Return
  If Not cChildren Then Return
  For Each hChild In cChildren
    Textes(hChild, aRes)
  Next

End

Private Sub Edition(Cle As String, Choix As Integer)

  Dim hR As EditStkDepart
  Dim aRes As New String[]
  Dim hDte As LDate
  Dim i As Integer

  Try hR = New EditStkDepart(Choix)
  If Error Then
    TestKit.Check(Cle, "ERREUR: " & Error.Text)
    Return
  Endif
  Textes(hR, aRes)
  hDte = New LDate(Now)
  For i = 0 To aRes.Max
    If aRes[i] = hDte.L Then aRes[i] = "<date du jour>"
  Next
  TestKit.Check(Cle & "/nb_labels", aRes.Count)
  TestKit.Check(Cle & "/textes", aRes.Join(" | "))
  TestKit.Check(Cle & "/busy", Application.Busy)

End

Public Sub T01StockFin()

  Edition("T01", EditStkDepart.fin)

End

Public Sub T02StockDepart()

  Edition("T02", EditStkDepart.depart)

End

Public Sub T03Inventaire()

  Edition("T03", EditStkDepart.inventaire)

End

Public Sub T04InventaireTournant()

  Edition("T04", EditStkDepart.tournant)

End

Public Sub T05RegieVide()

  Utils.db.Exec("UPDATE Fiches_Art SET art_dra = '' WHERE art_code = '003'")
  Edition("T05", EditStkDepart.fin)

End

Public Sub T06AucunArticle()

  Utils.db.Exec("UPDATE Fiches_Art SET art_dra = NULL")
  Edition("T06", EditStkDepart.fin)

End
