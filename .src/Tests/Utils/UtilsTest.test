  Dim i As Integer

  TestKit.Check("T05/Date/Cdate_Dbase", Utils.Cdate_Dbase(dD))
  TestKit.Check("T05/Date/Cdate2_Dbase", Utils.Cdate2_Dbase(dD))
  TestKit.Check("T05/Date/Cdate_Aff", Utils.Cdate_Aff(dD))
  TestKit.Check("T05/Date/Cdate_Carte", Utils.Cdate_Carte(dD))
  TestKit.Check("T05/Date/Cdate_Com", Utils.Cdate_Com(dD))
  TestKit.Check("T05/Date/Cdate_Comp2", Utils.Cdate_Comp2(dD))
  TestKit.Check("T05/Date/Cdate_Ciel", Utils.Cdate_Ciel(dD))
  ' UTILS-A05 : masque YY non interprété par Format$ (figé)
  TestKit.Check("T05/Date/Cdate_Cador", Utils.Cdate_Cador(dD))
  TestKit.Check("T05/Date/Cdate_Sage", Utils.Cdate_Sage(dD))
  For i = 0 To aChaines.Max
    TestKit.Check("T05/" & i & "/Cdate_Dbase", Utils.Cdate_Dbase(aChaines[i]))
    TestKit.Check("T05/" & i & "/Cdate2_Dbase", Utils.Cdate2_Dbase(aChaines[i]))
    TestKit.Check("T05/" & i & "/Cdate_Aff", Utils.Cdate_Aff(aChaines[i]))
    TestKit.Check("T05/" & i & "/Cdate_Carte", Utils.Cdate_Carte(aChaines[i]))
    TestKit.Check("T05/" & i & "/Cdate_Com", Utils.Cdate_Com(aChaines[i]))
    TestKit.Check("T05/" & i & "/Cdate_Comp2", Utils.Cdate_Comp2(aChaines[i]))
    TestKit.Check("T05/" & i & "/Cdate_Ciel", Utils.Cdate_Ciel(aChaines[i]))
    TestKit.Check("T05/" & i & "/Cdate_Cador", Utils.Cdate_Cador(aChaines[i]))
    TestKit.Check("T05/" & i & "/Cdate_Sage", Utils.Cdate_Sage(aChaines[i]))
  Next

End

Public Sub T06CdateComp()

  Dim aChaines As String[] = ["2024-01-31", "01-31-2024", "2024.01.31", "01.31.2024", "2024/01/31", "01/31/2024", "20240131", "2024-01-31 10:20:30"]
  ' 999905 et 99990105 (branches LSL) : non exercés, ils bloquent (délai dépassé, Message probable dans LDate)
  Dim aEntiers As Integer[] = [2024, 202401, 20240131]
  Dim i As Integer
  Dim sRes As String
  Dim vVal As Variant

  TestKit.Check("T06/Date", Utils.Cdate_Comp(Date(2024, 1, 31, 10, 20, 30)))
  For i = 0 To aChaines.Max
    TestKit.Check("T06/S/" & aChaines[i], Utils.Cdate_Comp(aChaines[i]))
  Next
  For i = 0 To aEntiers.Max
    vVal = aEntiers[i]
    Try sRes = Utils.Cdate_Comp(vVal)
    If Error Then
      TestKit.Check("T06/I/" & aEntiers[i], "ERREUR: " & Error.Text)
    Else If sRes = Format(Now, "yyyymmdd") Then
      TestKit.Check("T06/I/" & aEntiers[i], "<date du jour>")
    Else
      TestKit.Check("T06/I/" & aEntiers[i], sRes)
    Endif
  Next
  vVal = CLong(2023)
  Try sRes = Utils.Cdate_Comp(vVal)
  If Error Then
    TestKit.Check("T06/L/2023", "ERREUR: " & Error.Text)
  Else
    TestKit.Check("T06/L/2023", sRes)
  Endif

End

Public Sub T07CdateCalc()

  ' Mois et année courants injectés quand ils manquent dans la saisie : vérifiés par différence avec Now
  ' (dMois, dAnnee) ; les composants saisis sont vérifiés en valeur. Entrées invalides (Message.Error) non exercées.
  Dim aEntrees As String[] = ["05", "0503", "050324", "05.03.2024", "05/03/2024", "29022024"]
  Dim aMoisSaisi As Boolean[] = [False, True, True, True, True, True]
  Dim aAnneeSaisie As Boolean[] = [False, False, True, True, True, True]
  Dim i As Integer
  Dim sEntree As String
  Dim dRes As Date

  For i = 0 To aEntrees.Max
    sEntree = aEntrees[i]
    Try dRes = Utils.Cdate_calc(sEntree)
    If Error Then
      TestKit.Check("T07/" & sEntree, "ERREUR: " & Error.Text)
    Else
      TestKit.Check("T07/" & sEntree & "/jour", Day(dRes))
      TestKit.Check("T07/" & sEntree & "/heure", Format(dRes, "hh:nn:ss"))
      If aMoisSaisi[i] Then
        TestKit.Check("T07/" & sEntree & "/mois", Month(dRes))
      Else
        TestKit.Check("T07/" & sEntree & "/dMois", Month(dRes) - Month(Now))
      Endif
      If aAnneeSaisie[i] Then
        TestKit.Check("T07/" & sEntree & "/annee", Year(dRes))
      Else
        TestKit.Check("T07/" & sEntree & "/dAnnee", Year(dRes) - Year(Now))
      Endif
    Endif
  Next
  Try dRes = Utils.Cdate_calc(Null)
  If Error Then
    TestKit.Check("T07/Null", "ERREUR: " & Error.Text)
  Else
    TestKit.Check("T07/Null", dRes)
  Endif

End

Public Sub T08Mois()

  Dim i As Integer
  Dim sRes As String

  For i = 1 To 12
    TestKit.Check("T08/Calc_mois/D/" & i, Utils.Calc_mois(Date(2023, i, 31 - IIf(i = 2, 3, 0) - IIf(i = 4 Or i = 6 Or i = 9 Or i = 11, 1, 0))))
    TestKit.Check("T08/Calc_mois/S/" & i, Utils.Calc_mois(Format(i, "00") & ".15.2023"))
    TestKit.Check("T08/lastday/2023/" & i, Utils.lastday(Date(2023, i, 1)))
  Next
  TestKit.Check("T08/Calc_mois/D/2024-01-31", Utils.Calc_mois(Date(2024, 1, 31)))
  TestKit.Check("T08/lastday/2024/2", Utils.lastday(Date(2024, 2, 10)))
  TestKit.Check("T08/lastday/2100/2", Utils.lastday(Date(2100, 2, 10)))
  TestKit.Check("T08/lastday/2000/2", Utils.lastday(Date(2000, 2, 10)))
  For i = 0 To 13
    TestKit.Check("T08/mois/" & i, Utils.mois(i))
  Next
  Try sRes = Utils.Calc_mois("")
  If Error Then
    TestKit.Check("T08/Calc_mois/vide", "ERREUR: " & Error.Text)
  Else
    TestKit.Check("T08/Calc_mois/vide", sRes)
  Endif

End

Public Sub T09CalcechMatrice()

  ' Une clé par (durée, jours, fin de mois) : les résultats des 61 dates de facture séparés par « | ».
  Dim aDurees As String[] = ["00", "30", "45", "60", "90"]
  Dim aJours As String[] = ["00", "05", "10", "15", "25", "30"]
  Dim aFinMois As Boolean[] = [True, False]
  Dim aDates As String[]
  Dim aRes As String[]
  Dim sDuree, sJours, sDate, sRes As String
  Dim bFin As Boolean
  Dim m, j As Integer
  Dim iErreurs As Integer

  aDates = New String[]
  For m = 1 To 12
    For Each j In [1, 15, 28, 30, 31]
      aDates.Add(Format(j, "00") & "." & Format(m, "00") & ".2023")
    Next
  Next
  aDates.Add("29.02.2024")
  For Each sDuree In aDurees
    For Each sJours In aJours
      For Each bFin In aFinMois
        aRes = New String[]
        For Each sDate In aDates
          Try sRes = Utils.Calcech(sDuree, sJours, bFin, sDate)
          If Error Then
            aRes.Add(sDate & "=ERREUR: " & Error.Text)
            Inc iErreurs
          Else
            aRes.Add(sDate & "=" & sRes)
          Endif
        Next
        TestKit.Check("T09/" & sDuree & "/" & sJours & "/" & IIf(bFin, "FM", "NFM"), aRes.Join("|"))
      Next
    Next
  Next
  TestKit.Check("T09/nb_erreurs", iErreurs)

End

Public Sub T10Chaines()

  Dim aEntrees As String[] = ["Dupont \"et\" fils", "A & B", "ligne1\nligne2", "l'été", "çüéâäàêëèôö°", "", "à côté\n\"&'"]
