' Gambas test file

''Tests de commande1 (.hidden/reference/.src/Gestion/Stock/commande1.class/test.md, COMMANDE1-T01, T04, T05, T06, T10, T12).
''Écran instancié et affiché (New Commande1) : la fenêtre de sélection « Sélection des entrées » ($win) est retrouvée
''dans Windows ; ses radios reçoivent Value = True ; le choix d'un document dans la liste TriGen est remplacé par
''ColTri_MajSel (Bsel/Bval posés, Collection construite comme TriGen.Coltri_Click). Boutons de commande1 cliqués par
''Value = True (Last = bouton). Fenêtre modale « Valider les factures » et boîtes Message traitées par un Timer.
''Jeu commande1_shared/receptions (copie de validbr_shared/receptions, lignes de réception complètes). Valeurs attendues : assets/Commande1Test/expected.txt.

Private $hTimer As Timer
Private $hVue As Window
Private $sVu As String
Private $aBoutons As New String[]
Private $sDateEcr As String

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Selection", "Radios commandes, BR, BR validées : listes ; choix de la BR R00001 : document chargé, $win désactivée, verrou")
  TestKit.Desc("T04ValiderCompta", "BR R00001 en réception ; Valider les factures, date 15.06.2018, Avec écriture : validee = 1, Fiches_Mvt")
  TestKit.Desc("T05ValiderSansAbandon", "BR R00001 : Sans écriture (validee = 2) ; BR R00002 : Abandon (rien)")
  TestKit.Desc("T06Suppression", "BR R00001 (001, 002 avec tarifs temporaires) ; Supprimer : BR et tarifs temporaires (GESTAR-A01)")
  TestKit.Desc("T10OuvertureValidee", "New Commande1(Null, R00001, 401001, 01.06.2018, Validée) : document chargé, Enregistrer refusé")
  TestKit.Desc("T10OuvertureReception", "New Commande1(Null, R00001, 401001, 01.06.2018, Réception) : document chargé, verrou")
  TestKit.Desc("T12Fermeture", "BR chargée ; fermeture : « Non » (écran conservé) puis « Oui » (fermé, verrou libéré)")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "Commande1Test")
  TestKit.OuvreBase("commande1_shared/receptions")

End

Public Sub _Boite_Timer()
  ''Boîte Message : bouton suivant de $aBoutons (premier bouton si la liste est vide) ; fenêtre modale de validation
  ''(boutons Avec / Sans / Abandon) : date $sDateEcr saisie puis bouton suivant de $aBoutons.

  Dim hW As Window
  Dim hC As Object
  Dim sTxt As String

  For Each hW In Windows
    If hW = $hVue Then Continue
    If Object.Type(hW) = "FMessage" Then
      $hVue = hW
      For Each hC In hW.Controls
        If Object.Type(hC) = "Label" Or Object.Type(hC) = "TextLabel" Then $sVu &= Object.GetProperty(hC, "Text") & " / "
      Next
      For Each hC In hW.Controls
        If Object.Type(hC) = "Button" Then
          sTxt = Trim(Replace(Object.GetProperty(hC, "Text"), "&", ""))
          If $aBoutons.Count = 0 Or If sTxt = $aBoutons[0] Then
            If $aBoutons.Count Then $aBoutons.Remove(0)
            $sVu &= "[" & sTxt & "] / "
            hC.Value = True
            Return
          Endif
        Endif
      Next
    Else If Object.Type(hW) = "Window" And If hW.Visible And If $aBoutons.Count Then
      For Each hC In hW.Controls
        If Object.Type(hC) = "TextReg" Then hC.Text = $sDateEcr
      Next
      For Each hC In hW.Controls
        If Object.Type(hC) = "Button" Then
          sTxt = Replace(Object.GetProperty(hC, "Text"), "\n", " ")
          If sTxt = $aBoutons[0] Then
            $hVue = hW
            $aBoutons.Remove(0)
            $sVu &= "{" & sTxt & "} / "
            hC.Value = True
            Return
          Endif
        Endif
      Next
    Endif
  Next

End

Private Sub Demarre(aBoutons As String[])

  $aBoutons = aBoutons
  $sVu = ""
  $hVue = Null
  $hTimer = New Timer As "_Boite"
  $hTimer.Delay = 200
  $hTimer.Start

End

Private Sub Arrete(sCle As String)

  $hTimer.Stop
  TestKit.Check(sCle & "/boites", IIf($sVu, $sVu, "<aucune>"))

End

Private Function Selection() As Window

  Dim hW As Window

  For Each hW In Windows
    If Not Object.IsValid(hW) Then Continue
    If hW.Text = "Sélection des entrées" Then Return hW
  Next

End

Private Sub Radio(hWin As Window, sTexte As String)

  Dim hC As Object

  For Each hC In hWin.Controls
    If Object.Type(hC) = "RadioButton" And If hC.Text = sTexte Then
      hC.Value = True
      Return
    Endif
  Next

End

Private Sub Liste(sCle As String, hWin As Window)

  Dim hC, hG As Object
  Dim r, c As Integer
  Dim sLig, sTxt As String

  For Each hC In hWin.Controls
    If Object.Type(hC) = "GridView" Then hG = hC
  Next
  If Not hG Then
    TestKit.Check(sCle & "/liste", "<grille introuvable>")
    Return
  Endif
  For r = 0 To hG.Rows.Count - 1
    For c = 0 To hG.Columns.Count - 1
      sTxt = hG[r, c].Text
    Next
  Next
  TestKit.Check(sCle & "/lignes", hG.Rows.Count)
  For r = 0 To hG.Rows.Count - 1
    sLig = ""
    For c = 0 To hG.Columns.Count - 1
      sLig &= hG[r, c].Text & "|"
    Next
    TestKit.Check(sCle & "/l" & Format(r, "00"), sLig)
  Next

End

Private Sub Choisit(hF As Object, sFour As String, sNum As String, sDate As String)

  Dim cVal As New Collection
  Dim sErr As String

  cVal.Add(sFour, "Fiches_Entrecpt.four")
  cVal.Add(sNum, "Fiches_Entrecpt.numrecpt")
  cVal.Add(sDate, "Fiches_Entrecpt.ddate")
  hF.Bsel = True
  hF.Bval = cVal
  Try hF.ColTri_MajSel(cVal)
  If Error Then sErr = "ERREUR: " & Error.Text Else sErr = "<aucune>"
  TestKit.Check("choix_" & sNum & "/erreur", sErr)

End

Private Sub Ecran(sCle As String, hF As Object)

  Dim hWin As Window

  TestKit.Check(sCle & "/ecran", "fcode=" & hF.Controls["fcode"].Text & " fo_nom=" & hF.Controls["fo_nom"].Text & " nbl=" & hF.Controls["nbl"].Text & " ncom=" & hF.Controls["ncom"].Text & " dte=" & Replace(hF.Controls["dte"].Text, LDate(Now).L, "<aujourd'hui>"))
  TestKit.Check(sCle & "/rececp", hF.Controls["rececp"].Text & " (actif=" & hF.Controls["rececp"].Enabled & ")")
  TestKit.Check(sCle & "/lignes_doc", hF.tbl.ligne.Count)
  hWin = Selection()
  If hWin Then
    TestKit.Check(sCle & "/selection", "visible=" & hWin.Visible & " active=" & hWin.Enabled)
  Else
    TestKit.Check(sCle & "/selection", "<fermée>")
  Endif

End

Private Sub EtatBase(sCle As String)

  Dim r As Result

  r = Utils.db.Exec("SELECT four, numrecpt, validee FROM Fiches_Entrecpt ORDER BY four, numrecpt")
  If r.Available Then
    Repeat
      TestKit.Check(sCle & "/br_" & r!four & "_" & r!numrecpt, r!validee)
    Until r.MoveNext()
  Endif
  r = Utils.db.Exec("SELECT compte, libelle, numdoc, montantd, montantc, DATE_FORMAT(dte, '%Y-%m-%d') AS d FROM Fiches_Mvt ORDER BY lind")
  TestKit.Check(sCle & "/mvt_nombre", r.Count)
  If r.Available Then
    Repeat
      TestKit.Check(sCle & "/mvt_" & Format(r.Index, "00"), r!compte & "|" & r!libelle & "|" & r!numdoc & "|" & r!montantd & "|" & r!montantc & "|" & r!d)
    Until r.MoveNext()
  Endif
  r = Utils.db.Exec("SELECT doc_type, doc_num FROM " & Cbase.Table("TabActif") & " ORDER BY doc_type, doc_num")
  TestKit.Check(sCle & "/verrous", r.Count)
  If r.Available Then
    Repeat
      TestKit.Check(sCle & "/verrou_" & r.Index, r!doc_type & "|" & r!doc_num)
    Until r.MoveNext()
  Endif

End

Private Function Ouvre() As Object

  Dim hF As Object

  If Not Exist(User.Home & "/tmp") Then Mkdir User.Home & "/tmp"
  hF = New Commande1
  hF.Show
  Wait
  Return hF

End

Private Sub Ferme(hF As Object)

  Dim hWin As Window

  hWin = Selection()
  Object.Lock(hF)
  If hWin Then
    Object.Lock(hWin)
    hWin.Delete
  Endif
  hF.Delete

End

Public Sub T01Selection()
  ''COMMANDE1-T01 : radios « commandes », « BR », « BR validées » ; choix de la BR R00001 (radio BR).

  Dim hF As Object
  Dim hWin As Window

  hF = Ouvre()
  hWin = Selection()
  TestKit.Check("T01/fenetre_selection", Not IsNull(hWin))
  If IsNull(hWin) Then Return
  Liste("T01/ouverture", hWin)
  Radio(hWin, "Liste des commandes")
  Liste("T01/commandes", hWin)
  Radio(hWin, "Liste des bons de réception validées")
  Liste("T01/br_validees", hWin)
  Radio(hWin, "Liste des bons de réception")
  Liste("T01/br", hWin)
  Choisit(hF, "401001", "R00001", "01.06.2018")
  Ecran("T01/apres_choix", hF)
  EtatBase("T01")
  Ferme(hF)

End

Private Sub Valide(sCle As String, hF As Object, sBouton As String)

  Dim sErr As String

  $sDateEcr = "15.06.2018"
  Demarre([sBouton])
  ' Clic différé (Value = True) : traité pendant le Wait ; la fenêtre modale est fermée par le Timer
  Try hF.Controls["rececp"].Value = True
  If Error Then sErr = "ERREUR: " & Error.Text Else sErr = "<aucune>"
  Wait 1
  Arrete(sCle)
  TestKit.Check(sCle & "/erreur", sErr)

End

Public Sub T04ValiderCompta()
  ''COMMANDE1-T04 : BR R00001 (radio BR) ; « Valider les factures », date 15.06.2018, « Avec écriture comptable ».

  Dim hF As Object

  hF = Ouvre()
  Radio(Selection(), "Liste des bons de réception")
  Choisit(hF, "401001", "R00001", "01.06.2018")
  Valide("T04/avec", hF, "Avec écriture comptable")
  Ecran("T04/apres", hF)
  EtatBase("T04")
  Ferme(hF)

End

Public Sub T05ValiderSansAbandon()
  ''COMMANDE1-T05 : BR R00001 « Sans écriture comptable » ; puis BR R00002 « Abandon ».

  Dim hF As Object

  hF = Ouvre()
  Radio(Selection(), "Liste des bons de réception")
  Choisit(hF, "401001", "R00001", "01.06.2018")
  Valide("T05/sans", hF, "Sans écriture comptable")
  Ecran("T05/apres_sans", hF)
  Radio(Selection(), "Liste des bons de réception")
  Choisit(hF, "401001", "R00002", "05.06.2018")
  Valide("T05/abandon", hF, "Abandon")
  Ecran("T05/apres_abandon", hF)
  EtatBase("T05")
  Ferme(hF)

End

Public Sub T12Fermeture()
  ''COMMANDE1-T12 : BR R00001 chargée ; Close : « Non » (écran conservé), puis Close : « Oui » (écran fermé).

  Dim hF As Object
  Dim sErr As String

  hF = Ouvre()
  Radio(Selection(), "Liste des bons de réception")
  Choisit(hF, "401001", "R00001", "01.06.2018")
  EtatBase("T12/charge")
  Demarre(["Non"])
  Try hF.Close()
  If Error Then sErr = "ERREUR: " & Error.Text Else sErr = "<aucune>"
  Arrete("T12/non")
  TestKit.Check("T12/non/erreur", sErr)
  TestKit.Check("T12/non/visible", hF.Visible)
  Ecran("T12/non", hF)
  Demarre(["Oui"])
  Try hF.Close()
  If Error Then sErr = "ERREUR: " & Error.Text Else sErr = "<aucune>"
  Arrete("T12/oui")
  TestKit.Check("T12/oui/erreur", sErr)
  TestKit.Check("T12/oui/selection", IIf(IsNull(Selection()), "<fermée>", "ouverte"))
  EtatBase("T12/oui")

End

Private Sub Achats(sCle As String)

  Dim r As Result

  r = Utils.db.Exec("SELECT four, numrecpt, DATE_FORMAT(ddate, '%Y-%m-%d') AS d, montant, mttc, validee FROM Fiches_Entrecpt ORDER BY four, numrecpt")
  If r.Available Then
    Repeat
      TestKit.Check(sCle & "/entrecpt_" & r!numrecpt, r!four & "|" & r!d & "|" & r!montant & "|" & r!mttc & "|" & r!validee)
    Until r.MoveNext()
  Endif
  r = Utils.db.Exec("SELECT numrecpt, nligne, code, qte, paht, prvt FROM Fiches_Ligrecpt ORDER BY numrecpt, nligne")
  TestKit.Check(sCle & "/ligrecpt", r.Count)
  If r.Available Then
    Repeat
      TestKit.Check(sCle & "/ligrecpt_" & r!numrecpt & "_" & r!nligne, r!code & "|" & r!qte & "|" & r!paht & "|" & r!prvt)
    Until r.MoveNext()
  Endif
  r = Utils.db.Exec("SELECT COUNT(*) AS n FROM Fiches_Entcom")
  TestKit.Check(sCle & "/entcom", r!n)
  r = Utils.db.Exec("SELECT COUNT(*) AS n FROM Fiches_Ligcom")
  TestKit.Check(sCle & "/ligcom", r!n)
  r = Utils.db.Exec("SELECT dnbr, dncom FROM Fiches_Parametres")
  TestKit.Check(sCle & "/compteurs", "dnbr=" & r!dnbr & " dncom=" & r!dncom)
  r = Utils.db.Exec("SELECT art_code, art_qte, art_paht, art_pmp, art_dfour, art_dpa FROM Fiches_Art WHERE art_code IN ('001', '002') ORDER BY art_code")
  If r.Available Then
    Repeat
      TestKit.Check(sCle & "/art_" & r!art_code, r!art_qte & "|" & r!art_paht & "|" & r!art_pmp & "|" & r!art_dfour & "|" & r!art_dpa)
    Until r.MoveNext()
  Endif
  r = Utils.db.Exec("SELECT art, temp_type, code FROM Fiches_TarTemp ORDER BY art, temp_type, code")
  TestKit.Check(sCle & "/tartemp", r.Count)
  If r.Available Then
    Repeat
      TestKit.Check(sCle & "/tartemp_" & r.Index, r!art & "|" & r!temp_type & "|" & r!code)
    Until r.MoveNext()
  Endif

End

Private Sub Clique(sCle As String, hF As Object, sBouton As String)

  Dim sErr As String
  Dim aVide As New String[]

  Demarre(aVide)
  Try hF.Controls[sBouton].Value = True
  If Error Then sErr = "ERREUR: " & Error.Text Else sErr = "<aucune>"
  Wait 1
  Arrete(sCle)
  TestKit.Check(sCle & "/erreur", sErr)

End

Public Sub T06Suppression()
  ''COMMANDE1-T06 : BR R00001 (articles 001 et 002, chacun avec un tarif temporaire) ; « Supprimer ».

  Dim hF As Object

  hF = Ouvre()
  Radio(Selection(), "Liste des bons de réception")
  Choisit(hF, "401001", "R00001", "01.06.2018")
  Clique("T06/supprimer", hF, "suppr")
  Ecran("T06/apres", hF)
  Achats("T06")
  Ferme(hF)

End

Private Sub Externe(sCle As String, iEtat As Integer, bEnregistre As Boolean)
  ''Ouverture comme ValidBR1.TriBr_Activate / Stockmvt.GridView1_Activate, puis « Enregistrer la saisie » (ValideS)
  ''sans modification de ligne si bEnregistre.

  Dim hF As Object
  Dim sErr As String
  Dim aVide As New String[]

  If Not Exist(User.Home & "/tmp") Then Mkdir User.Home & "/tmp"
  hF = New Commande1(Null, "R00001", "401001", LDate("01.06.2018"), iEtat)
  Demarre(aVide)
  Try hF.Show
  If Error Then sErr = "ERREUR: " & Error.Text Else sErr = "<aucune>"
  Wait 0.5
  Arrete(sCle & "/ouverture")
  TestKit.Check(sCle & "/ouverture/erreur", sErr)
  Ecran(sCle & "/ouvert", hF)
  If bEnregistre Then
    Clique(sCle & "/enregistrer", hF, "ValideS")
    Ecran(sCle & "/apres", hF)
  Endif
  Achats(sCle)
  EtatBase(sCle)
  Ferme(hF)

End

Public Sub T10OuvertureValidee()
  ''COMMANDE1-T10 : New Commande1(Null, "R00001", "401001", 01.06.2018, Achat.Validee) ; Enregistrer refusé (ValCom).

  Externe("T10/validee", Achat.Validee, True)

End

Public Sub T10OuvertureReception()
  ''COMMANDE1-T10 : New Commande1(Null, "R00001", "401001", 01.06.2018, Achat.Reception) : document chargé.

  Externe("T10/reception", Achat.Reception, False)

End
