'# nom du fichier           : Calcsolde.class
'# Auteur                   : Jacky Tripoteau
'# date de création         : 21/05/2006
'# Recalcul des soldes à partir des écritures
'################################################

'*************************
'* On initialise l'écran *
'*************************
Public Sub form_Open()

  Music.Load(Start.Musique)
  Me.Center
  Utils.Observers(Me)

End

'***********************
'* On gere nos boutons *
'***********************
Public Sub Btn_Click()

  Select Case Last.tag

    Case 1
      Button2_Click()

    Case 2
      Me.Close

  End Select

End

'******************
'*   On calcule   *
'******************
Public Sub Button2_Click()

  Dim i As Integer
  Dim rResult As Result
  Dim compt As String
  Dim Tab As String
  
  Utils.MouseProcessing()
  Tab = "Fiches_Comptes"
  
  rResult = Utils.db.Exec("SELECT * FROM " & Tab & " order by cast(compte_cc AS char)")
  If rResult.Available Then
    Repeat
      compt = rResult!compte_cc
      If IsNull(compt) Then Continue
      Calcul(compt, rResult!comptr_cc)
    Until rResult.MoveNext()
  Endif

  Utils.MouseDefault()
  message.Info(" Traitement terminé", "OK")
  Me.Close

End


Public Sub Calcul(compt As String, Optional Treso As Boolean = True)

  Dim rResult As Result
  Dim rrResult As Result
  Dim Tab As String
  Dim Tab2 As String

  Tab = "Fiches_Mvt"
  Tab2 = "Fiches_Comptes"
  
  If IsNull(compt) Then Return
  
  rResult = Utils.db.Exec("SELECT (sum(montantd)-sum(montantc)) as solde FROM " & Tab & " WHERE compte = &1  and validee = &2", compt, 1)
  If rResult.Available Then
    If IsNull(rResult!solde) Then
      Utils.db.Exec("UPdate " & Tab2 & "  SET solde = &2 where compte_cc = &1", Compt, LPrix(0).D)
    Else
      Utils.db.Exec("UPdate " & Tab2 & "  SET solde = &2 where compte_cc = &1", Compt, LPrix(rResult!solde).D)
      'Cas d'un compte de Trésorerie on met a jour le solde des ecritures pointée
      If Treso Then
        rResult = Utils.db.Exec("SELECT (sum(montantd)-sum(montantc)) as soldepointee FROM  " & Tab & " WHERE compte = &1 and ((cloturee = 1 and jour = 90 and libelle = &2) or (pointee = 1))", compt, "Report a nouveau")
        If rResult.Available Then
          If IsNull(rResult!soldepointee) Then
            Utils.db.Exec("UPdate " & Tab2 & "  SET soldep = &2 where compte_cc = &1", Compt, LPrix(0).D)
          Else
            Utils.db.Exec("UPdate " & Tab2 & "  SET soldep = &2 where compte_cc = &1", Compt, LPrix(rResult!soldepointee).D)
          Endif
        Endif
      Endif
    Endif
  Endif
  
End

