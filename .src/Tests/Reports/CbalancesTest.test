' Gambas test file

''Tests de Cbalances (.hidden/reference/.src/Reports/Cbalances.class/test.md, CBALANCES-T01 à T04).
''Chaque test produit un PDF non compressé (SetCompression(False)) dans un fichier temporaire et vérifie :
''le texte rendu par « pdftotext -layout » (une clé par ligne non vide), le nombre et la taille des pages
''(pdfinfo) et l'empreinte md5 du fichier PDF (flux : positions, polices, couleurs), après masquage de
''/CreationDate, de la date du jour et de User.Name. Valeurs attendues : assets/CbalancesTest/expected.txt,
''produites dans le clone de référence. Pas de base de données. T05, T06 (rejeux) restent à faire.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01HorsPeriode", "Balance avec cumul hors période : Entete, Level0, Level1, 3 Level2, Level3, Level4, BasPage")
  TestKit.Desc("T02Simple", "Balance simple : Level1a, Level2a (12.5/0, vide/3, 1234.56), Level2s, Level2sbis, Level3a, Level4a")
  TestKit.Desc("T03Tva", "État de TVA : Level0T, Level1T, Level3T, Level2T, Level4T, Level4TVA 1 et 2, Level5T (négatif et positif)")
  TestKit.Desc("T04MultiPages", "3 pages (Entete + 60 Level2a + BasPage) : Page 1/3 à 3/3")

End

Public Sub _Setup()

  TestKit.Begin("Reports", "CbalancesTest")

End

Private Function Nouveau(Optional sOrient As String = "Portrait", Optional sFormat As String = "A4") As Cbalances

  Dim pdf As Cbalances

  pdf = New Cbalances(sOrient, "mm", sFormat)
  pdf.SetCompression(False)
  pdf.Open()
  pdf.AliasNbPages()
  Return pdf

End

' Écrit le PDF, vérifie chaque ligne non vide du texte extrait puis l'empreinte du fichier masqué.
Private Sub Verifie(sCle As String, pdf As Cbalances)

  Dim sFic As String = Temp$("rep") & ".pdf"
  Dim sTxt As String
  Dim sLig As String
  Dim sBuf As String
  Dim sMd5 As String
  Dim n As Integer

  Try pdf.Output(sFic, False)
  If Error Then
    TestKit.Check(sCle & "/output", "ERREUR: " & Error.Text)
    Return
  Endif
  Shell "pdftotext -layout " & Shell$(sFic) & " -" To sTxt
  sTxt = Replace(sTxt, Format$(Date(Now), "dd/mm/yyyy"), "<date>")
  sTxt = Replace(sTxt, User.Name, "<utilisateur>")
  sTxt = Replace(sTxt, "\f", "<saut de page>\n")
  For Each sLig In Split(sTxt, "\n")
    sLig = RTrim(sLig)
    If sLig = "" Then Continue
    Inc n
    TestKit.Check(sCle & "/l" & Format$(n, "000"), sLig)
  Next
  TestKit.Check(sCle & "/lignes", n)
  Shell "pdfinfo " & Shell$(sFic) & " | grep -E '^(Pages|Page size)'" To sBuf
  TestKit.Check(sCle & "/pdfinfo", Trim(sBuf))
  ' Flux : masquage des valeurs variables puis empreinte
  sBuf = File.Load(sFic)
  sTxt = ""
  For Each sLig In Split(sBuf, "\n")
    If InStr(sLig, "/CreationDate") > 0 Then Continue
    sTxt &= sLig & "\n"
  Next
  sTxt = Replace(sTxt, Format$(Date(Now), "dd/mm/yyyy"), "<date>")
  sTxt = Replace(sTxt, User.Name, "<utilisateur>")
  File.Save(sFic & ".flux", sTxt)
  Shell "md5sum < " & Shell$(sFic & ".flux") To sMd5
  TestKit.Check(sCle & "/flux_md5", Trim(Left(sMd5, 32)))

End

Public Sub T01HorsPeriode()

  Dim pdf As Cbalances = Nouveau()

  pdf.Entete("Balance générale")
  pdf.Level0("Balance du 01/01/2018 au 30/06/2018", "15/06/2018", "Société test")
  pdf.Level1()
  pdf.Level2("401001", "Fournisseur un", "100,00", "0,00", "10,00", "0,00", "110,00", "0,00", "110,00", 40)
  pdf.Level2("411001", "Client un", "0,00", "50,00", "0,00", "5,00", "0,00", "55,00", "-55,00", 45)
  pdf.Level2("512000", "Banque", "1234,56", "1234,56", "", "", "1234,56", "1234,56", "0,00", 50)
  pdf.Level3("4", "1334,56", "1284,56", "10,00", "5,00", "110,00", "55,00", "55,00", 55)
  pdf.Level4("1334,56", "1284,56", "10,00", "5,00", "110,00", "55,00", "55,00", 65)
  pdf.BasPage()
  Verifie("T01", pdf)

End

Public Sub T02Simple()

  Dim pdf As Cbalances = Nouveau()

  pdf.Entete("Balance simple")
  pdf.Level1a()
  Try pdf.Level2a("401001", "Fournisseur un", "12.5", "0", 30)
  TestKit.Check("T02/level2a_1/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Level2a("411001", "Client un", "", "3", 35)
  TestKit.Check("T02/level2a_2/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Level2a("512000", "Banque", "1234.56", "1234.56", 40)
  TestKit.Check("T02/level2a_3/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Level2s("530000", "Caisse", "12.5", "0", 45)
  TestKit.Check("T02/level2s/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Level2sbis("530000", 50)
  TestKit.Check("T02/level2sbis/erreur", IIf(Error, Error.Text, ""))
  pdf.Level3a("4", "1247,06", "1237,56", 55)
  pdf.Level4a("1247,06", "1237,56", 65)
  pdf.BasPage()
  Verifie("T02", pdf)

End

Public Sub T03Tva()

  Dim pdf As Cbalances = Nouveau()

  pdf.Entete("État de TVA")
  pdf.Level0T("15/06/2018", "Société test")
  pdf.Level1T()
  pdf.Level3T("445710", "TVA collectée", 35)
  Try pdf.Level2T("Vente", "VE", "15/06/2018", "0", "1", "0", "20", "-20", 40)
  TestKit.Check("T03/level2t_0/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Level2T("Vente", "VE", "16/06/2018", Null, "2", "0", "10.5", "-30", 45)
  TestKit.Check("T03/level2t_null/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Level4T("0", "30", "-30", 50)
  TestKit.Check("T03/tot1/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Level4TVA("0", "30", "-30", 55, "1")
  TestKit.Check("T03/tot2/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Level4TVA("10.5", "0", "10.5", 60, "2")
  TestKit.Check("T03/tot3/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Level5T("10.5", "30", "-20", "30/06/2018", 70)
  TestKit.Check("T03/tot4/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Level5T("30", "10.5", "20", "30/06/2018", 85)
  TestKit.Check("T03/tot5/erreur", IIf(Error, Error.Text, ""))
  pdf.BasPage()
  Verifie("T03", pdf)

End

Public Sub T04MultiPages()

  Dim pdf As Cbalances = Nouveau()
  Dim p As Integer
  Dim i As Integer

  For p = 1 To 3
    pdf.Entete("Balance page " & p)
    pdf.Level1a()
    For i = 0 To 59
      pdf.Level2a(CStr(401000 + p * 100 + i), "Compte " & i, "1,00", "0,00", 25 + i * 4)
    Next
    pdf.BasPage()
  Next
  Verifie("T04", pdf)

End
