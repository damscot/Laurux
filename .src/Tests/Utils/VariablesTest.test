' Gambas test file

''Test de Variables (VARIABLES-T01, .hidden/reference/.src/Utils/Variables.module/test.md) : initialisation depuis
''les réglages (copie de Laurux-test.conf dans le HOME temporaire du runner) et valeur figée au premier accès.
''Valeurs attendues : assets/VariablesTest/expected.txt, produites dans le clone de référence.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01InitReglages", "Initialisation depuis les réglages")
  TestKit.Desc("T01bSansReglage", "Réglages absents (complément de VARIABLES-T01)")
  TestKit.Desc("T05CoefTypeC", "Articles → CoefTypeC : Variables.OrgCoefTypeCli/ArtCode/Artintitule/ArtTva/ArtHt posés comme Articles.Button9, valeurs affichées")

End

Public Sub _Setup()

  TestKit.Begin("Utils", "VariablesTest")

End

Private Sub Lecture(Cle As String)

  TestKit.Check(Cle & "/son", Variables.son)
  TestKit.Check(Cle & "/Sprix", Variables.Sprix)
  TestKit.Check(Cle & "/Sexport", Variables.Sexport)
  TestKit.Check(Cle & "/Simport", Variables.Simport)
  TestKit.Check(Cle & "/Schmprix", Variables.Schmprix)
  TestKit.Check(Cle & "/SMajArt", Variables.SMajArt)
  TestKit.Check(Cle & "/SMajFour", Variables.SMajFour)
  TestKit.Check(Cle & "/SMajCli", Variables.SMajCli)

End

Public Sub T01InitReglages()

  Dim sSoc As String = "/Soc" & Start.Societe

  TestKit.Check("T01/societe", Start.Societe)
  Start.LocalSettings["/son"] = "1"
  Start.LocalSettings[sSoc & "/Sprix"] = True
  Start.LocalSettings[sSoc & "/Sexport"] = "1"
  Start.LocalSettings[sSoc & "/Simport"] = False
  Start.LocalSettings[sSoc & "/Schmprix"] = "/tmp/prix.csv"
  Start.LocalSettings[sSoc & "/SMajArt"] = True
  Start.LocalSettings[sSoc & "/SMajFour"] = "0"
  Start.LocalSettings[sSoc & "/SMajCli"] = 1
  Lecture("T01/initial")
  ' Changement de réglage après le premier accès : valeurs figées
  Start.LocalSettings["/son"] = "0"
  Start.LocalSettings[sSoc & "/Sprix"] = False
  Start.LocalSettings[sSoc & "/Schmprix"] = "/autre.csv"
  Lecture("T01/apreschangement")

End

Public Sub T01bSansReglage()
  ''Complément de T01 : réglages absents (valeurs par défaut des conversions).

  Lecture("T01b/absent")

End

Public Sub T05CoefTypeC()
  ''VARIABLES-T05 : transmission des variables de l'article à CoefTypeC, posées comme le fait Articles.Button9_Click
  ''(écran Articles en revue manuelle) ; CoefTypeC instancié sans affichage, Form_Open appelé, 1re ligne
  ''(coefficient 1,500, type 01) puis 2e ligne choisies par MoveTo + Tabtypec_Click (calcul AffProduit). Jeu Gestion/coeftypec_shared/coeftypec_deux.

  Dim hF As CoefTypeC
  Dim hTab, hL As Object
  Dim sCle, sNom As String

  TestKit.OuvreBase("Gestion/coeftypec_shared/coeftypec_deux")
  Start.LocalSettings["/Coul/Znaff"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Focus"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Znss"] = "background: 16777215;"
  Variables.OrgCoefTypeCli = "Art"
  Variables.ArtCode = "001"
  Variables.Artintitule = "Produit 2.10"
  Variables.ArtTva = "20"
  Variables.ArtHt = "10,00"
  Try hF = New CoefTypeC
  If Error Then
    TestKit.Check("T05/new", "ERREUR: " & Error.Text)
    Return
  Endif
  Try hF.Form_Open()
  If Error Then TestKit.Check("T05/open", "ERREUR: " & Error.Text & " @ " & Error.Where)
  hTab = hF.Controls["TabTypec"]
  TestKit.Check("T05/panel1", hF.Controls["Panel1"].Visible)
  For Each sCle In ["1", "2"]
    Try hTab.MoveTo(sCle)
    If Error Then
      TestKit.Check("T05/" & sCle & "/moveto", "ERREUR: " & Error.Text)
      Continue
    Endif
    Try hF.Tabtypec_Click()
    If Error Then TestKit.Check("T05/" & sCle & "/click", "ERREUR: " & Error.Text & " @ " & Error.Where)
    For Each sNom In ["Cdt", "Cdf", "Coeff", "Label8", "Label2", "Label4", "Label6", "Label7"]
      hL = hF.Controls[sNom]
      TestKit.Check("T05/" & sCle & "/" & sNom, hL.Text)
    Next
  Next
  Object.Lock(hF)

End
