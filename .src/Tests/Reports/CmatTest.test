' Gambas test file

''Tests de Cmat (.hidden/reference/.src/Reports/Cmat.class/test.md, CMAT-T01, T02).
''Chaque test produit un PDF dans un fichier temporaire et compare le texte rendu par « pdftotext -layout »
''(une clé par ligne non vide). La date du jour et User.Name sont remplacés par <date> et <utilisateur>.
''Valeurs attendues : assets/CmatTest/expected.txt, produites dans le clone de référence. Pas de base.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Liste", "Entete, Level1, 3 Level2, Ligne, Ligne2, Footer sur 2 pages")
  TestKit.Desc("T02EdmatListe", "Séquence d'EdMat : 60 matériels (prix à 2 et 3 décimales), saut à PosY >= 283 (2 pages), entête de suite")

End

Public Sub _Setup()

  TestKit.Begin("Reports", "CmatTest")

End

Private Function Nouveau() As Cmat

  Dim pdf As Cmat

  pdf = New Cmat("P", "mm", "A4")
  pdf.Open()
  pdf.AliasNbPages()
  Return pdf

End

' Écrit le PDF, en extrait le texte et vérifie chaque ligne non vide (date du jour et utilisateur masqués).
Private Sub Verifie(sCle As String, pdf As PdfWriter)

  Dim sFic As String = Temp$("rep") & ".pdf"
  Dim sTxt As String
  Dim sLig As String
  Dim n As Integer

  Try pdf.Output(sFic, False)
  If Error Then
    TestKit.Check(sCle & "/output", "ERREUR: " & Error.Text)
    Return
  Endif
  Shell "pdftotext -layout " & Shell$(sFic) & " -" To sTxt
  sTxt = Replace(sTxt, Format$(Date(Now), "dd/mm/yyyy"), "<date>")
  sTxt = Replace(sTxt, User.Name, "<utilisateur>")
  sTxt = Replace(sTxt, "\f", "<saut de page>\n")
  For Each sLig In Split(sTxt, "\n")
    sLig = RTrim(sLig)
    If sLig = "" Then Continue
    Inc n
    TestKit.Check(sCle & "/l" & Format$(n, "00"), sLig)
  Next
  TestKit.Check(sCle & "/lignes", n)

End

Public Sub T01Liste()

  Dim pdf As Cmat = Nouveau()
  Dim i As Integer

  pdf.Entete("Liste des matériels")
  pdf.Level1()
  For i = 1 To 3
    pdf.Level2("M00" & i, "MATERIEL " & i, "MARQUE" & i, "TYPE" & i, "SERIE" & i, "CLIENT " & i, "1234,50", "1481,40", 30 + i * 6)
  Next
  pdf.Ligne(60)
  pdf.Ligne2(65)
  pdf.Footer()
  pdf.Entete("Liste des matériels")
  pdf.Footer()
  Verifie("T01", pdf)

End

' CMAT-T02 : appels de Cmat dans l'ordre d'EdMat.Button1_Click (liste de tous les matériels) : 60 matériels,
' prix complétés d'une espace à 2 décimales comme EdMat, saut à PosY >= 283 avec l'en-tête de suite d'EdMat.
Public Sub T02EdmatListe()

  Dim pdf As Cmat = Nouveau()
  Dim PosY As Integer
  Dim i As Integer
  Dim pvht, pvttc As String

  pdf.Entete("Liste de tous les matériels au 15.06.2018")
  pdf.Level1()
  PosY = 26
  For i = 1 To 60
    If i Mod 2 = 0 Then
      pvht = Format$(i * 10.5, "0.00") & " "
      pvttc = Format$(i * 12.6, "0.00") & " "
    Else
      pvht = Format$(i * 10.125, "0.000")
      pvttc = Format$(i * 12.15, "0.000")
    Endif
    pdf.Level2("MAT" & Format$(i, "000"), Left$("MATERIEL DE TEST AU LIBELLE LONG NUMERO " & i, 36), "MARQUE" & (i Mod 4), "TYPE" & (i Mod 3), "SERIE" & i, "CLI" & (i Mod 5), pvht, pvttc, PosY)
    PosY += 5
    If PosY >= 283 Then
      pdf.Footer()
      pdf.Entete("Liste des marériels au 15.06.2018")
      pdf.Level1()
      PosY = 26
    Endif
  Next
  pdf.Footer()
  Verifie("T02", pdf)

End
