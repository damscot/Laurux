SELECT dte,compte,libelle,numdoc,numero,montantd,montantc,jour,tresorerie FROM Fiches_Mvt LEFT JOIN Fiches_Comptes ON compte = compte_cc WHERE (montantd like '12%' or montantc like '12%')  and validee = 1 and type_cc = 'C'
