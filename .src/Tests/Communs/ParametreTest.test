' Gambas test file

''Tests de Parametre (.hidden/reference/.src/Communs/Parametre.class/test.md, PARAMETRE-T07 partiel, T12).
''Valeurs attendues : assets/ParametreTest/expected.txt, produites dans le clone de référence.
''La fenêtre est instanciée sans être affichée (Form_Open n'est pas exécuté : aucun verrou DocActif).
''Veriftva est privée : non testée ici. Une période invalide (« 13.2024 ») affiche un message
''(bloquant sous gb.test) ; une période vide prend le mois courant (Now) : couvertes par le scénario
''parametre_periodes (PARAMETRE-T06), à date figée.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T07PrefixesTiers", "Dnclient/Dnfournisseur en lecture seule à l'ouverture ; gestionnaires LostFocus (non branchés, A07) appelés directement avec 512000/601000 puis 411000/401000 : bordure")
  TestKit.Desc("T12Verifications", "`Verif_Compte` et `mcdt` : comptes existants/inexistants, périodes")

End

Public Sub _Setup()

  TestKit.Begin("Communs", "ParametreTest")
  TestKit.OuvreBase()

End

Private Function Periode(hF As Parametre, sSaisie As String) As String
  ''Période après mcdt (texte du champ Mc).

  Dim hMc As Object

  hMc = hF.Controls["Mc"]
  hMc.Text = sSaisie
  Try hF.mcdt(hMc)
  If Error Then Return "ERREUR: " & Error.Text
  Return hMc.Text

End

Public Sub T07PrefixesTiers()

  Dim hF As Parametre
  Dim hCli As Object
  Dim hFou As Object

  Try hF = New Parametre
  If Error Then
    TestKit.Check("T07/creation", "ERREUR: " & Error.Text)
    Return
  Endif
  hCli = hF.Controls["Dnclient"]
  hFou = hF.Controls["Dnfournisseur"]
  TestKit.Check("T07/ouverture", hCli.Text & "|" & hCli.ReadOnly & "|" & hFou.Text & "|" & hFou.ReadOnly)
  ' Ctrl+M et double-clic (Par_keypress, Par_DblClick) lisent Last.Tag et Key : non appelables ici.
  ' Gestionnaires LostFocus jamais déclenchés dans l'application (A07) : appelés directement.
  hCli.Text = "512000"
  hFou.Text = "601000"
  Try hF.Dnclient_LostFocus()
  TestKit.Check("T07/client_512000", IIf(Error, "ERREUR: " & Error.Text, "ok"))
  Try hF.Dnfournisseur_LostFocus()
  TestKit.Check("T07/fournisseur_601000", IIf(Error, "ERREUR: " & Error.Text, "bordure " & hFou.Border))
  hCli.Text = "411000"
  hFou.Text = "401000"
  Try hF.Dnclient_LostFocus()
  TestKit.Check("T07/client_411000", IIf(Error, "ERREUR: " & Error.Text, "ok"))
  Try hF.Dnfournisseur_LostFocus()
  TestKit.Check("T07/fournisseur_401000", IIf(Error, "ERREUR: " & Error.Text, "bordure " & hFou.Border))
  Object.Lock(hF) ' sinon Form_Close (Button2_Click → Message.Error) est levé à la destruction et bloque

End

Public Sub T12Verifications()

  Dim hF As Parametre

  Try hF = New Parametre
  If Error Then
    TestKit.Check("T12/creation", "ERREUR: " & Error.Text)
    Return
  Endif
  TestKit.Check("T12/compte/411000", hF.Verif_Compte("411000"))
  TestKit.Check("T12/compte/606100", hF.Verif_Compte("606100"))
  TestKit.Check("T12/compte/999999", hF.Verif_Compte("999999"))
  TestKit.Check("T12/compte/vide", hF.Verif_Compte(""))
  TestKit.Check("T12/mcdt/02.2024", Periode(hF, "02.2024"))
  TestKit.Check("T12/mcdt/12.2019", Periode(hF, "12.2019"))
  Object.Lock(hF) ' sinon Form_Close (Button2_Click → Message.Error) est levé à la destruction et bloque

End

