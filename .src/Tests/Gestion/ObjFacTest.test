Public Sub T05bArticleInexistant()
  ''OBJFAC-A08/A09 : ligne article dont le code n'existe plus dans Fiches_Art (comme ART1 du jeu facturefm_shared/bl_juin).

  Utils.db.Exec("UPDATE Fiches_Ligbl SET code_ligbl = 'ART1' WHERE num_ligbl = 'B10003'")
  Calcule("T05b/article_inexistant", "B10003", ObjFac.bl)
  ' Taux de TVA de ligne (mtx_ligfac) NULL, comme dans le jeu facturefm_shared/bl_juin (A09)
  Utils.db.Exec("UPDATE Fiches_Ligbl SET mtx_ligfac = NULL WHERE num_ligbl = 'B10004'")
  Calcule("T05b/taux_null", "B10004", ObjFac.bl)

End

