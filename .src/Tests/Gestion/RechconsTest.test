' Gambas test file

''Tests de Rechcons (.hidden/reference/.src/Gestion/option/rechcons.class/test.md, RECHCONS-T01 à T03).
''Valeurs attendues : assets/RechconsTest/expected.txt, produites dans le clone de référence.
''Jeu : modfichier_shared/options_bois_pp (consigne 01 Bouteille type B) complété dans chaque test par trois
''consignes (02 Palette europe P, 03 Caisse 12 C, 04 Palette perdue P). Fenêtre instanciée sans être affichée.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Chargement", "New Rechcons(\"T\"/\"P\"/\"C\"/\"B\"/\"X\") : nombre de lignes et cellules")
  TestKit.Desc("T02Filtres", "Textcode = \"P\" puis Texlib = \"pal\" en modes T et C : nombre de lignes")
  TestKit.Desc("T03Selection", "GridView1.Row = 1 puis GridView1_Activate : événement trouver")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "RechconsTest")
  TestKit.OuvreBase("modfichier_shared/options_bois_pp")
  Utils.db.Exec("INSERT INTO Fiches_consigne VALUES ('02', 'Palette europe', 12.5, 'P'), ('03', 'Caisse 12', 3, 'C'), ('04', 'Palette perdue', 0, 'P')")

End

Public Sub T01Chargement()

  Dim hF As Rechcons
  Dim hG As GridView
  Dim sChoix As String
  Dim r, c As Integer

  For Each sChoix In ["T", "P", "C", "B", "X"]
    hF = New Rechcons(sChoix)
    hG = hF.Controls["GridView1"]
    TestKit.Check("T01/" & sChoix & "/lignes", hG.Rows.Count)
    For r = 0 To hG.Rows.Count - 1
      For c = 0 To 3
        TestKit.Check("T01/" & sChoix & "/" & r & "x" & c, hG[r, c].Text)
      Next
    Next
    Object.Lock(hF)
  Next

End

Public Sub T02Filtres()

  Dim hF As Rechcons
  Dim sChoix As String

  For Each sChoix In ["T", "C"]
    hF = New Rechcons(sChoix)
    Object.SetProperty(hF.Controls["Textcode"], "Text", "P")
    TestKit.Check("T02/" & sChoix & "/code_P", Object.GetProperty(hF.Controls["GridView1"], "Rows").Count)
    Object.SetProperty(hF.Controls["Textcode"], "Text", "")
    Object.SetProperty(hF.Controls["Texlib"], "Text", "pal")
    TestKit.Check("T02/" & sChoix & "/lib_pal", Object.GetProperty(hF.Controls["GridView1"], "Rows").Count)
    Object.Lock(hF)
  Next

End

Public Sub T03Selection()

  Dim hF As Rechcons
  Dim hObs As Object

  hF = New Rechcons("T")
  hObs = hF
  Object.Attach(hObs, Me, "_Rech")
  Object.SetProperty(hF.Controls["GridView1"], "Row", 1)
  Try hF.GridView1_Activate()
  If Error Then TestKit.Check("T03/activate", "ERREUR: " & Error.Text)
  TestKit.Check("T03/fin", "ok")
  ' La fenêtre est fermée par GridView1_Activate (Me.Close) : pas de Object.Lock

End

Public Sub _Rech_trouver(value As String)

  TestKit.Check("T03/trouver", value)

End
