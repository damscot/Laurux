Public Sub Modesel_Click()

  Filter_Calc()

End

Public Sub N1_Click()

  Selected.Clear()
  Update_Req()

End

Public Sub SelectAllFil_Click()

  Dim Res As Result
  Dim i As Integer
  
  Res = tr.GetAllFiltered()
  If Res.Available
    Repeat
      i = Selected.Find(Res!numero)
      If i = -1 Then
        Selected.Add(Res!numero)
      Endif
    Until Res.MoveNext()
  Endif
  Selcnt.Value = Selected.Count
  Calc_Solde()
  tr.Refresh_Data()
  
End

Public Sub DeSelectAllFil_Click()

  Dim Res As Result
  Dim i As Integer
  
  Res = tr.GetAllFiltered()
  If Res.Available
    Repeat
      i = Selected.Find(Res!numero)
      If i <> -1 Then
        Selected.Remove(i)
      Endif
    Until Res.MoveNext()
  Endif
  Selcnt.Value = Selected.Count
  Calc_Solde()
  tr.Refresh_Data()
  
End

Public Sub ClearChamps()
  
  Selected.Clear()
  Update_Req()
  Calc_Solde()
  
End

Public Sub ClearChampsAll()
  
  Selected.Clear()
  Selcnt.Value = Selected.Count
  Nrel.Clear()
  IsLast = False
  RelUniq.Value = False
  Dte.Clear()
  Dterappro.Clear()
  Sldfinal.Clear()
  Sldepart.Clear()
  Update_Req()
  Calc_Solde()
  
End

Public Sub Calc_Solde()
  
  Dim Tab As String
  Dim Tab1 As String
  Dim totd As Float = 0
  Dim totc As Float = 0
  Dim slddep As Float
  Dim sldfin As Float
  Dim sldtheo As Float
  Dim rResult As Result
  
  slddep = LPrix(Sldepart.Text).G
  sldfin = LPrix(Sldfinal.Text).G

  Ecart.Text = LPrix(0).L
  If Selected.Count > 0 Then
    If N1.Value = True Then
      rResult = Utils.db.Exec("Select totdeb, totcred FROM ( Select compte, numero, sum(montantd) as totdeb, sum(montantc) as totcred FROM " & Cbase.Table("TabMvt") & " where compte=&1 and numero in (" & Selected.Join(",") & ") Union Select compte, numero, sum(montantd) as totdeb, sum(montantc) as totcred FROM " & Cbase.Table("TabMvt1") & " where compte=&1 and numero in (" & Selected.Join(",") & ") ) as Combined_Mvt where compte=&1 and numero in (" & Selected.Join(",") & ") group by numero", Cpt.Text)
    Else
      rResult = Utils.db.Exec("Select sum(montantd) as totdeb, sum(montantc) as totcred FROM " & Cbase.Table("TabMvt") & " where compte=&1 and numero in (" & Selected.Join(",") & ")", Cpt.Text)
    Endif
    If rResult.Available Then
      totd = LPrix(rResult!totdeb).G
      totc = LPrix(rResult!totcred).G
    Endif
  Endif
  
  Totdeb.Text = LPrix(totd).L
  Totcred.Text = LPrix(totc).L
  sldtheo = slddep + totd - totc
  Sldtheorique.Text = LPrix(sldtheo).L
  Ecart.Text = LPrix(sldfin - sldtheo).L
  
End

Public Sub Sld_LostFocus()

  Calc_Solde()
  Stop Event

End

Public Sub Sld_KeyPress()

  If Key.code = Key.Enter Or Key.code = Key.Return Then
    Sld_LostFocus()
  Endif

End

Public Sub Pointage_Click()

  Dim rResult As Result

  If IsNull(Cpt.Text) Then
    Utils.Bip()
    Message.Error("Veuillez saisir un numero de compte")
    Return
  Endif

  If IsNull(Nrel.Text) Then
    Utils.Bip()
    Message.Error("Veuillez saisir un numero de relevé")
    Return
  Endif
  
  If LPrix(Sldfinal.Text).G = 0 Then
    If Message.Warning("Le solde final du relevé est nul, êtes-vous sur d'avoir saisi le bon solde?", "Continuer", "Sortir") = 2 Then Return
  Endif

  Utils.db.Exec("UPdate " & Cbase.Table("TabRappro") & " SET cpt = &1, nreleve = &2, date_releve = &3, date_rappro = &4, solde = &5 where cpt = &1 and nreleve = &2", cpt.Text, Nrel.Text, LDate(dte.Text).D, LDate(dterappro.Text).D, LPrix(Sldfinal.Text).D)

  rResult = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabComptes") & " WHERE compte_cc = &1", cpt.Text)
  If rResult.Available And IsLast Then
    Utils.db.Exec("UPdate " & Cbase.Table("TabComptes") & " SET soldep = &1 where compte_cc = &2", LPrix(Sldfinal.Text).D, cpt.Text)
  Endif

  If Selected.Count Then
    Utils.db.Exec("UPdate " & Cbase.Table("TabMvt") & " SET pointee = &1, nrlv = &2 where compte = &3 and numero in (" & Selected.Join(",") & ")", 1, Nrel.Text, Cpt.Text)
  Endif

  ClearChamps()

End

Public Sub Depointage_Click()

  Dim rResult As Result

  If IsNull(Cpt.Text) Then
    Utils.Bip()
    Message.Error("Veuillez saisir un numero de compte")
    Return
  Endif

  If IsNull(Nrel.Text) Then
    Utils.Bip()
    Message.Error("Veuillez saisir un numero de relevé")
    Return
  Endif
  
  If LPrix(Sldfinal.Text).G = 0 Then
    If Message.Warning("Le solde final du relevé est nul, êtes-vous sur d'avoir saisi le bon solde?", "Continuer", "Sortir") = 2 Then Return
  Endif

  Utils.db.Exec("UPdate " & Cbase.Table("TabRappro") & " SET cpt = &1, nreleve = &2, date_releve = &3, date_rappro = &4, solde = &5 where cpt = &1 and nreleve = &2", cpt.Text, Nrel.Text, LDate(dte.Text).D, LDate(dterappro.Text).D, LPrix(Sldfinal.Text).D)  
  rResult = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabComptes") & " WHERE compte_cc = &1", cpt.Text)
  If rResult.Available And IsLast Then
    Utils.db.Exec("UPdate " & Cbase.Table("TabComptes") & " SET soldep = &1 where compte_cc = &2", LPrix(Sldfinal.Text).D, cpt.Text)
  Endif

  If Selected.Count Then
    Utils.db.Exec("UPdate " & Cbase.Table("TabMvt") & " SET pointee = &1, nrlv = &2 where compte=&3 and numero in (" & Selected.Join(",") & ")", 0, "", Cpt.Text)
  Endif

  ClearChamps()

End

Public Sub SuppressionRlv_Click()

  Dim rResult As Result

  If IsNull(Cpt.Text) Then
    Utils.Bip()
    Message.Error("Veuillez saisir un numero de compte")
    Return
  Endif

  If IsNull(Nrel.Text) Then
    Utils.Bip()
    Message.Error("Veuillez saisir un numero de relevé")
    Return
  Endif
  
  If Message.Question("Voulez vous supprimer le relevé " & Nrel.Text, "Oui", "Non") Then
    rResult = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabRappro") & " WHERE cpt = &1 and nreleve = &2", cpt.Text, Nrel.Text)
    If rResult.Available Then
       Utils.db.Exec("DELETE FROM " & Cbase.Table("TabRappro") & " WHERE cpt = &1 and nreleve = &2", cpt.Text, Nrel.Text)
       Utils.db.Exec("UPdate " & Cbase.Table("TabMvt") & " SET pointee = &1, nrlv = &2 where compte=&3 and nrlv = &4", 0, "", Cpt.Text, Nrel.Text)
       'on recalcul les soldes du compte
       Calcsolde.Calcul(Cpt.Text, True)
    Else
      Message.Error("Impossible de trouver le relevé " & Nrel.Text & "!")
    Endif
  
    ClearChampsAll()
  
  Endif
  
End

Public Sub Imprime_Click()

  Dim code As String
  Dim Intitulb As String
  Dim num As String
  Dim dtep As String
  Dim nom As String
  Dim numdoc As String
  Dim numlot As String
  Dim Totdeb2, Debit As String
  Dim Totcred2, Credit As String
  Dim Totnp As String
  Dim Totp As String
  Dim Totpnp As String
  Dim dateedition As String
  Dim typeligne As String
  Dim rResult As Result
  Dim rResult2 As Result
  Dim SteResult As Result
  Dim Ste As String
  Dim Nbpage As Integer
  Dim Filename As String
  Dim pdf As Ccompta
  Dim PosY As Integer
  Dim PosX As Integer
  Dim cpttreso As String
  Dim cptintitule As String
  Dim cptsolde As String

  If IsNull(Cpt.Text) Then
    Utils.Bip()
    Message.Error("Veuillez saisir un numero de compte")
    Return
  Endif

  SteResult = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabSoc") & " Where cd_sc = &1", Start.Societe)
  Ste = "Societe " & " " & SteResult!int_sc
  dateedition = dte.text
  Intitulb = Intitule.text
  num = Nrel.Text
  code = cpt.Text
  Totdeb2 = "0,00"
  Totcred2 = "0,00"
  Totpnp = "0,00"
  Totnp = "0,00"
  Totp = "0,00"
  Nbpage = 1
  Shell "cd " & User.Home & ""
  Filename = User.Home & "/tmp/Pointage.pdf"
  pdf = New Ccompta("Portrait", "mm", "A4")
  pdf.Open()
  pdf.AliasNbPages()
  If Enp.Value Then typeligne = "(Impression des lignes non pointées)"
  If Ep.Value Then typeligne = "(Impression des lignes pointées)"
  If Nrel.Text = "" Then
    rResult = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabMvt") & " WHERE compte = &1  and tresorerie = &2 and validee = &3 and pointee = &4 order by dte", cpt.text, 1, 1, 1)
    rResult2 = Utils.db.Exec("SELECT compte, intitule, (sum(montantd)-sum(montantc)) as soldepointee FROM  " & Cbase.Table("TabMvt") & " WHERE compte = &1 and ((cloturee = 1 and jour = 90 and libelle = &2) or (pointee = 1 and nrlv <= &3))", cpt.Text, "Report a nouveau", Nrel.Text)
    Try cpttreso = rResult2!compte
    Try cptintitule = rResult2!intitule & " (Pointees)"
    Try cptsolde = LPrix(rResult2!soldepointee).L
  Else
    rResult = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabMvt") & " WHERE compte = &1  and tresorerie = &2 and validee = &3 and nrlv = &4  order by dte", cpt.text, 1, 1, Nrel.Text)
    rResult2 = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabRappro") & " WHERE cpt = &1  and nreleve = &2", cpt.text, Nrel.Text)
    Try cpttreso = rResult!compte
    Try cptintitule = rResult!intitule & " (Relevé " & Nrel.Text & ")"
    Try cptsolde = LPrix(rResult2!solde).L
  Endif
  If Enp.Value Then 
    rResult = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabMvt") & " WHERE compte = &1  and tresorerie = &2 and validee = &3 and pointee is null and dte <= &5 or compte = &1  and tresorerie = &2 and validee = &3 and pointee = &4 order by dte", cpt.text, 1, 1, 0, LDate(dte.Text).D)
    rResult2 = Utils.db.Exec("SELECT compte_cc, intitule_cc, solde FROM  " & Cbase.Table("TabComptes") & " WHERE compte_cc = &1", cpt.Text)
    Try cpttreso = rResult2!compte_cc
    Try cptintitule = rResult2!intitule_cc & " (En Cours)"
    Try cptsolde = LPrix(rResult2!solde).L
  Endif
  If rResult.Available Then
    pdf.Entete("Impression des rapprochements bancaires")
    posx = 2
    posy = 22
    pdf.Level0R(code, Intitulb, num, dateedition, typeligne, ste)
    posy += 8
    pdf.Level1R(Posy)
    posy += 6
    Do
      nom = rResult!libelle
      numdoc = rResult!numdoc
      numlot = rResult!numlot
      dtep = Utils.Cdate_Aff(rResult!dte)
      Debit = Format$(rResult!montantd, "0.00")
      Credit = Format$(rResult!montantc, "0.00")
      If debit = Null Then debit = "0,00"
      If Credit = Null Then Credit = "0,00"
      If PosY >= 274 Then
        pdf.Baspage()
        pdf.Entete("Impression des rapprochements bancaires")
        posx = 2
        posy = 22
        pdf.Level0R(code, Intitulb, num, dateedition, typeligne, ste)
        posy += 8
        pdf.Level1R(Posy)
        posy += 6
      Endif
      pdf.level2R(nom, dtep, numdoc, numlot, Debit, Credit, posy)
      posy += 5
      Totdeb2 = Format$(Val(Totdeb2) + Val(Debit), "0.00")
      Totcred2 = Format$(Val(Totcred2) + Val(Credit), "0.00")
      If Val(Totdeb2) = Null Then Totdeb2 = "0,00"
      If Val(Totcred2) = Null Then Totcred2 = "0,00"
      Totpnp = Format$(Val(Totdeb2) - Val(Totcred2), "0.00")
    Loop Until rResult.MoveNext()
    posy += 6
    If PosY >= 274 Then
      pdf.Baspage()
      pdf.Entete("Impression des rapprochements bancaires")
      posx = 2
      posy = 22
      pdf.Level0R(code, Intitulb, num, dateedition, typeligne, ste)
      posy += 8
      pdf.Level1R(Posy)
      posy += 6
    Endif
    pdf.Level3R(Totdeb2, Totcred2, Totpnp, Posy)
    Posy += 5
    pdf.Level6(cpttreso, cptintitule, cptsolde, Posy)
    pdf.Baspage()
    pdf.Output(Filename, False)
    Visualiseur.Prog(Filename)
  Endif

End

'************************************
'* on affiche la documentation html *
'************************************
Public Sub Help_Click()

  Doc.Open("Pointage_new")

End

Public Sub QuitPoint_Click()

  Me.Close()

End
