Public Sub _Setup()

  TestKit.Begin("Utils", "UtilsTest")

End

Private Sub Hexa(s As String) As String
  ''Octets d'une chaîne en hexadécimal (chaînes non UTF-8 : CP850 de Utils.Replace).

  Dim i As Integer
  Dim sRes As String

  For i = 1 To Len(s)
    sRes &= Hex$(Asc(Mid$(s, i, 1)), 2)
  Next
  If sRes = "" Then Return "<vide>"
  Return sRes

End

Public Sub T01ConversionsNumeriques()

  Dim aEntrees As String[] = [Null, "", " 1.5", "1,5", "-3.155", "abc"]
  Dim aNbdec As String[] = ["0", "2", "3", "4"]
  Dim i As Integer
  Dim sDec As String

  For i = 0 To aEntrees.Max
    TestKit.Check("T01/cpoint/" & i, Utils.cpoint(aEntrees[i]))
    TestKit.Check("T01/PointBase/" & i, Utils.PointBase(aEntrees[i]))
    TestKit.Check("T01/CSlash/" & i, Utils.CSlash(aEntrees[i]))
    For Each sDec In aNbdec
      TestKit.Check("T01/CDec/" & sDec & "/" & i, Utils.CDec(sDec, aEntrees[i]))
    Next
  Next
  For Each sDec In ["0", "2", "3", "4", ""]
    TestKit.Check("T01/Find_nbdec/" & sDec, Utils.Find_nbdec(sDec))
  Next

End

Public Sub T02FloatParse()

  ' "abc" : Message.Error (bloquant) non exercé
  Dim aEntrees As String[] = ["1 234,56", "-3.15", "+ 2", "12", "", Null]
  Dim i As Integer
  Dim fRes As Float

  For i = 0 To aEntrees.Max
    Try fRes = Utils.FloatParse(aEntrees[i])
    If Error Then
      TestKit.Check("T02/" & i, "ERREUR: " & Error.Text)
    Else
      TestKit.Check("T02/" & i, fRes)
    Endif
  Next

End

Public Sub T03Arrondi()

  Dim aChaines As String[] = ["1.005", "2,675", "-1.005", "0.125", "-0.125", "10", "0", "1.23456", "-2.5", "0.0049", "", "abc"]
  Dim aFloats As Float[] = [1.005, 2.675, -1.005, 0.125, -0.125, 1.23456, -2.5, 0.0049, 1234.5675]
  Dim i, n As Integer
  Dim fRes As Float

  For i = 0 To aChaines.Max
    For n = 0 To 4
      Try fRes = Utils.arrondi(aChaines[i], n)
      If Error Then
        TestKit.Check("T03/S/" & i & "/" & n, "ERREUR: " & Error.Text)
      Else
        TestKit.Check("T03/S/" & i & "/" & n, fRes)
      Endif
    Next
  Next
  For i = 0 To aFloats.Max
    For n = 0 To 4
      Try fRes = Utils.arrondi(aFloats[i], n)
      If Error Then
        TestKit.Check("T03/F/" & i & "/" & n, "ERREUR: " & Error.Text)
      Else
        TestKit.Check("T03/F/" & i & "/" & n, fRes)
      Endif
    Next
  Next
  TestKit.Check("T03/Null/2", Utils.arrondi(Null, 2))

End

