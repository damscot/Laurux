' Gambas test file

''Tests de MajEqu (.hidden/reference/.src/Gestion/Stock/Tarifs/MajEqu.module/test.md, MAJEQU-T01 à T04).
''Valeurs attendues : assets/MajEquTest/expected.txt, produites dans le clone de référence.
''Jeu majequ_shared/majequ_base : articles A, B, C, D ; Fiches_Cequ vide. Le contenu de Fiches_Cequ est relevé
''trié (codep>codequ), avec art_cequ des articles A à D.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01MajSimple", "Maj(A, B) sur table vide : paires de Fiches_Cequ et art_cequ")
  TestKit.Desc("T02FermetureTransitive", "Maj(A,B), Maj(C,D) puis Maj(B,C) ; variante Maj(C,B) : groupe obtenu figé")
  TestKit.Desc("T03Idempotence", "Maj(A, B) deux fois : table identique au premier appel")
  TestKit.Desc("T04Recup", "Recup sur (A,B), (B,C) ; puis sur table vide : erreur levée (A01)")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "MajEquTest")
  TestKit.OuvreBase("majequ_shared/majequ_base")

End

Private Function Paires() As String

  Dim r As Result
  Dim aP As New String[]

  r = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabCequ") & " order by codep, codequ")
  If Not r.Available Then Return "<vide>"
  Repeat
    aP.Add(r!codep & ">" & r!codequ)
  Until r.MoveNext()
  Return aP.Join(" ")

End

Private Function Cequ() As String

  Dim r As Result
  Dim aP As New String[]

  r = Utils.db.Exec("SELECT art_code, art_cequ FROM " & Cbase.Table("TabArt") & " where art_code in ('A', 'B', 'C', 'D') order by art_code")
  If Not r.Available Then Return "<vide>"
  Repeat
    aP.Add(r!art_code & "=" & r!art_cequ)
  Until r.MoveNext()
  Return aP.Join(" ")

End

Private Sub Appel(Cle As String, sCode As String, sEqu As String)

  Try MajEqu.Maj(sCode, sEqu)
  TestKit.Check(Cle & "/erreur", IIf(Error, "ERREUR: " & Error.Text, "aucune"))

End

Private Sub Vide()

  Utils.db.Exec("DELETE FROM " & Cbase.Table("TabCequ"))
  Utils.db.Exec("UPdate " & Cbase.Table("TabArt") & " SET art_cequ = NULL where art_code in ('A', 'B', 'C', 'D')")

End

Public Sub T01MajSimple()

  Appel("T01/maj", "A", "B")
  TestKit.Check("T01/cequ", Paires())
  TestKit.Check("T01/art_cequ", Cequ())

End

Public Sub T02FermetureTransitive()

  Appel("T02/maj_AB", "A", "B")
  Appel("T02/maj_CD", "C", "D")
  Appel("T02/maj_BC", "B", "C")
  TestKit.Check("T02/cequ_BC", Paires())
  TestKit.Check("T02/art_cequ_BC", Cequ())
  Vide()
  Appel("T02/v_maj_AB", "A", "B")
  Appel("T02/v_maj_CD", "C", "D")
  Appel("T02/v_maj_CB", "C", "B")
  TestKit.Check("T02/cequ_CB", Paires())
  TestKit.Check("T02/art_cequ_CB", Cequ())

End

Public Sub T03Idempotence()

  Dim sPremier As String

  Appel("T03/maj1", "A", "B")
  sPremier = Paires()
  Appel("T03/maj2", "A", "B")
  TestKit.Check("T03/cequ", Paires())
  TestKit.Check("T03/identique", Paires() = sPremier)

End

Public Sub T04Recup()

  Utils.db.Exec("INSERT INTO " & Cbase.Table("TabCequ") & " (codep, codequ) VALUES (&1, &2)", "A", "B")
  Utils.db.Exec("INSERT INTO " & Cbase.Table("TabCequ") & " (codep, codequ) VALUES (&1, &2)", "B", "C")
  Try MajEqu.Recup()
  TestKit.Check("T04/erreur", IIf(Error, "ERREUR: " & Error.Text, "aucune"))
  TestKit.Check("T04/cequ", Paires())
  Vide()
  Try MajEqu.Recup()
  TestKit.Check("T04/vide_erreur", IIf(Error, "ERREUR: " & Error.Text, "aucune"))
  TestKit.Check("T04/vide_cequ", Paires())

End
