' Gambas test file

''Tests de Cstocks (.hidden/reference/.src/Reports/Cstocks.class/test.md, CSTOCKS-T01 à T05).
''Chaque test produit un PDF dans un fichier temporaire et compare le texte rendu par « pdftotext -layout »
''(une clé par ligne non vide). La date du jour et User.Name sont remplacés par <date> et <utilisateur>.
''Valeurs attendues : assets/CstocksTest/expected.txt, produites dans le clone de référence. Pas de base.

Private $hTimer As Timer
Private $sVu As String
Private $hVue As Window

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Valorisation", "Entete, Level1, Entetefam, Level2, level3fam, Level3, BasPage : 2 familles × 2 lignes")
  TestKit.Desc("T02Comptage", "Level1G, 3 Level2G avec casier, Lines")
  TestKit.Desc("T03Ecarts", "Level1NS/Level2NS/Level3NS puis Level1E/Level2E/Level3E (écarts positifs et négatifs)")
  TestKit.Desc("T04Depots", "Level1D/Level2D, Level3D/Level4D (/Soc01/Taxe = TVA), Level1M/Level2M")
  TestKit.Desc("T05Pagination", "3 × (Entete + BasPage) : Page 1/3 à 3/3")
  TestKit.Desc("T07EditionsInventaire", "Éditions réelles de fin d'exercice : Geninv (feuille), Edinv, Ednsaisis, Ecarts sur un inventaire partiel")
  TestKit.Desc("T07cEditionsDepots", "Éditions réelles des dépôts : ImpDepots (dépôt 02, chiffrée) et Edsdepots (entrées et sorties)")
  TestKit.Desc("T07bEditionsTournant", "Éditions réelles de l'inventaire tournant : GeninvT (feuille), EdinvT, EdnsaisisT, EcartsT")

End

Public Sub _Setup()

  TestKit.Begin("Reports", "CstocksTest")
  Start.LocalSettings["/Soc" & Start.Societe & "/Taxe"] = "TVA"
End

Private Function Nouveau() As Cstocks

  Dim pdf As Cstocks

  pdf = New Cstocks("P", "mm", "A4")
  pdf.Open()
  pdf.AliasNbPages()
  Return pdf

End

' Écrit le PDF, en extrait le texte et vérifie chaque ligne non vide (date du jour et utilisateur masqués).
Private Sub Verifie(sCle As String, pdf As PdfWriter)

  Dim sFic As String = Temp$("rep") & ".pdf"
  Dim sTxt As String
  Dim sLig As String
  Dim n As Integer

  Try pdf.Output(sFic, False)
  If Error Then
    TestKit.Check(sCle & "/output", "ERREUR: " & Error.Text)
    Return
  Endif
  Shell "pdftotext -layout " & Shell$(sFic) & " -" To sTxt
  sTxt = Replace(sTxt, Format$(Date(Now), "dd/mm/yyyy"), "<date>")
  sTxt = Replace(sTxt, User.Name, "<utilisateur>")
  sTxt = Replace(sTxt, "\f", "<saut de page>\n")
  For Each sLig In Split(sTxt, "\n")
    sLig = RTrim(sLig)
    If sLig = "" Then Continue
    Inc n
    TestKit.Check(sCle & "/l" & Format$(n, "00"), sLig)
  Next
  TestKit.Check(sCle & "/lignes", n)

End

Public Sub T01Valorisation()

  Dim pdf As Cstocks = Nouveau()

  pdf.Entete("Valorisation du stock")
  pdf.Level1()
  pdf.Entetefam("F1", "FAMILLE UN", 30)
  pdf.Level2("A1", "ARTICLE UN", "2", "10,00", "20,00", "18,00", 36)
  pdf.Level2("A2", "ARTICLE DEUX", "3", "5,00", "15,00", "14,00", 41)
  pdf.level3fam("F1", "FAMILLE UN", "35,00", "32,00", 46)
  pdf.Entetefam("F2", "FAMILLE DEUX", 52)
  pdf.Level2("B1", "ARTICLE TROIS", "1", "1000,00", "1000,00", "990,00", 58)
  pdf.Level2("B2", "ARTICLE QUATRE", "4", "49,89", "199,56", "190,00", 63)
  pdf.level3fam("F2", "FAMILLE DEUX", "1199,56", "1180,00", 68)
  pdf.Level3("1234,56", "1212,00", 75)
  pdf.BasPage()
  Verifie("T01", pdf)

End

Public Sub T02Comptage()

  Dim pdf As Cstocks = Nouveau()
  Dim i As Integer

  pdf.Entete("Feuille de comptage")
  pdf.Level1G()
  For i = 1 To 3
    pdf.Level2G(CStr(i), "A" & i, "ARTICLE " & i, "C" & i, CStr(i * 2), "", 30 + i * 6)
    pdf.Lines(CStr(34 + i * 6))
  Next
  pdf.BasPage()
  Verifie("T02", pdf)

End

Public Sub T03Ecarts()

  Dim pdf As Cstocks = Nouveau()

  pdf.Entete("Articles non saisis")
  pdf.Level1NS()
  pdf.Level2NS("A1", "ARTICLE UN", "5", "50,00", "45,00", 36)
  pdf.Level3NS("50,00", "45,00", 42)
  pdf.BasPage()
  pdf.Entete("Écarts d'inventaire")
  pdf.Level1E()
  pdf.Level2E("1", "A1", "ARTICLE UN", "5", "7", "2", "20,00", "18,00", 36)
  pdf.Level2E("2", "A2", "ARTICLE DEUX", "5", "3", "-2", "-10,00", "-9,00", 42)
  pdf.Level3E("10,00", "9,00", 48)
  pdf.BasPage()
  Verifie("T03", pdf)

End

Public Sub T04Depots()

  Dim pdf As Cstocks = Nouveau()

  pdf.Entete("Stocks des dépôts")
  pdf.Level1D()
  pdf.Level2D("A1", "ARTICLE UN", "5", 36)
  pdf.Level3D()
  pdf.Level4D("A1", "ARTICLE UN", "10,00", "20", "12,00", "5", 60)
  pdf.Level1M()
  pdf.Level2M("A1", "ARTICLE UN", "15/06/2018", "2", "DEPOT1", "Transfert", 90)
  pdf.BasPage()
  Verifie("T04", pdf)

End

Public Sub T05Pagination()

  Dim pdf As Cstocks = Nouveau()
  Dim i As Integer

  For i = 1 To 3
    pdf.Entete("Page " & i)
    pdf.BasPage()
  Next
  Verifie("T05", pdf)

End

Public Sub _Boite_Timer()
  ''Boîte Message.* imprévue pendant une édition : texte relevé, premier bouton cliqué.

  Dim hW As Window
  Dim hC As Object

  For Each hW In Windows
    If Object.Type(hW) = "FMessage" And If hW <> $hVue Then
      $hVue = hW
      For Each hC In hW.Controls
        If Object.Type(hC) = "Label" Or Object.Type(hC) = "TextLabel" Then $sVu &= Object.GetProperty(hC, "Text") & " / "
      Next
      For Each hC In hW.Controls
        If Object.Type(hC) = "Button" Then
          hC.Value = True
          Return
        Endif
      Next
    Endif
  Next

End

' Édition réelle d'un écran appelant (visualiseur neutralisé) : méthode d'impression appelée, texte du PDF produit
' (~/tmp/<fichier>) vérifié ligne à ligne comme les autres tests ; boîtes Message.* relevées.
Private Sub Edition(sCle As String, hF As Object, sMethode As String, sFichier As String)

  Dim sFic As String = User.Home &/ "tmp" &/ sFichier
  Dim sTxt As String
  Dim sLig As String
  Dim n As Integer

  Start.LocalSettings["/Soc01/caisse/CmdVis"] = "true"
  Try Mkdir User.Home &/ "tmp"
  Try Kill sFic
  $sVu = ""
  $hVue = Null
  $hTimer = New Timer As "_Boite"
  $hTimer.Delay = 300
  $hTimer.Enabled = True
  Try Object.Call(hF, sMethode)
  If Error Then TestKit.Check(sCle & "/erreur", "ERREUR: " & Error.Text)
  Wait 0.5
  $hTimer.Enabled = False
  TestKit.Check(sCle & "/messages", $sVu)
  Object.Lock(hF)
  If Not Exist(sFic) Then
    TestKit.Check(sCle & "/pdf", "<absent>")
    Return
  Endif
  Shell "pdftotext -layout " & Shell$(sFic) & " -" To sTxt
  sTxt = Replace(sTxt, Format$(Date(Now), "dd/mm/yyyy"), "<date>")
  sTxt = Replace(sTxt, Format$(Date(Now), "dd.mm.yyyy"), "<date>")
  sTxt = Replace(sTxt, User.Name, "<utilisateur>")
  sTxt = Replace(sTxt, "\f", "<saut de page>\n")
  For Each sLig In Split(sTxt, "\n")
    sLig = RTrim(sLig)
    If sLig = "" Then Continue
    Inc n
    TestKit.Check(sCle & "/l" & Format$(n, "00"), sLig)
  Next
  TestKit.Check(sCle & "/lignes", n)

End

Public Sub T07EditionsInventaire()
  ''CSTOCKS-T07 (fin d'exercice) : jeu Gestion/validinv_shared/inv_fin_partiel (5 lignes, 3 comptées) ; feuille de
  ''comptage de Geninv (Button3_Click, Level1G/Level2G), inventaire valorisé par famille d'Edinv("F") (Level1, Entetefam,
  ''Level2, Level3fam, Level3), non saisis d'Ednsaisis et écarts d'Ecarts (Button1_Click).

  Dim hG As Geninv
  Dim hE As Edinv
  Dim hN As Ednsaisis
  Dim hC As Ecarts

  TestKit.OuvreBase("Gestion/validinv_shared/inv_fin_partiel")
  hG = New Geninv
  Object.SetProperty(hG.Controls["Dte"], "Text", "15/06/2018")
  Edition("T07/geninv", hG, "Button3_Click", "Inventaire.pdf")
  hE = New Edinv("F")
  Edition("T07/edinv", hE, "Button1_Click", "Inventaire.pdf")
  hN = New Ednsaisis
  Edition("T07/ednsaisis", hN, "Button1_Click", "Nsaisis.pdf")
  hC = New Ecarts
  Edition("T07/ecarts", hC, "Button1_Click", "Ecarts.pdf")

End

Public Sub T07bEditionsTournant()
  ''CSTOCKS-T07 (inventaire tournant) : jeu Gestion/validinvt_shared/invt_partiel ; feuille de GeninvT (Button3_Click),
  ''EdinvT, EdnsaisisT et EcartsT (Button1_Click).

  Dim hG As GeninvT
  Dim hE As EdinvT
  Dim hN As EdnsaisisT
  Dim hC As EcartsT

  TestKit.OuvreBase("Gestion/validinvt_shared/invt_partiel")
  ' Clé de couleur lue par GeninvT._New, absente de Laurux-test.conf
  Start.LocalSettings["/Coul/Znss"] = "background: 16777215;"
  hG = New GeninvT
  Edition("T07b/geninvt", hG, "Button3_Click", "Inventaire.pdf")
  hE = New EdinvT
  Edition("T07b/edinvt", hE, "Button1_Click", "InventaireT.pdf")
  hN = New EdnsaisisT
  Edition("T07b/ednsaisist", hN, "Button1_Click", "NsaisisT.pdf")
  hC = New EcartsT
  Edition("T07b/ecartst", hC, "Button1_Click", "EcartsT.pdf")

End

Public Sub T07cEditionsDepots()
  ''CSTOCKS-T07 (dépôts) : ImpDepots sur le jeu Gestion/impdepots_shared/impdepots_trois (dépôt 02 saisi, Cman, Button2_Click,
  ''Level1D/Level2D) puis Edsdepots sur Gestion/sdepots_shared/sdepots_stock (période 01.01.2014 au 15.06.2018, sans
  ''effacement, Button2_Click, Level1M/Level2M).

  Dim hI As ImpDepots
  Dim hS As Edsdepots
  Dim hC As Object

  TestKit.OuvreBase("Gestion/impdepots_shared/impdepots_trois")
  Start.LocalSettings["/Soc01/Depots"] = "-1"
  hI = New ImpDepots
  hC = hI.Controls["Code"]
  hC.Text = "02"
  hI.Cman()
  Edition("T07c/impdepots", hI, "Button2_Click", "Depots.pdf")
  TestKit.OuvreBase("Gestion/sdepots_shared/sdepots_stock")
  hS = New Edsdepots
  hC = hS.Controls["Date1"]
  hC.Text = "01.01.2014"
  hC = hS.Controls["Date2"]
  hC.Text = "15.06.2018"
  Edition("T07c/edsdepots", hS, "Button2_Click", "RegulDep.pdf")

End
