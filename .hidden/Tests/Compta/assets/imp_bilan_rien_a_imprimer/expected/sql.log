CREATE TABLE centralisation(numrub Char(5) NOT NULL,intitrub Char(70),type Char(1),detail Char(1),compte Char(8),intitcpt Char(50),Col1 Char(25),Col2 Char(25),col3 Char(25),col4 Char(25),PRIMARY KEY (numrub, compte)) ENGINE = InnoDB
