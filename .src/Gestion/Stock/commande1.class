Public Sub RecFo_Click()

  Dim MyForm As TriCpt

  Bsel = False
  MyForm = New TriCpt(TriCpt.Fournisseur, TriCpt.Sans_Solde, Me)
  MyForm.Showmodal()
  If Bsel = True Then
    fcode.Text = Bval
    FourMan(Bval)
    ncom.setfocus
