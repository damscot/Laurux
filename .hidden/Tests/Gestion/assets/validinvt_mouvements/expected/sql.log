LOCK TABLES Fiches_Art WRITE, Fiches_Bl WRITE, Fiches_Ligbl WRITE, Fiches_BlM Write, Fiches_LigblM WRITE, Fiches_HistoFac WRITE, Fiches_HistoLigfac WRITE, Fiches_HistoFacM WRITE, Fiches_HistoLigfacM WRITE, Fiches_Mvtexp WRITE, Fiches_Entrecpt WRITE, Fiches_Ligrecpt WRITE, Fiches_HisEntTickets  WRITE, Fiches_HisLigTickets  WRITE, Fiches_Sdepots WRITE, Fiches_HisInvT write, Fiches_Mvtexpdc WRITE 
SELECT * FROM  Fiches_HisInvT WHERE inv_code = '001' and inv_date >= '20171231' order by inv_date desc
SELECT DISTINCT SUM(CASE WHEN qte_ligbl IS NULL THEN '0' ELSE REPLACE(qte_ligbl,',','.') END ) * -1 as qte FROM Fiches_Ligbl JOIN Fiches_Bl ON num_ligbl = numbl WHERE dte_ligbl >= '20180601' And (type = 'B' OR type = 'F') AND code_ligbl='001' AND typel_ligbl = 'A' UNION ALL(SELECT SUM(CASE WHEN qte_ligbl IS NULL THEN '0' ELSE REPLACE(qte_ligbl,',','.') END ) * -1 as qte FROM Fiches_LigblM JOIN Fiches_BlM ON num_ligbl=numbl WHERE dte_ligbl >= '20180601' and (type = 'B' OR type = 'F') AND code_ligbl='001' AND typel_ligbl = 'A') UNION ALL(SELECT DISTINCT SUM(CASE WHEN qte_ligfac IS NULL THEN '0' ELSE REPLACE(qte_ligfac,',','.') END ) * -1 as qte FROM Fiches_HistoFac JOIN Fiches_HistoLigfac ON num_ligfac=numfac WHERE dtligbl_ligfac >= '20180601' AND code_ligfac='001' AND typel_ligfac = 'A') UNION ALL(SELECT SUM(CASE WHEN qte_ligfac IS NULL THEN '0' ELSE REPLACE(qte_ligfac,',','.') END ) * -1 as qte FROM Fiches_HistoFacM JOIN Fiches_HistoLigfacM ON num_ligfac=numfac WHERE dtligbl_ligfac >= '20180601' AND code_ligfac='001' AND typel_ligfac = 'A') UNION ALL(SELECT SUM(CASE WHEN qte IS NULL THEN '0' ELSE REPLACE(qte,',','.') END ) * '1.0000' as qte FROM Fiches_Ligrecpt WHERE daterecpt>= '20180601' AND code='001') UNION ALL(SELECT SUM(CASE WHEN qtep IS NULL THEN '0' ELSE REPLACE(qtep,',','.') END - CASE WHEN qtem IS NULL THEN '0' ELSE REPLACE(qtem,',','.') END ) as qte FROM Fiches_Mvtexp WHERE daterecpt>='20180601' AND code='001') UNION ALL(SELECT SUM(CASE WHEN qtep IS NULL THEN '0' ELSE REPLACE(qtep,',','.') END  - CASE WHEN qtem IS NULL THEN '0' ELSE REPLACE(qtem,',','.') END ) as qte FROM Fiches_Mvtexpdc WHERE daterecpt>='20180601' AND code='001') UNION ALL(SELECT SUM(CASE WHEN type='S' THEN CASE WHEN qte IS NULL THEN '0' ELSE REPLACE(qte,',','.') END * -1 ELSE CASE WHEN qte IS NULL THEN '0' ELSE REPLACE(qte,',','.') END END) AS qte FROM Fiches_Sdepots WHERE code='01' AND date >= '20180601' AND cart='001')
UPdate  Fiches_Art  SET  art_qte = 10 where art_code = '001'
SELECT * FROM  Fiches_HisInvT WHERE inv_code = '002' and inv_date >= '20180601' order by inv_date desc
SELECT DISTINCT SUM(CASE WHEN qte_ligbl IS NULL THEN '0' ELSE REPLACE(qte_ligbl,',','.') END ) * -1 as qte FROM Fiches_Ligbl JOIN Fiches_Bl ON num_ligbl = numbl WHERE dte_ligbl >= '20180601' And (type = 'B' OR type = 'F') AND code_ligbl='002' AND typel_ligbl = 'A' UNION ALL(SELECT SUM(CASE WHEN qte_ligbl IS NULL THEN '0' ELSE REPLACE(qte_ligbl,',','.') END ) * -1 as qte FROM Fiches_LigblM JOIN Fiches_BlM ON num_ligbl=numbl WHERE dte_ligbl >= '20180601' and (type = 'B' OR type = 'F') AND code_ligbl='002' AND typel_ligbl = 'A') UNION ALL(SELECT DISTINCT SUM(CASE WHEN qte_ligfac IS NULL THEN '0' ELSE REPLACE(qte_ligfac,',','.') END ) * -1 as qte FROM Fiches_HistoFac JOIN Fiches_HistoLigfac ON num_ligfac=numfac WHERE dtligbl_ligfac >= '20180601' AND code_ligfac='002' AND typel_ligfac = 'A') UNION ALL(SELECT SUM(CASE WHEN qte_ligfac IS NULL THEN '0' ELSE REPLACE(qte_ligfac,',','.') END ) * -1 as qte FROM Fiches_HistoFacM JOIN Fiches_HistoLigfacM ON num_ligfac=numfac WHERE dtligbl_ligfac >= '20180601' AND code_ligfac='002' AND typel_ligfac = 'A') UNION ALL(SELECT SUM(CASE WHEN qte IS NULL THEN '0' ELSE REPLACE(qte,',','.') END ) * '1.0000' as qte FROM Fiches_Ligrecpt WHERE daterecpt>= '20180601' AND code='002') UNION ALL(SELECT SUM(CASE WHEN qtep IS NULL THEN '0' ELSE REPLACE(qtep,',','.') END - CASE WHEN qtem IS NULL THEN '0' ELSE REPLACE(qtem,',','.') END ) as qte FROM Fiches_Mvtexp WHERE daterecpt>='20180601' AND code='002') UNION ALL(SELECT SUM(CASE WHEN qtep IS NULL THEN '0' ELSE REPLACE(qtep,',','.') END  - CASE WHEN qtem IS NULL THEN '0' ELSE REPLACE(qtem,',','.') END ) as qte FROM Fiches_Mvtexpdc WHERE daterecpt>='20180601' AND code='002') UNION ALL(SELECT SUM(CASE WHEN type='S' THEN CASE WHEN qte IS NULL THEN '0' ELSE REPLACE(qte,',','.') END * -1 ELSE CASE WHEN qte IS NULL THEN '0' ELSE REPLACE(qte,',','.') END END) AS qte FROM Fiches_Sdepots WHERE code='01' AND date >= '20180601' AND cart='002')
