' Gambas test file

''Tests de LibelAvoirs (.hidden/reference/.src/Caisse/LibelAvoirs.class/test.md, LIBELAVOIRS-T01 à T03).
''Écran instancié sans affichage (New LibelAvoirs), Form_Open appelé directement (lecture du libellé), texte posé dans
''TxtAvoirs puis Button2_Click (Enregistrer) ; contenu de Fiches_LibelAvoirs relu en base.
''Texte existant de T02 inséré par le test. Valeurs attendues : assets/LibelAvoirsTest/expected.txt (clone de référence).

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01CreationModification", "Table vide : 2 lignes, Enregistrer (INSERT) ; réouverture (texte relu), modification, Enregistrer (UPDATE)")
  TestKit.Desc("T02TexteVide", "Texte existant ; champ vidé, Enregistrer : texte non effacé (A01)")
  TestKit.Desc("T03Caracteres", "Texte avec guillemet et esperluette : stocké avec deux apostrophes et « et » (Utils.ReplaceLb)")

End

Public Sub _Setup()

  TestKit.Begin("Caisse", "LibelAvoirsTest")
  TestKit.OuvreBase()

End

Private Sub Table(sCle As String)

  Dim rResult As Result

  rResult = Utils.db.Exec("SELECT * FROM Fiches_LibelAvoirs ORDER BY lInd")
  If Not rResult.Available Then
    TestKit.Check(sCle & "/table", "<aucune ligne>")
    Return
  Endif
  TestKit.Check(sCle & "/nb", rResult.Count)
  Repeat
    TestKit.Check(sCle & "/ligne_" & rResult!lInd, rResult!libelav)
  Until rResult.MoveNext()

End

Private Function Ouvre() As Object

  Dim hForm As Object

  hForm = New LibelAvoirs
  hForm.Form_Open()
  Return hForm

End

Private Sub Enregistre(sCle As String, sTexte As String)

  Dim hForm As Object
  Dim hTxt As Object

  hForm = Ouvre()
  hTxt = hForm.Controls["TxtAvoirs"]
  hTxt.Text = sTexte
  Try hForm.Button2_Click()
  If Error Then TestKit.Check(sCle & "/erreur", Error.Text)
  TestKit.Check(sCle & "/champ", hTxt.Text)
  Object.Lock(hForm)
  Table(sCle)

End

Private Sub Relit(sCle As String)

  Dim hForm As Object
  Dim hTxt As Object

  hForm = Ouvre()
  hTxt = hForm.Controls["TxtAvoirs"]
  TestKit.Check(sCle & "/relu", hTxt.Text)
  Object.Lock(hForm)

End

Public Sub T01CreationModification()

  Relit("T01/vide")
  Enregistre("T01/creation", "Ligne un\nLigne deux")
  Relit("T01/reouverture")
  Enregistre("T01/modification", "Ligne un modifiee\nLigne deux")
  Relit("T01/fin")

End

Public Sub T02TexteVide()

  Utils.db.Exec("INSERT INTO Fiches_LibelAvoirs (libelav) VALUES (&1)", "Avoir valable 1 an")
  Relit("T02/avant")
  Enregistre("T02/vide", "")

End

Public Sub T03Caracteres()

  Enregistre("T03", "Texte \"cite\" & suite")

End
