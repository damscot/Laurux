' Gambas test file

''Tests de Chistoriques (.hidden/reference/.src/Reports/Chistoriques.class/test.md, CHISTORIQUES-T01 à T05).
''Chaque test produit un PDF dans un fichier temporaire et compare le texte rendu par « pdftotext -layout »
''(une clé par ligne non vide). La date du jour et User.Name sont remplacés par <date> et <utilisateur>.
''Valeurs attendues : assets/ChistoriquesTest/expected.txt, produites dans le clone de référence. Pas de base pour
''T01 à T05 ; T06/T07 lisent le jeu Statistiques/statcomm_shared/statistiques_ventes (factures N 2018 / N-1 2017).

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Cadre", "Entete, Level0F, Lines, Footer sur 2 pages")
  TestKit.Desc("T02HistoMo", "Level1, Level2, Level1bis, Level2bis : désignation de 40 caractères")
  TestKit.Desc("T03Stats", "Level1C/level2C/Level4C/Level5C, Level1AC/level2AC/Level5AC, Level1A/level2A/Level5A, Level1H/level2H")
  TestKit.Desc("T04PiecesMo", "Level1P, level2P (chaînes et Float 12.5), Level4P, Level5P")
  TestKit.Desc("T05CaFour", "Level1FO, level2FO (pourcent 12,50 / -3,20 / vide), Level4FO, Level5FO")
  TestKit.Desc("T06Editions", "Jeu statistiques_ventes : CA clients N/N-1 (level2FO) et CA par commercial (level2A) imprimés")
  TestKit.Desc("T07CaNul", "Jeu statistiques_ventes : client vendu en N-1 seulement, level2FO à CA nul et pourcentage vide")

End

Public Sub _Setup()

  TestKit.Begin("Reports", "ChistoriquesTest")

End

Private Function Nouveau() As Chistoriques

  Dim pdf As Chistoriques

  pdf = New Chistoriques("P", "mm", "A4")
  pdf.Open()
  pdf.AliasNbPages()
  Return pdf

End

' Écrit le PDF, en extrait le texte et vérifie chaque ligne non vide (date du jour et utilisateur masqués).
Private Sub Verifie(sCle As String, pdf As PdfWriter)

  Dim sFic As String = Temp$("rep") & ".pdf"
  Dim sTxt As String
  Dim sLig As String
  Dim n As Integer

  Try pdf.Output(sFic, False)
  If Error Then
    TestKit.Check(sCle & "/output", "ERREUR: " & Error.Text)
    Return
  Endif
  Shell "pdftotext -layout " & Shell$(sFic) & " -" To sTxt
  sTxt = Replace(sTxt, Format$(Date(Now), "dd/mm/yyyy"), "<date>")
  sTxt = Replace(sTxt, User.Name, "<utilisateur>")
  sTxt = Replace(sTxt, "\f", "<saut de page>\n")
  For Each sLig In Split(sTxt, "\n")
    sLig = RTrim(sLig)
    If sLig = "" Then Continue
    Inc n
    TestKit.Check(sCle & "/l" & Format$(n, "00"), sLig)
  Next
  TestKit.Check(sCle & "/lignes", n)

End

Public Sub T01Cadre()

  Dim pdf As Chistoriques = Nouveau()

  pdf.Entete("Historique des ventes")
  pdf.Level0F("01/01/2026", "31/12/2026")
  pdf.Lines("40")
  pdf.Footer()
  pdf.Entete("Historique des ventes")
  pdf.Footer()
  Verifie("T01", pdf)

End

Public Sub T02HistoMo()

  Dim pdf As Chistoriques = Nouveau()

  pdf.Entete("Historique MO")
  pdf.Level1()
  pdf.Level2("C001", "CLIENT UN", "P01", "DESIGNATION DE QUARANTE CARACTERES ABCDE", "2", "12,50", 40)
  pdf.Level1bis()
  pdf.Level2bis("C001", "CLIENT UN", "F0001", "P01", "DESIGNATION DE QUARANTE CARACTERES ABCDE", "2", "12,50", 60)
  pdf.Footer()
  Verifie("T02", pdf)

End

Public Sub T03Stats()

  Dim pdf As Chistoriques = Nouveau()

  pdf.Entete("Types de client")
  pdf.Level1C()
  pdf.level2C("T1", "TYPE UN", "100,00", "5,00", "95,00", "90,00", "5,5", 40)
  pdf.level2C("T2", "TYPE DEUX", "200,00", "0,00", "200,00", "180,00", "11,1", 45)
  pdf.Level4C(50)
  pdf.Level5C("1234,56", "5,00", "1229,56", "1000,00", "900,00", 55)
  pdf.Level1AC()
  pdf.level2AC("A1", "ARTICLE UN", "100,00", "5,00", "95,00", "10", "9,50", "COMM UN", 80)
  pdf.Level5AC("1234,56", 85)
  pdf.Level1A()
  pdf.level2A("A1", "ARTICLE UN", "100,00", "2", "CO1", "COMM UN", 110)
  pdf.Level5A("1234,56", 115)
  pdf.Level1H()
  pdf.level2H("A1", "ARTICLE UN", "100,00", 140)
  pdf.level2H("A2", "ARTICLE DEUX", "50,00", 145)
  pdf.Footer()
  Verifie("T03", pdf)

End

Public Sub T04PiecesMo()

  Dim pdf As Chistoriques = Nouveau()
  Dim f As Float = 12.5

  pdf.Entete("Pièces et MO")
  pdf.Level1P()
  pdf.level2P("C001", "CLIENT UN", "100,00", "5,00", "50,00", "0,00", "145,00", 40)
  pdf.level2P("C002", "CLIENT DEUX", f, f, f, f, f, 45)
  pdf.Level4P(50)
  pdf.Level5P("1234,56", "5,00", "50,00", "0,00", "1279,56", 55)
  pdf.Footer()
  Verifie("T04", pdf)

End

Public Sub T05CaFour()

  Dim pdf As Chistoriques = Nouveau()
  Dim sPc As String
  Dim n As Integer

  pdf.Entete("CA fournisseurs")
  pdf.Level1FO()
  For Each sPc In ["12,50", " -3,20 ", ""]
    Inc n
    Try pdf.level2FO("F" & n, "FOURNISSEUR " & n, IIf(n = 2, "0,00", "1234,5"), "1000", sPc, 35 + n * 5)
    TestKit.Check("T05/level2FO/" & n & "/erreur", IIf(Error, Error.Text, ""))
  Next
  pdf.Level4FO(60)
  pdf.Level5FO("1234,5", "1000", "23,45", 65)
  pdf.Footer()
  Verifie("T05", pdf)

End

' CA par client sur N (2018) et N-1 (2017) du jeu statistiques_ventes, préparé comme la liste de VisStatFour
' (montants formatés « 0.00 », pourcentage « 0.00 » ; clients de N-1 seul exclus : voir T07).
Private Function CaClients(bNulSeul As Boolean) As Result

  Dim sSql As String

  sSql = "SELECT cdclifac, MAX(nmclifac) AS nom, " &
    "SUM(CASE WHEN YEAR(datefac) = 2018 THEN totfac ELSE 0 END) AS ca, " &
    "SUM(CASE WHEN YEAR(datefac) = 2017 THEN totfac ELSE 0 END) AS ca1 " &
    "FROM " & Cbase.Table("TabHisFac") & " GROUP BY cdclifac "
  If bNulSeul Then
    sSql &= "HAVING ca = 0 "
  Else
    sSql &= "HAVING ca <> 0 "
  Endif
  Return Utils.db.Exec(sSql & "ORDER BY cdclifac")

End

Public Sub T06Editions()

  Dim pdf As Chistoriques = Nouveau()
  Dim rr As Result
  Dim fCa, fCa1, fTot, fTot1 As Float
  Dim iPosY As Integer = 32
  Dim n As Integer

  TestKit.OuvreBase("Statistiques/statcomm_shared/statistiques_ventes")
  ' Édition 1 : CA clients N / N-1 (gabarit fournisseurs de VisStatFour)
  pdf.Entete("Impression du CA fournisseurs")
  pdf.Level0F("01/01/2018", "15/06/2018")
  pdf.Level1FO()
  rr = CaClients(False)
  If Not rr.Available Then
    TestKit.Check("T06/donnees", "aucune")
    Return
  Endif
  Repeat
    Inc n
    fCa = rr!ca
    fCa1 = rr!ca1
    fTot += fCa
    fTot1 += fCa1
    Try pdf.level2FO(rr!cdclifac, rr!nom, Format$(fCa, "0.00"), Format$(fCa1, "0.00"), Format$(((fCa - fCa1) * 100) / fCa, " 0.00 "), iPosY)
    TestKit.Check("T06/level2FO/" & rr!cdclifac & "/erreur", IIf(Error, Error.Text, ""))
    iPosY += 5
  Until rr.MoveNext()
  TestKit.Check("T06/clients", n)
  pdf.Lines(iPosY)
  iPosY += 5
  pdf.Level4FO(iPosY)
  iPosY += 8
  pdf.Level5FO(Format$(fTot, "0.00"), Format$(fTot1, "0.00"), Format$(((fTot - fTot1) * 100) / fTot, "0.00"), iPosY)
  pdf.Footer()
  ' Édition 2 : CA par commercial (gabarit articles / commerciaux)
  pdf.Entete("CA par commercial")
  pdf.Level0F("01/01/2018", "15/06/2018")
  pdf.Level1A()
  iPosY = 32
  fTot = 0
  rr = Utils.db.Exec("SELECT c.code, c.nom, SUM(h.totfac) AS ca, COUNT(*) AS nb FROM " & Cbase.Table("TabHisFac") & " h, " & Cbase.Table("TabCommerciaux") & " c, " & Cbase.Table("TabCli") &
    " cl WHERE cl.cli_code = h.cdclifac AND cl.cli_comm = c.code AND YEAR(h.datefac) = &1 GROUP BY c.code, c.nom ORDER BY c.code", 2018)
  If rr.Available Then
    Repeat
      fCa = rr!ca
      fTot += fCa
      pdf.level2A(rr!code, rr!nom, Format$(fCa, "0.00"), CStr(rr!nb), rr!code, rr!nom, iPosY)
      iPosY += 5
    Until rr.MoveNext()
  Endif
  pdf.Level5A(Format$(fTot, "0.00"), iPosY + 5)
  pdf.Footer()
  Verifie("T06", pdf)

End

Public Sub T07CaNul()

  Dim pdf As Chistoriques = Nouveau()
  Dim rr As Result
  Dim sPc As String
  Dim fCa, fCa1 As Float
  Dim iPosY As Integer = 32

  TestKit.OuvreBase("Statistiques/statcomm_shared/statistiques_ventes")
  pdf.Entete("Impression du CA fournisseurs")
  pdf.Level0F("01/01/2018", "15/06/2018")
  pdf.Level1FO()
  rr = CaClients(True)
  If Not rr.Available Then
    TestKit.Check("T07/donnees", "aucune")
    Return
  Endif
  Repeat
    fCa = rr!ca
    fCa1 = rr!ca1
    ' Comme VisStatFour.Affichage : la division par un CA nul échoue sous Try, le pourcentage reste vide.
    sPc = ""
    Try sPc = Format$(((fCa - fCa1) * 100) / fCa, " 0.00 ")
    TestKit.Check("T07/" & rr!cdclifac & "/pourcent", sPc)
    Try pdf.level2FO(rr!cdclifac, rr!nom, Format$(fCa, "0.00"), Format$(fCa1, "0.00"), sPc, iPosY)
    TestKit.Check("T07/level2FO/" & rr!cdclifac & "/erreur", IIf(Error, Error.Text, ""))
    iPosY += 5
  Until rr.MoveNext()
  pdf.Footer()
  Verifie("T07", pdf)

End
