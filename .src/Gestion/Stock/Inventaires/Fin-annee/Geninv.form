# Gambas Form File 3.0

{ Form Form
  MoveScaled(37.5556,21,63,53)
  Background = Color.Background
  Text = ("Génération de l'inventaire")
  { Button2 Button
    MoveScaled(38,46,18,4.4444)
    Font = Font["Serif,Bold,-1"]
    Background = Color.ButtonBackground
    ToolTip = ("Quitter le programme")
    Drop = True
    Text = Shortcut(("Quitter"), "Q")
    Picture = Picture["Icones/exit.png"]
  }
  { TextLabel1 TextLabel
    MoveScaled(1,17,13,2)
    Font = Font["Serif,-1"]
    Text = ("Date ")
    Alignment = Align.Center
  }
  { Button1 Button
    MoveScaled(39,21,18,4.4444)
    Font = Font["Serif,Bold,-1"]
    Background = Color.ButtonBackground
    ToolTip = ("Génération de l'inventaire")
    Drop = True
    Text = Shortcut(("Traitement"), "T")
    Picture = Picture["Icones/charset.png"]
  }
  { Label1 Label
    MoveScaled(1,1,61,13)
    Font = Font["Serif,-1"]
    Text = ("Ce programme va générer l'inventaire de fin d'année à la date du\ntraitement.\nCliquez sur le bouton ' Traitement ' pour lancer le programme.")
    Alignment = Align.Center
  }
  { Button3 Button
    MoveScaled(16,46,18,4.4444)
    Font = Font["Serif,Bold,-1"]
    Background = Color.ButtonBackground
    ToolTip = ("Imprime le résultat sur l'imprimante")
    Drop = True
    Text = Shortcut(("Imprimer"), "I")
    Picture = Picture["Icones/frameprint.png"]
  }
  { Frame1 Frame
    MoveScaled(2,28,60,6)
    Text = ("Tri 1")
    { Fm RadioButton
      MoveScaled(2,2.5556,14,2)
      Text = Shortcut(("Familles"), "F")
    }
    { Fr RadioButton
      MoveScaled(17,2.5556,18,2)
      Text = Shortcut(("Fournisseurs"), "o")
    }
    { Cs RadioButton
      MoveScaled(36,2.5556,15,2)
      Text = Shortcut(("Casiers"), "C")
      Value = True
    }
  }
  { Button4 Button
    MoveScaled(3,46,4,4.4444)
    ToolTip = ("Doc HTML")
    Picture = Picture["Icones/khelp.png"]
  }
  { Stkt CheckBox
    MoveScaled(4,22,32,3)
    Font = Font["Serif,-1"]
    Text = Shortcut(("Impression du stock theorique"), "I")
    Value = CheckBox.True
  }
  { Frame2 Frame
    MoveScaled(2,37,60,6)
    Text = ("Tri 2")
    { Ca RadioButton
      MoveScaled(3,3,16,2)
      Text = Shortcut(("Code article"), "a")
      Value = True
    }
    { Ds RadioButton
      MoveScaled(20,2.8889,16,2)
      Text = Shortcut(("désignation"), "d")
    }
  }
  { Dte TextReg
    MoveScaled(18,16,25,3.5556)
  }
}
