' Gambas test file

''Tests de Zebra (.hidden/reference/.src/Gestion/Etiquettes/Zebra.module/test.md, ZEBRA-T01 à T03).
''Valeurs attendues : assets/ZebraTest/expected.txt, produites dans le clone de référence.
''Montage : un écouteur TCP local (assets/ZebraTest/ecoute.py, port libre) reçoit le flux écrit par Zebra.Gondole1
''sur un Socket gb.net connecté à 127.0.0.1 ; les octets reçus sont comparés. Aucun accès base.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01FluxNominal", "Gondole1 : flux ZPL reçu pour un jeu nominal (guillemets et & remplacés par Utils.Remplace)")
  TestKit.Desc("T02DonneesLimites", "Gondole1 : flux reçu avec chaînes vides, _ ^ ~, accents et intitulé de 60 caractères")
  TestKit.Desc("T03SocketFermee", "Gondole1 sur un Socket non connecté : erreur levée")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "ZebraTest")

End

Private Function Flux(Args As Variant[]) As String

  Dim sOut As String = Temp$()
  Dim sPort As String = Temp$()
  Dim hProc As Process
  Dim hSock As Socket
  Dim i As Integer

  hProc = Exec ["python3", Application.Path &/ ".hidden/Tests/Gestion/assets/ZebraTest/ecoute.py", sOut, sPort]
  For i = 1 To 200
    If Exist(sPort) Then Break
    Wait 0.05
  Next
  If Not Exist(sPort) Then Return "ERREUR: écouteur absent"
  hSock = New Socket
  hSock.Connect("127.0.0.1", CInt(Trim(File.Load(sPort))))
  For i = 1 To 200
    If hSock.Status = Net.Connected Then Break
    Wait 0.05
  Next
  Try Zebra.Gondole1(hSock, Args[0], Args[1], Args[2], Args[3], Args[4], Args[5], Args[6], Args[7])
  If Error Then Return "ERREUR: " & Error.Text
  hSock.Close
  For i = 1 To 200
    If Exist(sOut & ".ok") Then Break
    Wait 0.05
  Next
  If Not Exist(sOut & ".ok") Then Return "ERREUR: flux non reçu"
  Return File.Load(sOut)

End

Private Sub Ecrit(Cle As String, sFlux As String)

  Dim sLigne As String
  Dim n As Integer

  TestKit.Check(Cle & "/longueur", Len(sFlux))
  ' Une clé par champ ZPL (coupure après ^FS et ^XZ) pour un écart lisible
  For Each sLigne In Split(Replace(Replace(sFlux, "^FS", "^FS\n"), "^XZ", "^XZ\n"), "\n", "", True)
    Inc n
    TestKit.Check(Cle & "/" & Format(n, "00"), sLigne)
  Next

End

Public Sub T01FluxNominal()

  Ecrit("T01", Flux(["3270190207924", "12,50 ", "Râteau \"pro\" & co", "ART001", "TTC", "A12", "2,50 Kg/l", "REF-9"]))

End

Public Sub T02DonneesLimites()

  Ecrit("T02/vides", Flux(["", "", "", "", "", "", "", ""]))
  Ecrit("T02/speciaux", Flux(["12_34^56~7", "9,99 ", "Été à l'œuvre ^FS ~JA _x", "A^B", "T~C", "_1", "1,00 Kg/l", "R^~_"]))
  Ecrit("T02/long", Flux(["3270190207924", "1,00 ", String$(60, "X"), "ART002", "TTC", "B1", "", ""]))

End

Public Sub T03SocketFermee()

  Dim hSock As New Socket

  Try Zebra.Gondole1(hSock, "3270190207924", "12,50 ", "Intitule", "ART001", "TTC", "A12", "2,50 Kg/l", "REF-9")
  If Error Then
    TestKit.Check("T03/erreur", "ERREUR: " & Error.Text)
  Else
    TestKit.Check("T03/erreur", "aucune")
  Endif

End
