drop Table IF exists Rupture
drop Table IF exists RuptureC
CREATE TABLE Rupture(codea Char(15) NOT NULL,intitulea Char(50),four Char(8),qtecli FLOAT,qtefour FLOAT,qtecom FLOAT,codec Char(8),intitulec Char(50),numcom Char(50),PRIMARY KEY (codea, intitulea, four)) ENGINE = InnoDB
CREATE TABLE RuptureC(codea Char(15) NOT NULL,intitulea Char(50),four Char(8),qtecom FLOAT,qte FLOAT,codec Char(8),intitulec Char(50),numcom Char(50),PRIMARY KEY (codea, codec, numcom, intitulea, four)) ENGINE = InnoDB
SELECT * FROM Fiches_Ligcom left join Fiches_Art on art_code = code WHERE code >= '0000000000000' and code <= 'ZZZZZZZZZZZZZ' and four >= '40100001' and four <= '40199999' and art_stocke = 1
SELECT * FROM Fiches_Ligbl left join Fiches_Bl  on numbl = num_ligbl where type = 'C' and typel_ligbl = 'A' and code_ligbl >= '0000000000000' and code_ligbl <= 'ZZZZZZZZZZZZZ' and (four_ligbl is null or (four_ligbl >= '40100001' and four_ligbl <= '40199999')) order by cdclibl
SELECT * FROM Fiches_Art WHERE art_code >= '0000000000000' and art_code <= 'ZZZZZZZZZZZZZ' and art_four >= '40100001' and art_four <= '40199999' and art_stocke = 1 order by art_code
SELECT * FROM Rupture left join Fiches_Art on art_code = codea WHERE qtecli is not null and qtefour is not null
SELECT * FROM Rupture left join Fiches_Art on art_code = codea order by four, codea
