' Gambas test file

''Tests de Edart4 ouvrant TriCpt en ShowModal (.hidden/reference/.src/Gestion/Impressions/Edart4.class/test.md, EDART4-T01, T06 partiel).
''Module séparé d'Edart4Test (vague 7, fusion). Un Timer du module agit pendant la boucle modale : il retrouve la
''fenêtre TriCpt ouverte (Windows) et simule la sélection d'une ligne (Bsel = True puis ColTri_MajSel(code), ce
''que fait TriGen au double-clic) ou la fermeture sans choix. Edart4 est instanciée sans être affichée ; l'impression
''(Butimp, gb.report vers ~/tmp/tarif.pdf) est lancée avec un visualiseur factice (CmdVis = true).
''Valeurs attendues : assets/Edart4ModalTest/expected.txt, produites dans le clone de référence.

Private $hTimer As Timer
Private $sChoix As String

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T06Selection", "Famille 02 désélectionnée (TreeView1), fournisseur 401001 par TriCpt (ToggleButton5/6), articles 001..003 par TriArticles (ToggleButton1/2), article 003 suspendu, Imprimer : plages, familles et PDF")
  TestKit.Desc("T01ClientTriCpt", "Butclig : choix du client 411001 dans TriCpt (code, adresse, type), puis Imprimer : PDF produit et nombre de pages")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "Edart4ModalTest")
  TestKit.OuvreBase()
  Start.LocalSettings["/Soc" & Start.Societe & "/caisse/CmdVis"] = "true"

End

' Programme l'action de l'utilisateur dans TriCpt : code choisi, ou "" pour fermer sans choix.
Private Sub Programme(sChoix As String)

  $sChoix = sChoix
  $hTimer = New Timer As "_Choix"
  $hTimer.Delay = 500
  $hTimer.Enabled = True

End

Public Sub _Choix_Timer()

  Dim hWin As Window

  For Each hWin In Windows
    If Object.Type(hWin) <> "TriCpt" And If Object.Type(hWin) <> "TriArticles" Then Continue
    $hTimer.Enabled = False
    If $sChoix Then
      Object.SetProperty(hWin, "Bsel", True)
      Object.Call(hWin, "ColTri_MajSel", [$sChoix])
    Else
      hWin.Close()
    Endif
    Return
  Next

End

Public Sub T01ClientTriCpt()

  Dim hF As New Edart4
  Dim sNom, sTxt As String
  Dim sPdf As String = User.Home &/ "tmp/tarif.pdf"

  Programme("411001")
  Try hF.Butclig_Click()
  TestKit.Check("T01/choix/erreur", IIf(Error, Error.Text, "<aucune>"))
  TestKit.Check("T01/choix/Bsel", hF.Bsel)
  For Each sNom In ["Textcli", "TextArea1", "Textyp"]
    TestKit.Check("T01/choix/" & sNom, Object.GetProperty(hF.Controls[sNom], "Text"))
  Next
  TestKit.Check("T01/choix/Textyp_enabled", Object.GetProperty(hF.Controls["Textyp"], "Enabled"))
  Try Kill sPdf
  Try hF.Butimp_Click()
  TestKit.Check("T01/impression/erreur", IIf(Error, Error.Text & " " & Error.Where, "<aucune>"))
  TestKit.Check("T01/impression/pdf", Exist(sPdf))
  If Exist(sPdf) Then
    Shell "pdfinfo " & Shell$(sPdf) & " | grep -E '^Pages'" To sTxt
    TestKit.Check("T01/impression/pages", Trim(sTxt))
  Endif
  Object.Lock(hF)

End

Private Sub Choisit(hF As Object, sMethode As String, sChoix As String, sCle As String)

  Programme(sChoix)
  Try Object.Call(hF, sMethode)
  TestKit.Check(sCle & "/erreur", IIf(Error, Error.Text, "<aucune>"))

End

Public Sub T06Selection()

  Dim hF As New Edart4
  Dim hTree As Object = hF.Controls["TreeView1"]
  Dim sNom, sTxt As String
  Dim sPdf As String = User.Home &/ "tmp/tarif.pdf"

  Utils.db.Exec("UPDATE Fiches_Art SET art_suspendu = 1 WHERE art_code = &1", "003")
  If hTree.MoveFirst() = False Then
    Repeat
      sTxt &= hTree.Item.Key & ":" & hTree.Item.Selected & " "
    Until hTree.MoveBelow()
  Endif
  TestKit.Check("T06/familles_ouverture", Trim(sTxt))
  Try hTree["02"].Selected = False
  TestKit.Check("T06/deselection/erreur", IIf(Error, Error.Text, "<aucune>"))
  Choisit(hF, "ToggleButton5_Click", "401001", "T06/four")
  Choisit(hF, "ToggleButton6_Click", "401001", "T06/four2")
  Choisit(hF, "ToggleButton1_Click", "001", "T06/art")
  Choisit(hF, "ToggleButton2_Click", "003", "T06/art2")
  For Each sNom In ["Four", "Four2", "Art", "Art2"]
    TestKit.Check("T06/" & sNom, Object.GetProperty(hF.Controls[sNom], "Text"))
  Next
  sTxt = ""
  If hTree.MoveFirst() = False Then
    Repeat
      sTxt &= hTree.Item.Key & ":" & hTree.Item.Selected & " "
    Until hTree.MoveBelow()
  Endif
  TestKit.Check("T06/familles_selection", Trim(sTxt))
  Try Kill sPdf
  Try hF.Butimp_Click()
  TestKit.Check("T06/impression/erreur", IIf(Error, Error.Text & " " & Error.Where, "<aucune>"))
  TestKit.Check("T06/impression/pdf", Exist(sPdf))
  If Exist(sPdf) Then
    Shell "pdfinfo " & Shell$(sPdf) & " | grep -E '^Pages'" To sTxt
    TestKit.Check("T06/impression/pages", Trim(sTxt))
  Endif
  Object.Lock(hF)

End
