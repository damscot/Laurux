' Gambas test file

''Tests de Rechtipp (.hidden/reference/.src/Gestion/option/rechtipp.class/test.md, RECHTIPP-T01 à T03).
''Valeurs attendues : assets/RechtippTest/expected.txt, produites dans le clone de référence.
''Jeu : modfichier_shared/options_bois_pp (régions R1 : intitulé + articles 001, 002 ; R2 : intitulé).
''La fenêtre est instanciée sans être affichée ; les cellules sont remplies par l'appel direct de GridView1_Data.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01ModeN", "New Rechtipp(\"N\") : 2 colonnes, régions cart = '0'")
  TestKit.Desc("T02ModeT", "New Rechtipp(\"T\") : 4 colonnes, lignes article, désignation ; article absent de Fiches_Art")
  TestKit.Desc("T03Selection", "GridView1.Row = 0 puis GridView1_Activate : événement trouve")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "RechtippTest")
  TestKit.OuvreBase("modfichier_shared/options_bois_pp")

End

Private Sub Grille(sT As String, hF As Rechtipp)

  Dim hG As GridView
  Dim r, c As Integer

  hG = hF.Controls["GridView1"]
  TestKit.Check(sT & "/colonnes", hG.Columns.Count)
  TestKit.Check(sT & "/lignes", hG.Rows.Count)
  For c = 0 To hG.Columns.Count - 1
    TestKit.Check(sT & "/entete" & c, hG.Columns[c].Text)
  Next
  For r = 0 To hG.Rows.Count - 1
    For c = 0 To hG.Columns.Count - 1
      Try hF.GridView1_Data(r, c)
      If Error Then
        TestKit.Check(sT & "/" & r & "x" & c, "ERREUR: " & Error.Text)
      Else
        TestKit.Check(sT & "/" & r & "x" & c, hG[r, c].Text)
      Endif
    Next
  Next

End

Public Sub T01ModeN()

  Dim hF As Rechtipp

  hF = New Rechtipp("N")
  Grille("T01", hF)
  Object.Lock(hF)

End

Public Sub T02ModeT()

  Dim hF As Rechtipp

  Utils.db.Exec("INSERT INTO Fiches_region VALUES ('R2', 'ZZZ', 'Region deux', 4)")
  hF = New Rechtipp("T")
  Grille("T02", hF)
  Object.Lock(hF)

End

Public Sub T03Selection()

  Dim hF As Rechtipp
  Dim hObs As Object

  hF = New Rechtipp("N")
  hObs = hF
  Object.Attach(hObs, Me, "_Rech")
  Object.SetProperty(hF.Controls["GridView1"], "Row", 1)
  Try hF.GridView1_Data(1, 0)
  Try hF.GridView1_Activate()
  If Error Then TestKit.Check("T03/activate", "ERREUR: " & Error.Text)
  TestKit.Check("T03/fin", "ok")
  ' La fenêtre est fermée par GridView1_Activate (Me.Close) : pas de Object.Lock

End

Public Sub _Rech_trouve(cle As String)

  TestKit.Check("T03/trouve", cle)

End
