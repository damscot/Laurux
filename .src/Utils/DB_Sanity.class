Public Sub Nettoyer_Click()

  Dim pb As ProgBar
  Dim i As Integer
  Dim Res As Result

  If IsNull(Datain) Then
    Message.Error("Vous devez d'abord lancer un contrôle, pour faire cette opération!")
    Return
  Endif
  If Message.Warning("Toutes les tables et champs inutilisés par Laurux vont être supprimés!\nUne sauvegarde préalable est conseillé!", "Annuler", "Nettoyer") = 1 Then Return
  
  pb = New ProgBar("Nettoyage de la base", Valid.Count, Null, True, "", True)
  pb.Show
  For i = 0 To Valid.Max
    If pb.Avancement("Table : " & Data[i][tabl] & " Champ : " & Data[i][name]) Then Break
    If Valid[i][Valide] <> 3 Then Continue
    Res = Utils.db.Exec("SHOW COLUMNS FROM " & Data[i][tabl])
    'dernier champ de la table : on supprime la table
    If Res.Count = 1 Then
      Utils.db.Exec("DROP TABLE " & Data[i][tabl])
    Else
      DropKey(Data[i][tabl], Data[i][name])
      Utils.db.Exec("ALTER TABLE " & Data[i][tabl] & " DROP COLUMN " & Data[i][name])
    Endif
  Next
  pb.Close()
  Refresh_Data()

  Catch
    Message.Error("Erreur " & Error.Text & " sur la table : " & Data_Expected[i][tabl] & " Champ : " & Data_Expected[i][name])

End

Public Sub Corriger_Click()

  Dim i, j As Integer
  Dim res As Result
  Dim req As String
  Dim defstr As String
  Dim pb As ProgBar
  Dim egn As Boolean
  Dim tables As New String[]
  Dim NomTable As String
  Dim ctx As String
  Dim stopped As Boolean

  If IsNull(Datain) Then
    Message.Error("Vous devez d'abord lancer un contrôle ou une recherche de champ absent, pour faire cette opération!")
    Return
  Endif
  If Message.Warning("Une tentative de correction de la base de donnée va être tenté!\nUne sauvegarde préalable est indispensable!", "Annuler", "Corriger") = 1 Then Return

  pb = New ProgBar("Correction de la base", Valid.Count, Null, True, "", True)
  pb.Show
  For i = 0 To Valid.Max
    ctx = "table : " & Data_Expected[i][tabl] & " Champ : " & Data_Expected[i][name]
    If pb.Avancement("Table : " & Data_Expected[i][tabl] & " Champ : " & Data_Expected[i][name]) Then
      stopped = True
      Break
    Endif
    For j = 0 To EntMysql.Max
      If Valid[i][j] = 1 Or Valid[i][j] = -1 Then Continue
      Select Case Valid[i][j] 
        Case 0      'on modifi les champs
          'les clefs sont resynchronisées par table après les champs (un MODIFY perd aussi l'AUTO_INCREMENT)
          If Not tables.Exist(Data_Expected[i][tabl]) Then tables.Add(Data_Expected[i][tabl])
          Select Case j
            Case format   'On teste ENGINE
              res = Utils.db.Exec("SELECT ENGINE FROM information_schema.TABLES WHERE TABLE_SCHEMA = &1 AND TABLE_NAME= &2", "Laurux" & Start.Societe, Data_Expected[i][tabl])
              If res!ENGINE <> Data_Expected[i][J] Then
                Utils.db.Exec("ALTER TABLE Laurux" & Start.Societe & "." & Data_Expected[i][tabl] & "ENGINE=" & Data_Expected[i][J])
              Endif

            Case type
              Utils.db.Exec("ALTER TABLE " & Data_Expected[i][tabl] & " MODIFY " & Data_Expected[i][name] & " " & Data_Expected[i][type])

            Case def
              defstr = ""
              If (Data_Expected[i][def] <> Null) Then
                defstr = " DEFAULT " & Data_Expected[i][def]
              Endif

              If Data_Expected[i][ValNul] = "YES" Then
                Utils.db.Exec("ALTER TABLE " & Data_Expected[i][tabl] & " CHANGE " & Data_Expected[i][name] & " " & Data_Expected[i][name] & " " & Data_Expected[i][type] & " NULL" & defstr)
              Else
                Utils.db.Exec("ALTER TABLE " & Data_Expected[i][tabl] & " CHANGE " & Data_Expected[i][name] & " " & Data_Expected[i][name] & " " & Data_Expected[i][type] & " NOT NULL" & defstr)
              Endif
              'force fixing default null/not null validity when fixing also default value
              Valid[i][ValNul] = 1 

            Case ValNul 
              If Data_Expected[i][ValNul] = "YES" Then
                Utils.db.Exec("ALTER TABLE " & Data_Expected[i][tabl] & " MODIFY " & Data_Expected[i][name] & " " & Data_Expected[i][type] & " NULL")
              Else
                Utils.db.Exec("ALTER TABLE " & Data_Expected[i][tabl] & " MODIFY " & Data_Expected[i][name] & " " & Data_Expected[i][type] & " NOT NULL")
              Endif

            Case collation
              'on teste collation par default sur la table 
              res = Utils.db.Exec("SELECT TABLE_COLLATION FROM information_schema.TABLES WHERE TABLE_SCHEMA = &1 AND TABLE_NAME= &2", "Laurux" & Start.Societe, Data_Expected[i][tabl])
              If res!TABLE_COLLATION <> Data_Expected[i][collation] Then
                Utils.db.Exec("ALTER TABLE Laurux" & Start.Societe & "." & Data_Expected[i][tabl] & " CHARACTER SET utf8mb4 COLLATE " & Data_Expected[i][collation])
              Endif
              'on modifie collation sur le champ
              Utils.db.Exec("ALTER TABLE Laurux" & Start.Societe & "." & Data_Expected[i][tabl] & " MODIFY " & Data_Expected[i][name] & " " & Data_Expected[i][type] & " CHARACTER SET utf8mb4 COLLATE " & Data_Expected[i][collation])
          End Select

        Case 2        'on rajoute les champs
          egn = False
          res = Utils.db.Exec("SELECT ENGINE FROM information_schema.TABLES WHERE TABLE_SCHEMA = &1 AND TABLE_NAME= &2", "Laurux" & Start.Societe, Data_Expected[i][tabl])
          If Not res.Available Then 
            'on créer la table si besoin
             req = "CREATE TABLE " & Data_Expected[i][tabl] & " (" & Data_Expected[i][name] & " " & Data_Expected[i][type]
             egn = True
         Else
            'ou on rajoute un champ
            req = "ALTER TABLE " & Data_Expected[i][tabl] & " ADD " & Data_Expected[i][name] & " " & Data_Expected[i][type]
         Endif
         If Not IsNull(Data_Expected[i][collation]) Then req &= " COLLATE " & Data_Expected[i][collation]
         If Not IsNull(Data_Expected[i][def]) Then req &= " DEFAULT " & Data_Expected[i][def]
         If Data_Expected[i][ValNul] = "NO" Then req &= " NOT NULL"
         If egn Then req &= ") ENGINE = " & Data_Expected[i][format]
         Utils.db.Exec(req)
         If Not tables.Exist(Data_Expected[i][tabl]) Then tables.Add(Data_Expected[i][tabl])
         j = EntMysql.Max
      End Select
    Next
  Next

  If Not stopped Then
    For Each NomTable In tables
      ctx = "table : " & NomTable & " (index)"
      SyncKeys(NomTable)
    Next
  Endif

  Finally
    pb.Close
    Utils.db.Commit() 'Workaround sur bug a l'affichage (Refresh_Data), il semble que DB_Con.Tables ne soit pas a jour lors d'ajout de nouveau champ
    Refresh_Data()
    Message.Warning("Continuer à travailler sur Laurux après une réparation de la base pourrait endommager vos données \n Veuillez quitter Laurux")

  Catch
    Message.Error("Erreur " & Error.Text & " sur la " & ctx)

End

  
Private Sub DropKey(NomTable As String, field As String) ''supprime tous les index (clef primaire comprise) contenant le champ

  Dim res As Result

  res = Utils.db.Exec("SHOW INDEX FROM " & NomTable & " WHERE Column_name = &1", field)
  If Not res.Available Then Return
  'une ligne par index contenant le champ : on supprime l'index entier, Corriger recréera ceux attendus
  Repeat
    If res!Key_name = "PRIMARY" Then
      DropPrimary(NomTable)
    Else
      Utils.db.Exec("ALTER TABLE " & NomTable & " DROP INDEX `" & res!Key_name & "`")
    Endif
  Until res.MoveNext()

End

Private Sub DropPrimary(NomTable As String) ''supprime la clef primaire et l'AUTO_INCREMENT qui en dépend

  Dim res As Result
  Dim req As String

  req = "ALTER TABLE " & NomTable & " DROP PRIMARY KEY"
  'un champ AUTO_INCREMENT doit rester indexé : on retire l'attribut dans la même requête
  res = Utils.db.Exec("SHOW COLUMNS FROM " & NomTable & " WHERE Extra LIKE &1", "%auto_increment%")
  If res.Available Then req &= ", MODIFY `" & res!Field & "` " & res!Type & " NOT NULL"
  Utils.db.Exec(req)

End

Private Sub SyncKeys(NomTable As String) ''aligne clef primaire, AUTO_INCREMENT et index secondaires sur db_control.csv

  Dim wanted As New Collection
  Dim actual As New Collection
  Dim types As New Collection
  Dim row, cols, parts As String[]
  Dim e, ent, fld, kname As String
  Dim wantedAI, wantedAIType, actualAI, wantedPK, actualPK As String
  Dim p, seq As Integer
  Dim res As Result

  'index attendus (wanted) lus dans db_control.csv : nom d'index -> champs ordonnés par seq_in_index
  For Each row In Datain
    If Lower(Trim(row[tabl])) <> Lower(NomTable) Then Continue
    fld = Trim(row[name])
    types[fld] = row[type]
    'un champ peut appartenir à plusieurs index : PRI(2),idx_numrecpt(1) ou idx_date(2),idx_code(1)
    For Each e In Split(row[PrimK], ",")
      ent = Trim(e)
      If ent = "" Then Continue
      p = InStr(ent, "(")
      If p Then
        kname = Left$(ent, p - 1)
        seq = CInt(Val(Mid$(ent, p + 1, Len(ent) - p - 1)))
      Else
        kname = ent
        seq = 0
      Endif
      If kname = "PRI_AI" Then
        wantedAI = fld
        wantedAIType = row[type]
        kname = "PRIMARY"
      Else If kname = "PRI" Then
        kname = "PRIMARY"
      Endif
      AddKeyCol(wanted, kname, seq, fld)
    Next
  Next

  'index réels (actual) de la table et champ AUTO_INCREMENT courant
  res = Utils.db.Exec("SHOW INDEX FROM " & NomTable)
  If res.Available Then
    Repeat
      AddKeyCol(actual, res!Key_name, res!Seq_in_index, res!Column_name)
    Until res.MoveNext()
  Endif
  res = Utils.db.Exec("SHOW COLUMNS FROM " & NomTable & " WHERE Extra LIKE &1", "%auto_increment%")
  If res.Available Then actualAI = res!Field

  If wanted.Exist("PRIMARY") Then wantedPK = KeyDef(wanted["PRIMARY"])
  If actual.Exist("PRIMARY") Then actualPK = KeyDef(actual["PRIMARY"])

  'clef primaire : reconstruite entièrement dès que ses champs ou l'AUTO_INCREMENT diffèrent
  If wantedPK <> actualPK Or wantedAI <> actualAI Then
    If actualPK Then DropPrimary(NomTable)
    If wantedAI Then RenumAI(NomTable, wantedAI, wantedAIType)
    parts = New String[]
    If wantedAI Then parts.Add("MODIFY `" & wantedAI & "` " & wantedAIType & " NOT NULL AUTO_INCREMENT")
    If wantedPK Then parts.Add("ADD PRIMARY KEY (" & KeyCols(wantedPK, types) & ")")
    If parts.Count Then Utils.db.Exec("ALTER TABLE " & NomTable & " " & parts.Join(", "))
  Endif

  'index secondaires : suppression des index en trop ou différents, puis création des manquants, en une seule requête
  parts = New String[]
  For Each cols In actual
    kname = actual.Key
    If kname = "PRIMARY" Then Continue
    If Not wanted.Exist(kname) Then
      parts.Add("DROP INDEX `" & kname & "`")
    Else If KeyDef(cols) <> KeyDef(wanted[kname]) Then
      parts.Add("DROP INDEX `" & kname & "`")
    Endif
  Next
  For Each cols In wanted
    kname = wanted.Key
    If kname = "PRIMARY" Then Continue
    If Not actual.Exist(kname) Then
      parts.Add("ADD INDEX `" & kname & "` (" & KeyCols(KeyDef(cols), types) & ")")
    Else If KeyDef(actual[kname]) <> KeyDef(cols) Then
      parts.Add("ADD INDEX `" & kname & "` (" & KeyCols(KeyDef(cols), types) & ")")
    Endif
  Next
  If parts.Count Then Utils.db.Exec("ALTER TABLE " & NomTable & " " & parts.Join(", "))

End

Private Sub RenumAI(NomTable As String, fld As String, fldType As String) ''rend le champ unique et non nul avant de le passer en AUTO_INCREMENT

  Dim res As Result

  res = Utils.db.Exec("SELECT COUNT(*) AS n, COUNT(DISTINCT `" & fld & "`) AS d, IFNULL(SUM(IFNULL(`" & fld & "`, 0) = 0), 0) AS z FROM " & NomTable)
  If res!n = res!d And res!z = 0 Then Return
  'colonnes temporaires : row_id_tmp numérote les lignes, val_tmp reçoit la nouvelle valeur
  Utils.db.Exec("ALTER TABLE " & NomTable & " ADD COLUMN row_id_tmp INT NOT NULL AUTO_INCREMENT PRIMARY KEY, ADD COLUMN val_tmp " & fldType & " NULL")
  'la première occurrence de chaque valeur non nulle est conservée
  Utils.db.Exec("UPDATE " & NomTable & " SET val_tmp = `" & fld & "` WHERE row_id_tmp IN (SELECT min_id FROM (SELECT MIN(row_id_tmp) AS min_id FROM " & NomTable & " WHERE `" & fld & "` <> 0 GROUP BY `" & fld & "`) AS first_rows)")
  'doublons, 0 et NULL reçoivent un numéro au-delà du maximum existant
  Utils.db.Exec("SET @counter = (SELECT IFNULL(MAX(`" & fld & "`), 0) FROM " & NomTable & ")")
  Utils.db.Exec("UPDATE " & NomTable & " SET val_tmp = (@counter := @counter + 1) WHERE val_tmp IS NULL ORDER BY row_id_tmp")
  Utils.db.Exec("UPDATE " & NomTable & " SET `" & fld & "` = val_tmp")
  Utils.db.Exec("ALTER TABLE " & NomTable & " DROP PRIMARY KEY, DROP COLUMN row_id_tmp, DROP COLUMN val_tmp")

End

Private Sub AddKeyCol(keys As Collection, kname As String, seq As Integer, fld As String) ''ajoute un champ à l'index kname sous la forme "seq:champ" (seq sur 3 chiffres pour le tri)

  Dim cols As String[]

  If Not keys.Exist(kname) Then keys[kname] = New String[]
  cols = keys[kname]
  'PRI_AI n'a pas de position : le champ est ajouté à la suite
  If seq = 0 Then seq = cols.Count + 1
  cols.Add(Right$("000" & CStr(seq), 3) & ":" & fld)

End

Private Function KeyDef(cols As String[]) As String ''liste des champs d'un index dans l'ordre de seq_in_index

  Dim s As String
  Dim lst As New String[]

  cols.Sort()
  For Each s In cols
    lst.Add(Mid$(s, 5))
  Next
  Return lst.Join(",")

End

Private Function KeyCols(keydef As String, types As Collection) As String ''liste SQL des champs d'un index pour ADD INDEX / ADD PRIMARY KEY

  Dim col As String
  Dim lst As New String[]

  For Each col In Split(keydef, ",")
    'TEXT/BLOB exigent une longueur de préfixe, non mémorisée dans db_control.csv
    If types[col] Like "*text*" Or types[col] Like "*blob*" Then
      lst.Add("`" & col & "`(64)")
    Else
      lst.Add("`" & col & "`")
    Endif
  Next
  Return lst.Join(",")

End

Private Function SortKeys(keys As String) As String ''comparaison des clefs indépendante de l'ordre de SHOW INDEX

  Dim lst As String[]

  lst = Split(keys, ",")
  lst.Sort()
  Return lst.Join(",")

End


