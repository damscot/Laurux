' Gambas test file

''Tests de DB_Desktop (.hidden/reference/.src/Utils/DB_Desktop.class/test.md, DB_DESKTOP-T01 à T04).
''« ydotool » et « apt » sont remplacés par des scripts factices en tête du PATH (le faux apt affiche une
''ligne « installed » pour que ydotool() n'ouvre pas de Message.Info). La session est choisie par
''XDG_SESSION_TYPE dans l'environnement du processus. Valeurs attendues : assets/DB_DesktopTest/expected.txt.
''Non exercé : le Message.Info d'installation (DB_DESKTOP-T03, bloquant sans interaction).

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01DetectionSession", "Détection de session")
  TestKit.Desc("T02RoutageWayland", "Routage Wayland")

End

Public Sub _Setup()

  TestKit.Begin("Utils", "DB_DesktopTest")

End

'--------------------------------------------------------------------------------- faux binaires

Private $sDir As String ' répertoire du test : bin/ (faux binaires) et trace des appels

Private Sub FauxBinaires(aNoms As String[])
  ''Crée des scripts factices qui journalisent leur nom et leurs arguments (un « [arg] » par argument) dans
  ''<tmp>/trace, et les place en tête du PATH du processus (hérité par Shell/Exec).

  Dim sNom As String

  $sDir = Temp$()
  Mkdir $sDir
  Mkdir $sDir &/ "bin"
  For Each sNom In aNoms
    File.Save($sDir &/ "bin" &/ sNom, "#!/bin/sh\n{ printf '%s' \"$(basename \"$0\")\"; for a in \"$@\"; do printf ' [%s]' \"$a\"; done; echo; } >> '" & $sDir &/ "trace'\n")
    Chmod $sDir &/ "bin" &/ sNom To "rwxr-xr-x"
  Next
  Application.Env["PATH"] = $sDir &/ "bin" & ":" & Application.Env["PATH"]

End

Private Sub Trace(Optional Attendues As Integer = 0) As String[]
  ''Lignes de la trace (chemins temporaires remplacés par « <tmp> ») ; attend au plus 2 s qu'il y en ait
  ''« Attendues » (Shell asynchrone), puis vide la trace.

  Dim aRes As String[] = New String[]
  Dim sLigne As String
  Dim fFin As Float = Timer + 2
  Dim sTrace As String = $sDir &/ "trace"

  Repeat
    If Exist(sTrace) Then
      If Split(File.Load(sTrace), "\n", "", True).Count >= Attendues Then Break
    Endif
    Wait 0.05
  Until Timer > fFin
  If Not Exist(sTrace) Then Return aRes
  For Each sLigne In Split(File.Load(sTrace), "\n", "", True)
    aRes.Add(Replace(sLigne, $sDir, "<tmp>"))
  Next
  Kill sTrace
  Return aRes

End

Private Sub FauxApt()
  ''apt factice : « apt list --installed » renvoie une ligne contenant « installed » pour ydotool.

  File.Save($sDir &/ "bin/apt", "#!/bin/sh\necho 'ydotool/stable,now 1.0.4 amd64 [installed]'\n")
  Chmod $sDir &/ "bin/apt" To "rwxr-xr-x"

End

'---------------------------------------------------------------------------------------------- tests

Private Sub Session(Valeur As String) As Variant

  Dim hD As DB_Desktop

  Application.Env["XDG_SESSION_TYPE"] = Valeur
  Try hD = New DB_Desktop
  If Error Then Return "ERREUR: " & Error.Text
  Return hD.wayland

End

Public Sub T01DetectionSession()

  TestKit.Init()
  FauxBinaires(["ydotool"])
  FauxApt()
  TestKit.Check("T01/x11", Session("x11"))
  TestKit.Check("T01/wayland", Session("wayland"))
  TestKit.Check("T01/vide", Session(""))
  TestKit.Check("T01/tty", Session("tty"))
  TestKit.Check("T01/correspondance", Utils.de.correspondance.Count)

End

Public Sub T02RoutageWayland()

  Dim hD As DB_Desktop
  Dim sTouche As String

  TestKit.Init()
  FauxBinaires(["ydotool"])
  FauxApt()
  Application.Env["XDG_SESSION_TYPE"] = "x11"
  hD = New DB_Desktop
  hD.wayland = True
  For Each sTouche In ["[Return]", "[Tab]", "[BackSpace]", "[Delete]", "abc def", "a;b", "[Escape]"]
    hD.SendKey(sTouche)
    TestKit.Check("T02/" & sTouche, Trace(1))
  Next

End
