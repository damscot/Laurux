  If Me.ind = -1 Then
    Stop Event
    Return
  Endif
  radioBchange(["Fiches_Art", "art_cfour", "art_design"])
  
End

Public Sub RadioButton2_click()

  If Me.ind = -1 Then
    Stop Event
