SELECT SUM(qte) AS qte,SUM(ca) AS ca,SUM(mrgart)+SUM(mrgmo) as marge,client,article FROM (SELECT CASE WHEN qte_ligfac IS NULL THEN '0' ELSE REPLACE(qte_ligfac,',','.') END AS qte, CASE WHEN netht_ligfac IS NULL THEN '0' ELSE REPLACE(netht_ligfac,',','.') END as ca,CASE WHEN mrgart_ligfac IS NULL THEN '0' ELSE REPLACE(mrgart_ligfac,',','.') END as mrgart,CASE WHEN mrgmo_ligfac IS NULL THEN '0' ELSE REPLACE(mrgmo_ligfac,',','.') END as mrgmo, datefac AS dte,cdclifac as client ,code_ligfac as article FROM Fiches_HistoFac,Fiches_HistoLigfac,Fiches_Cli,Fiches_Art WHERE cli_code=cdclifac AND num_ligfac=numfac AND art_code=code_ligfac AND typel_ligfac = 'A' AND (cdclifac>='41100001' AND cdclifac<='41199999') AND (code_ligfac>='000000000000000' AND code_ligfac<='ZZZZZZZZZZZZZZZ') AND (art_four>='40100001' AND art_four<='40199999')SELECT CASE WHEN qte_ligfac IS NULL THEN '0' ELSE REPLACE(qte_ligfac,',','.') END AS qte, CASE WHEN netht_ligfac IS NULL THEN '0' ELSE REPLACE(netht_ligfac,',','.') END as ca,CASE WHEN mrgart_ligfac IS NULL THEN '0' ELSE REPLACE(mrgart_ligfac,',','.') END as mrgart,CASE WHEN mrgmo_ligfac IS NULL THEN '0' ELSE REPLACE(mrgmo_ligfac,',','.') END as mrgmo,datefac AS dte,cdclifac as client ,code_ligfac as article FROM Fiches_HistoFacM,Fiches_HistoLigfacM,Fiches_Cli,Fiches_Art WHERE cli_code=cdclifac AND num_ligfac=numfac AND art_code=code_ligfac AND typel_ligfac = 'A' AND (cdclifac>='41100001' AND cdclifac<='41199999') AND (code_ligfac>='000000000000000' AND code_ligfac<='ZZZZZZZZZZZZZZZ') AND (art_four>='40100001' AND art_four<='40199999')) AS a WHERE (dte BETWEEN '2018-01-01 00:00:00' And '2018-06-30 23:59:59') GROUP BY client,article
