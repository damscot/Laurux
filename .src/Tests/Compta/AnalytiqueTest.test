' Gambas test file

''Tests de Analytique (.hidden/reference/.src/Compta/Analytique.class/test.md, ANALYTIQUE-T01, T02, T03, T05, T07).
''Prévus en replay depuis la saisie d'écritures (Saisecrit) : la fenêtre est instanciée ici sans être affichée,
''avec les arguments que lui passe Saisecrit (montant formaté « 0.00 », sens = debit.Value), puis Deb1,
''Tbrem_Save et Button2_Click (publics) sont appelés directement. Jeu analytique_postes (postes 01-03,
''ventilations de 606100, 613200, 625100, écriture 900002 déjà ventilée). Valeurs attendues :
''assets/AnalytiqueTest/expected.txt (clone de référence).

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01VentilationDefaut", "Ventilation par défaut 60/40 puis Valider (lignes Fiches_MvtA, A02)")
  TestKit.Desc("T02VentilationExistante", "Rechargement d'une ventilation existante puis Valider")
  TestKit.Desc("T03EditionCellules", "Tbrem_Save : changement de poste, de % et de montant (cellules et totaux)")
  TestKit.Desc("T05DeuxComptes", "Deux comptes ventilés dans une même écriture (A02)")
  TestKit.Desc("T07Postes21", "21 postes analytiques : erreur d'indice à l'instanciation (A03)")

End

Public Sub _Setup()

  TestKit.Begin("Compta", "AnalytiqueTest")
  TestKit.OuvreBase("analytique_postes")

End

Private Function Ouvre(sCle As String, sCompte As String, sMtd As String, sNum As String, bDebit As Boolean, sJour As String, sIntitule As String) As Analytique
  ''Instancie l'écran comme Saisecrit (sans l'afficher) et charge la grille par Deb1.

  Dim hF As Analytique

  Try hF = New Analytique(sCompte, sMtd, sNum, bDebit, sJour, "15/06/2018", sIntitule, "DOC" & sNum, "Libelle " & sNum)
  If Error Then
    TestKit.Check(sCle & "/new", "ERREUR: " & Error.Text)
    Return Null
  Endif
  Try hF.Deb1()
  If Error Then TestKit.Check(sCle & "/Deb1", "ERREUR: " & Error.Text)
  Return hF

End

Private Sub Grille(sCle As String, hF As Analytique)
  ''Relève les cellules de Tbrem et les libellés de totaux.

  Dim hG As Object = hF.Controls["Tbrem"]
  Dim i As Integer
  Dim sNom As String

  TestKit.Check(sCle & "/lignes", hG.Rows.Count)
  For i = 0 To hG.Rows.Count - 1
    TestKit.Check(sCle & "/l" & i, hG[i, 0].Text & " | " & hG[i, 1].Text & " | " & hG[i, 2].Text)
  Next
  For Each sNom In ["Label3", "Label4", "Label5", "Label6", "Label11"]
    TestKit.Check(sCle & "/" & sNom, Object.GetProperty(hF.Controls[sNom], "Text"))
  Next

End

Private Sub LignesMvtA(sCle As String)
  ''Contenu de Fiches_MvtA (toutes écritures).

  Dim r As Result
  Dim i As Integer

  r = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabMvtA") & " ORDER BY numero, lind")
  TestKit.Check(sCle & "/mvta_nb", r.Count)
  If Not r.Available Then Return
  Repeat
    TestKit.Check(sCle & "/mvta" & i, r!numero & ";" & r!compte & ";" & r!intitule & ";" & Format(r!dte, "yyyy-mm-dd hh:nn:ss") & ";" & r!numdoc & ";" & r!libelle & ";" & r!pourcent & ";" & r!montantd & ";" & r!montantc & ";" & r!jour & ";" & r!poste & ";" & r!validee)
    Inc i
  Until r.MoveNext()

End

Private Sub Valide(sCle As String, hF As Analytique)
  ''Bouton Valider (Button2_Click).

  Try hF.Button2_Click()
  If Error Then TestKit.Check(sCle & "/valider", "ERREUR: " & Error.Text)

End

Public Sub T01VentilationDefaut()

  Dim hF As Analytique

  TestKit.Check("T01/locale", System.Language & " " & Format$(1.5, "0.00") & " " & Str(Val("2,5")))
  hF = Ouvre("T01", "606100", "200,00", "900001", True, "AC", "Achats fournitures")
  If Not hF Then Return
  Grille("T01/ouverture", hF)
  Valide("T01", hF)
  LignesMvtA("T01/apres")

End

Public Sub T02VentilationExistante()

  Dim hF As Analytique

  hF = Ouvre("T02", "606100", "300,00", "900002", False, "AC", "Achats fournitures")
  If Not hF Then Return
  Grille("T02/ouverture", hF)
  Valide("T02", hF)
  LignesMvtA("T02/apres")

End

Public Sub T03EditionCellules()

  Dim hF As Analytique

  hF = Ouvre("T03", "625100", "100,00", "900003", True, "OD", "Deplacements")
  If Not hF Then Return
  Grille("T03/ouverture", hF)
  ' poste de la ligne 0 changé pour un poste non ventilé sur ce compte
  Try hF.Tbrem_Save(0, 0, "03 - Commercial")
  If Error Then TestKit.Check("T03/poste_err", "ERREUR: " & Error.Text)
  Grille("T03/poste", hF)
  ' % de la ligne 1 changé
  Try hF.Tbrem_Save(1, 1, "33,33")
  If Error Then TestKit.Check("T03/pourcent_err", "ERREUR: " & Error.Text)
  Grille("T03/pourcent", hF)
  ' montant de la ligne 2 changé (négatif)
  Try hF.Tbrem_Save(2, 2, "-12,5")
  If Error Then TestKit.Check("T03/montant_err", "ERREUR: " & Error.Text)
  Grille("T03/montant", hF)
  ' valeur nulle : remplacée par 0,00
  Try hF.Tbrem_Save(1, 1, "")
  If Error Then TestKit.Check("T03/vide_err", "ERREUR: " & Error.Text)
  Grille("T03/vide", hF)
  ' % ramené à 100 sur la ligne 0 pour une ventilation complète
  Try hF.Tbrem_Save(0, 1, "100")
  If Error Then TestKit.Check("T03/cent_err", "ERREUR: " & Error.Text)
  Grille("T03/cent", hF)

End

Public Sub T05DeuxComptes()

  Dim hF As Analytique

  hF = Ouvre("T05/c1", "606100", "200,00", "900005", True, "AC", "Achats fournitures")
  If Not hF Then Return
  Valide("T05/c1", hF)
  LignesMvtA("T05/apres_c1")
  hF = Ouvre("T05/c2", "613200", "80,00", "900005", True, "AC", "Locations")
  If Not hF Then Return
  Grille("T05/c2_ouverture", hF)
  Valide("T05/c2", hF)
  LignesMvtA("T05/apres_c2")

End

Public Sub T07Postes21()

  Dim i As Integer
  Dim hF As Analytique

  For i = 4 To 21
    Utils.db.Exec("INSERT INTO " & Cbase.Table("TabPostes") & " (code, intitulep) VALUES (&1, &2)", Format(i, "00"), "Poste " & i)
  Next
  TestKit.Check("T07/postes", Utils.db.Exec("SELECT count(*) AS n FROM " & Cbase.Table("TabPostes"))!n)
  hF = Ouvre("T07", "606100", "200,00", "900007", True, "AC", "Achats fournitures")
  TestKit.Check("T07/instance", Not IsNull(hF))

End
