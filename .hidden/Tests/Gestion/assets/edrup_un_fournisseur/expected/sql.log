drop Table IF exists Rupture
drop Table IF exists RuptureC
CREATE TABLE Rupture(codea Char(15) NOT NULL,intitulea Char(50),four Char(8),qtecli FLOAT,qtefour FLOAT,qtecom FLOAT,codec Char(8),intitulec Char(50),numcom Char(50),PRIMARY KEY (codea, intitulea, four)) ENGINE = InnoDB
CREATE TABLE RuptureC(codea Char(15) NOT NULL,intitulea Char(50),four Char(8),qtecom FLOAT,qte FLOAT,codec Char(8),intitulec Char(50),numcom Char(50),PRIMARY KEY (codea, codec, numcom, intitulea, four)) ENGINE = InnoDB
SELECT * FROM Fiches_Ligcom left join Fiches_Art on art_code = code WHERE code >= '0000000000000' and code <= 'ZZZZZZZZZZZZZ' and four >= '401002' and four <= '401002' and art_stocke = 1
