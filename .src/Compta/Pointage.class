'Public List As String[]
Public Bsel As Boolean = False
Public Bval As Variant

Private Col As Collection
Private tr As TriGen
Private Selected As String[]
Private IsLast As Boolean


Public Sub _New()

  Me.Center
  dte.Type = TextReg.EstDate
  dte.Text = LDate(Now).L
  dterappro.Type = TextReg.EstDate
  dterappro.Text = LDate(Now).L
  Sldepart.Type = TextReg.EstNum
  Sldepart.nbdec = "2"
  Sldfinal.Type = TextReg.EstNum
  Sldfinal.nbdec = "2"
  cpt.SetFocus
  cpt.Select
  
  Totdeb.Text = "0,00"
  Totcred.Text = "0,00"
  Sldtheorique.Text = "0,00"
  Ecart.Text = "0,00"
  Sldfinal.Text = "0,00"
  
  Selected = New String[]
  IsLast = False
  Update_Req()
  
End

Public Sub Update_Req()

  Dim f As ResultField
  Dim k As String
  Dim Req As String
  Dim Res As Result
  Dim prop As ObjProp
  
  If IsNull(cpt.Text) Then Return
  
  Col = New Collection
  
  ' colcli.Columns[0].Text = "code"
  ' colcli.Columns[1].Text = "date"
  ' colcli.Columns[2].Text = "nom"
  ' colcli.Columns[3].Text = "Document"
  ' colcli.Columns[4].Text = "Lot"
  ' colcli.Columns[5].Alignment = 2
  ' colcli.Columns[5].Text = "Débit"
  ' colcli.Columns[6].Alignment = 2
  ' colcli.Columns[6].Text = "Crédit"
  ' colcli.Columns[7].Text = "Relevé"
  ' colcli.Columns[8].Text = "Ecriture"
  ' colcli.Columns[9].Text = "Pnt"
  
  
  'La requete de construction est limité à 1 element.
  Req = "SELECT *, CAST(IF(pointee=TRUE, 'O', 'n') As CHAR) AS parse_having_P FROM " & Cbase.Table("TabMvt") & " limit 1"
  Res = Utils.db.Exec(Req)
  If Not Res.Available Then Return
  'On utilise pas les champs field.name du résultat pour le nom car l'union avec la Table N1 cree des noms incompatible dans la requete
  k = "- idx -"
  prop = New ObjProp("numero", k)
  prop.tri = 1
  Col.Add(prop, k)
  k = "P"
  prop = New ObjProp("parse_having_P", k)
  Col.Add(prop, k)
  k = "-  Date  -"
  prop = New ObjProp("dte", k)
  Col.Add(prop, k)
  k = "--------  libelle  ---------"
  prop = New ObjProp("libelle", k)
  Col.Add(prop, k)
  k = "- Debit -"
  prop = New ObjProp("montantd", k)
  Col.Add(prop, k)
  k = "- Credit -"
  prop = New ObjProp("montantc", k)
  Col.Add(prop, k)
  k = "- Rlv -"
  prop = New ObjProp("nrlv", k)
  Col.Add(prop, k)
  k = "--- Doc ---"
  prop = New ObjProp("numdoc", k)
  Col.Add(prop, k)
  k = "--- Lot ---"
  prop = New ObjProp("numlot", k)
  Col.Add(prop, k)
  
  If N1.Value = True Then
    'La table Mvt est prioritaire sur la table Mvt1 pour les ecritures dupliquée, voir le group by ci-dessous.
    Req = Utils.db.Subst("SELECT * FROM (SELECT *, CAST(IF(pointee=TRUE, 'O', 'n') As CHAR) AS parse_having_P, " & LCoul.Ecr_DB_bgcolor(False) & " FROM " & Cbase.Table("TabMvt") & " union SELECT *, CAST(IF(pointee=TRUE, 'O', 'n') As CHAR) AS parse_having_P, " & LCoul.Ecr_DB_bgcolor(True) & " FROM " & Cbase.Table("TabMvt1") & ") as Combined_Mvt")
  Else
    Req = Utils.db.Subst("SELECT *, CAST(IF(pointee=TRUE, 'O', 'n') As CHAR) AS parse_having_P, " & LCoul.Ecr_DB_bgcolor(False) & " FROM " & Cbase.Table("TabMvt"))
  Endif

  tr = New TriGen(Panel1, Col, Res, Req, 20, Me) As "TriGen"
  If N1.Value = True Then
    'En affichage N-1, les ecritures peuvent etre doublé si elles sont présente dans les deux tables (cloture apres avoir saisie/pointee des ecritures apres la date de fin de l'exercice)
    'Logiquement c'est une copie de l'ecriture, le groupement ne pose pas de pb.
    tr.GroupBy("group by numero")
  Endif
  Filter_Calc()
  tr.FontSize(-2)
  tr.Update() 

End

'Event Handler
'''''''''''''''''''''''''''''''''''''''
Public Sub TriGen_MajSel(val As Variant)
  
  Dim Res As Result
  Dim i As Integer

  If Bsel = True Then
    If Val Then
      i = Selected.Find(Val)
      If i <> -1 Then
        Selected.Remove(i)
      Else
        Selected.Add(Val)
      Endif
      Selcnt.Value = Selected.Count
      tr.Refresh_Data()
      Bsel = False
      Val = ""
      Calc_Solde()
    Endif
  Endif
  
  Stop Event

End

Public Sub TriGen_Raz()
  
  Selected.Clear()
  Selcnt.Value = 0
  
End
  
Public Sub TriGen_Data(id As String, key As String, Data As _GridView_Data)
  
  If Selected.Find(Val(id)) <> -1 Then
    Data.Background = Color.SelectedBackground
    Stop Event
  Else
    'set default display
    'Stop Event
  Endif
  
  
End

Private Sub Filter_Calc()
  
  Dim filter As String
  
  If IsNull(cpt.Text) Then Return
  
  If Toutes.Value Then
    filter = Utils.db.Subst("compte = &1 and tresorerie = &2 and validee = &3", cpt.text, 1, 1)
  Else If Ep.Value Then
    filter = Utils.db.Subst("compte = &1 and tresorerie = &2 and validee = &3 and pointee is TRUE", cpt.text, 1, 1)
    If Nrel.Text And RelUniq.Value = True Then
      filter = filter & Utils.db.Subst(" and nrlv = &1", Nrel.Text)
    Endif
  Else If Enp.Value Then
    filter = Utils.db.Subst("compte = &1 and tresorerie = &2 and validee = &3 and (pointee is NULL or pointee is FALSE)", cpt.text, 1, 1)
  Endif
  
  If MaskRecent.Value Then
    filter = filter & Utils.db.Subst(" and dte <= &1", LDate(dte.Text).D)
  Endif

  tr.ExtraSel(filter, "and")

End

'*****************************************
'*     On affiche les relevés bancaires  *
'*****************************************

Public Sub ToggleButton1_MouseDown()

  Dim rResult As Result

  If cpt.Text = "" Then
    Utils.Bip()
    Message.Warning("veuillez saisir votre compte banque SVP !")
  Else
    If Colrlv.Visible Then
      Colrlv.Clear
      Colrlv.Visible = False
      Colrlv.Lower()
      nrel.setfocus
    Else
      Colrlv.visible = True
      Colrlv.Raise()
      Colrlv.Columns.count = 5
      Colrlv.Columns[0].Width = 80
      Colrlv.Columns[1].Width = 80
      Colrlv.Columns[2].Width = 80
      Colrlv.Columns[3].Width = 80
      Colrlv.Columns[4].Width = 80
      Colrlv.Columns[0].Text = " compte "
      Colrlv.Columns[1].Text = "N° relevé"
      Colrlv.Columns[2].Text = "date relevé"
      Colrlv.Columns[3].Text = "date point."
      Colrlv.Columns[4].Text = "solde fin."
      rResult = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabRappro") & " WHERE cpt = &1 order by date_releve desc, nreleve desc", cpt.Text)
      If rResult.Available Then
        Do
          Colrlv.Add(rResult!cpt & rResult!nreleve, rResult!cpt & rResult!nreleve)
          Colrlv.Item[0] = rResult!cpt
          Colrlv.Item[1] = rResult!nreleve
          Colrlv.Item[2] = Utils.Cdate_Aff(rResult!date_releve)
          Colrlv.Item[3] = Utils.Cdate_Aff(rResult!date_rappro)
          Colrlv.Item[4] = rResult!solde
        Loop Until rResult.MoveNext()
        Colrlv.MoveFirst
        Colrlv.SetFocus
        Colrlv.Item.Selected = True
      Else
      Endif
    Endif
  Endif

End

'*********************************************
'*   On récupere le relevé avec la souris    *
'*********************************************
Public Sub Colrlv_Click()

  Colrlv.MoveCurrent
  Colrlv.Item.Selected = True
  Colrlv_Man(Colrlv.Item[1])

End

'********************************************
'*   On récupere le relevé manuellement     *
'********************************************
Public Sub Colrlv_KeyPress()

  Stop Event
  If Key.code = Key.Enter Or Key.code = Key.Return Then
    Colrlv.MoveCurrent
    Colrlv.Item.Selected = True
    Colrlv_Man(Colrlv.Item[1])
  Endif

  If Key.code = Key.Escape
    Colrlv.visible = False
    Colrlv.clear
    Nrel.Select
    Nrel.SetFocus
  Endif

End

'********************************************************************
'* On appelle le relevé en le tapant (sans la souris et sans F2)    *
'********************************************************************
Public Sub Colrlv_Man(releve As String) As Boolean

  Dim rResult As Result
  Dim rResult2 As Result
  Dim rResult3 As Result
  
  'Empeche la recursivité d'appel lié a l'usage de la classe Message + handler event lostfocus
  If IsNull(releve) Then
    RelUniq.Value = False
    dte.Text = Ldate(Now).L
    dterappro.Text = LDate(Now).L
    Return False
  Endif

  If IsNull(Cpt.Text) Then
    Nrel.Text = ""
    dte.Text = Ldate(Now).L
    dterappro.Text = LDate(Now).L
    Utils.Bip()
    Message.Warning("veuillez saisir votre compte banque SVP !")
    Return False
  Endif
  
  rResult = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabRappro") & " WHERE cpt = &1 and nreleve = &2", cpt.Text, releve)
  If rResult.Available Then
    ClearChampsAll()
    'avec un relevé selectionné existant on souhaite probablement plus voir uniquement les ecritures pointee pour ce relevé
    RelUniq.Value = True
    Nrel.Text = rResult!nreleve
    dte.Text = Ldate(rResult!date_releve).L
    dterappro.Text = LDate(rResult!date_rappro).L
    'Rappel d'un relevé existant on passe en ecriture pointee sur ce relevé par défault
    Ep.Value = True
    rResult2 = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabRappro") & " WHERE cpt = &1 and date_releve < &2 order by date_releve desc limit 1", cpt.Text, LDate(dte.Text).D)
    If rResult2.Available Then
      Sldepart.Text = LPrix(rResult2!solde).L
    Else
      Sldepart.Text = LPrix(0).L
      Message.Error("Impossible de trouver un relevé précédent le relevé " & releve & ", veuillez saisir le solde de départ manuellement.")
    Endif
    'Recherche d'un relevé plus récent... pour ne mettre a jour le solde du compte uniquement pour le dernier relevé du compte
    rResult2 = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabRappro") & " WHERE cpt = &1 and date_releve > &2 order by date_releve desc limit 1", cpt.Text, LDate(dte.Text).D)
    If Not rResult2.Available Then
      IsLast = True
      rResult3 = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabComptes") & " where compte_cc = &1", cpt.Text)
      If rResult3.Available Then
        Sldfinal.Text = LPrix(rResult3!soldep).L
      Else
        'ceci ne devrait pas arriver...
        Sldfinal.Text = LPrix(0).L
      Endif
    Else
      Sldfinal.Text = LPrix(rResult!solde).L
    Endif
    If Colrlv.Visible = True Then
      Colrlv.Clear
      Colrlv.Visible = False
    Endif
    Update_Req()
    Calc_Solde()
    Return True
  Else
    Nrel.Text = ""
    Utils.Bip()
    If Message.Question("Le rapprochement bancaire " & releve & " n'existe pas. Voulez-vous le créer", "Oui", "Non") = 2 Then 
      Return False
    Else
      ClearChampsAll()
      Nrel.Text = releve
      dte.Text = Ldate(Now).L
      dterappro.Text = LDate(Now).L
      'Creation d'un nouveau relevé on selectionne la liste des ecriture non pointee par défault
      Enp.Value = True
      'avec un nouveau relevé on souhaite probablement passer facilement de ecriture pointée pour ce relevé a celle non pointee
      RelUniq.Value = True
      'Il s'agit du dernier relevé (à priori)
      IsLast = True
      rResult2 = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabRappro") & " WHERE cpt = &1 order by date_releve desc limit 1", cpt.Text, LDate(dte.Text).D)
      If rResult2.Available Then
        Sldepart.Text = LPrix(rResult2!solde).L
      Else
        Sldepart.Value = 0 
        Message.Error("Impossible de trouver le dernier relevé existant veuillez saisir le solde de départ manuellement.")
      Endif
      rResult3 = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabComptes") & " where compte_cc = &1", cpt.Text)
      If rResult3.Available Then
        Sldfinal.Text = LPrix(rResult3!soldep).L
      Else
        Sldfinal.Text = LPrix(0).L
      Endif
      Utils.db.Exec("insert into " & Cbase.Table("TabRappro") & " (cpt, nreleve, date_releve, date_rappro, solde) values (&1,&2, &3,&4,&5)", cpt.Text, releve, LDate(dte.Text).D, LDate(dterappro.Text).D, LPrix(Sldfinal.Text).D)
      Update_Req()
      Calc_Solde()
      Return True
    Endif
  Endif

End

Public Sub Nrel_LostFocus()

  Colrlv_Man(Nrel.Text)
  Stop Event

End

Public Sub Nrel_KeyPress()

  If Key.code = Key.Enter Or Key.code = Key.Return Then
    Colrlv_Man(Nrel.Text)
    Stop Event
  Endif

End

Public Sub Dte_LostFocus()

  Update_Req()
  Stop Event

End

Public Sub Dte_KeyPress()

  If Key.code = Key.Enter Or Key.code = Key.Return Then
    Update_Req()
    Stop Event
  Endif

End

'********************************************************************
'* On appelle le compte en le tapant (sans la souris et sans F2)    *
'********************************************************************
Public Sub cptman(compte As String) As Boolean

  Dim rResult As Result
  Dim soldepointee As String
  
  'Empeche la recursivité d'appel lié a l'usage de la classe Message + handler event lostfocus
  If IsNull(compte) Then Return False

  rResult = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabComptes") & " where compte_cc = &1", compte)
  If Not rResult.Available Then
    cpt.Text = ""
    Utils.Bip()
    Message.Error("Attention ! Le compte " & compte & " n'existe pas.")
    Return False
  Else
    ClearChampsAll()
    cpt.Text = rResult!compte_cc
    soldeBnq.Text = LPrix(rResult!solde).L
    intitule.Text = rResult!intitule_cc
    Sldepart.Text = LPrix(rResult!soldep).L

    rResult = Utils.db.Exec("SELECT (sum(montantd)-sum(montantc)) as soldepointee FROM  " & Cbase.Table("TabMvt") & " WHERE compte = &1 and ((cloturee = 1 and jour = 90 and libelle = &2) or pointee = 1)", compte, "Report a nouveau")
    If rResult.Available Then
      soldeBnq.Text = soldeBnq.Text & " (pointées : " & LPrix(rResult!soldepointee).L & ")"
    Endif
    Update_Req()
    Calc_Solde()
    Return True
  Endif

End

