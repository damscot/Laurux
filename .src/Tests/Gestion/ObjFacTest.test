Private Sub Remise(sCle As String)

  Dim hObj As ObjFac

  hObj = New ObjFac("B10001", ObjFac.bl, Dte())
  hObj.remise = True
  hObj.simpcond = True
  Try hObj.calcul()
  TestKit.Check(sCle & "/erreur", IIf(Error, "ERREUR: " & Error.Text & " " & Error.Where, "<aucune>"))
