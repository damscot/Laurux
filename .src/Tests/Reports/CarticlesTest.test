' Gambas test file

''Tests de Carticles (.hidden/reference/.src/Reports/Carticles.class/test.md, CARTICLES-T01 à T07).
''Chaque test produit un PDF non compressé (SetCompression(False)) dans un fichier temporaire et vérifie :
''le texte rendu par « pdftotext -layout » (une clé par ligne non vide) et l'empreinte md5 du fichier PDF
''(flux de page : positions, polices, couleurs), le nombre et la taille des pages (pdfinfo), après masquage de /CreationDate, de la date du jour et de
''User.Name. Valeurs attendues : assets/CarticlesTest/expected.txt, produites dans le clone de référence.
''Pas de base de données. T08 (rejeu des éditions) et T09 (FormatAligne, après extraction) restent à faire.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Stock", "Stock chiffré et non chiffré : Entete, Level1, Level3, Level3bis, Level5, Level2, Level4")
  TestKit.Desc("T02Tarif", "Tarif interne : Level7, Level6, Level7M, Level6M, Level10 (Lg 184 et 8), Ligne, EnteteTC, Level2TC, Level3TC")
  TestKit.Desc("T03Photo", "Mode photo : Level7bis, Level6bis (police inconnue), Photo valide et inexistante")
  TestKit.Desc("T04Ruptures", "Ruptures et ventes : Level13, Level13R, Level13V, Level14, Level14V")
  TestKit.Desc("T05ReguMo", "Régularisations Level11, Level12 ; mains d'oeuvre Level1MO, Level2MO (intitulé de 60 car.)")
  TestKit.Desc("T06Pied", "Footer sur 3 pages et AliasNbPages : Page 1/3 à 3/3")
  TestKit.Desc("T07TarifClient", "Tarif client : Level9, Level9bis, Level8, Level8bis, Ligne2")

End

Public Sub _Setup()

  TestKit.Begin("Reports", "CarticlesTest")

End

Private Function Nouveau(Optional sOrient As String = "Portrait", Optional sFormat As String = "A4") As Carticles

  Dim pdf As Carticles

  pdf = New Carticles(sOrient, "mm", sFormat)
  pdf.SetCompression(False)
  pdf.Open()
  pdf.AliasNbPages()
  Return pdf

End

' Écrit le PDF, vérifie chaque ligne non vide du texte extrait puis l'empreinte du fichier masqué.
Private Sub Verifie(sCle As String, pdf As Carticles)

  Dim sFic As String = Temp$("rep") & ".pdf"
  Dim sTxt As String
  Dim sLig As String
  Dim sBuf As String
  Dim sMd5 As String
  Dim n As Integer

  Try pdf.Output(sFic, False)
  If Error Then
    TestKit.Check(sCle & "/output", "ERREUR: " & Error.Text)
    Return
  Endif
  Shell "pdftotext -layout " & Shell$(sFic) & " -" To sTxt
  sTxt = Replace(sTxt, Format$(Date(Now), "dd/mm/yyyy"), "<date>")
  sTxt = Replace(sTxt, User.Name, "<utilisateur>")
  sTxt = Replace(sTxt, "\f", "<saut de page>\n")
  For Each sLig In Split(sTxt, "\n")
    sLig = RTrim(sLig)
    If sLig = "" Then Continue
    Inc n
    TestKit.Check(sCle & "/l" & Format$(n, "000"), sLig)
  Next
  TestKit.Check(sCle & "/lignes", n)
  Shell "pdfinfo " & Shell$(sFic) & " | grep -E '^(Pages|Page size)'" To sBuf
  TestKit.Check(sCle & "/pdfinfo", Trim(sBuf))
  ' Flux : masquage des valeurs variables puis empreinte
  sBuf = File.Load(sFic)
  sTxt = ""
  For Each sLig In Split(sBuf, "\n")
    If InStr(sLig, "/CreationDate") > 0 Then Continue
    sTxt &= sLig & "\n"
  Next
  sTxt = Replace(sTxt, Format$(Date(Now), "dd/mm/yyyy"), "<date>")
  sTxt = Replace(sTxt, User.Name, "<utilisateur>")
  File.Save(sFic & ".flux", sTxt)
  Shell "md5sum < " & Shell$(sFic & ".flux") To sMd5
  TestKit.Check(sCle & "/flux_md5", Trim(Left(sMd5, 32)))

End

Public Sub T01Stock()

  Dim pdf As Carticles = Nouveau()

  pdf.Entete("Stock chiffré au 15/06/2018")
  pdf.Level1()
  pdf.Level3("ART001", "Article un", "F1", "401001", "10,00", "5,00", "9,50", "3", "28,50", "27,00", 22)
  pdf.Level3("ART002", "Article deux", "F2", "401002", "20,00", "0,00", "20,00", "2", "40,00", "41,00", 27)
  pdf.Level3bis("ART003", "Article trois", "1,00", "0,00", "1,00", "1", "1,00", "1,00", 32)
  pdf.Level5("1234,56", "1234,56", 37)
  pdf.Entete("Stock non chiffré au 15/06/2018")
  pdf.Level2()
  pdf.Level4("ART001", "Article un", "F1", "401001", "3", 22)
  pdf.Level4("ART002", "Article deux", "F2", "401002", "2", 27)
  Verifie("T01", pdf)

End

Public Sub T02Tarif()

  Dim pdf As Carticles = Nouveau()

  pdf.Entete("Tarif interne")
  pdf.Level7()
  pdf.Level6("ART001", "Article un", "F1", "401001", "10,00", "5,00", "9,50", "1,50", "14,25", 22)
  pdf.Level10("17,10", 184, 27)
  pdf.Level6("ART002", "Article deux", "F2", "401002", "20,00", "0,00", "20,00", "2,00", "40,00", 32)
  pdf.Level10("48,00", 8, 37)
  pdf.Ligne(42)
  pdf.Entete("Tarif interne avec marge")
  pdf.Level7M()
  pdf.Level6M("ART001", "Article un", "F1", "401001", "9,50", "1,50", "14,25", "9,00", "33,33", 22)
  pdf.Level6M("ART002", "Article deux", "F2", "401002", "20,00", "2,00", "40,00", "20,50", "50,00", 27)
  pdf.EnteteTC("Tarif TTC")
  pdf.Level2TC()
  pdf.Level3TC("ART001", "Article un", "9,50", "1,50", "14,25", "20,00", "17,10", 22)
  pdf.Level3TC("ART002", "Article deux", "20,00", "2,00", "40,00", "20,00", "48,00", 27)
  Verifie("T02", pdf)

End

Public Sub T03Photo()

  Dim pdf As Carticles = Nouveau()

  pdf.Entete("Tarif interne avec photo")
  pdf.Level7bis()
  Try pdf.Level6bis("ART001", "Article un", "10,00", "5,00", "9,50", "1,50", "14,25", 22)
  TestKit.Check("T03/level6bis/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Photo(Application.Path &/ ".src/Images/monnaie/b100.png", 170, 22)
  TestKit.Check("T03/photo_valide/erreur", IIf(Error, Error.Text, ""))
  Try pdf.Photo("/chemin/inexistant/photo.png", 170, 45)
  TestKit.Check("T03/photo_absente/erreur", IIf(Error, Error.Text, ""))
  Verifie("T03", pdf)

End

Public Sub T04Ruptures()

  Dim pdf As Carticles = Nouveau()

  pdf.Entete("Ruptures")
  pdf.Level13()
  pdf.Level14("ART001", "Article un", "0", "401001", "9,50", "5", "REF1", "CEN1", 22)
  pdf.Level14("ART002", "Article deux", "-1", "401002", "20,00", "3", "REF2", "", 27)
  pdf.Entete("Ruptures (R)")
  pdf.Level13R()
  pdf.Entete("Ventes")
  pdf.Level13V()
  pdf.Level14V("ART001", "Article un", "0", "401001", "5", "2", "10", "0", 22)
  pdf.Level14V("ART002", "Article deux", "1", "401002", "3", "1", "5", "1", 27)
  Verifie("T04", pdf)

End

Public Sub T05ReguMo()

  Dim pdf As Carticles = Nouveau()

  Start.LocalSettings["/Soc" & Start.Societe & "/Taxe"] = "TVA"
  pdf.Entete("Régularisations")
  pdf.Level11()
  pdf.Level12("ART001", "Article un", "15/06/2018", "3", "0", "Inventaire", 22)
  pdf.Level12("ART002", "Article deux", "16/06/2018", "0", "2", "Casse", 27)
  pdf.Entete("Mains d'oeuvre")
  pdf.Level1MO()
  pdf.Level2MO("MO001", "Main d'oeuvre dont l'intitulé fait soixante caractères au to", "F1", "401001", "1", "45,00", "20,00", "T", "54,00", "1", 22)
  pdf.Level2MO("MO002", "Courte", "F2", "401002", "2", "30,00", "20,00", "M", "72,00", "2", 27)
  Verifie("T05", pdf)

End

Public Sub T06Pied()

  Dim pdf As Carticles = Nouveau()
  Dim i As Integer

  For i = 1 To 3
    pdf.Entete("Page " & i)
    pdf.Footer()
  Next
  Verifie("T06", pdf)

End

Public Sub T07TarifClient()

  Dim pdf As Carticles = Nouveau()

  pdf.Entete("Tarif client")
  pdf.Level9()
  pdf.Level8("ART001", "Article un", "F1", "401001", "14,25", "20,00", "17,10", 22)
  pdf.Level8("ART002", "Article deux", "F2", "401002", "40,00", "20,00", "48,00", 27)
  pdf.Ligne2(32)
  pdf.Entete("Tarif client sans famille")
  pdf.Level9bis()
  pdf.Level8bis("ART001", "Article un", "14,25", "20,00", "17,10", 22)
  pdf.Level8bis("ART002", "Article deux", "40,00", "20,00", "48,00", 27)
  Verifie("T07", pdf)

End
