Public Sub T16Commande()

  Dim aArt As String[] = ["001", "002", "003", "999"]
  Dim aUv As String[] = ["1", "6"]
  Dim aDec As String[] = ["", "0", "2", "3"]
  Dim sArt, sUv, sDec, sRes As String

  TestKit.OuvreBase("utils_cbarre_commande")
  For Each sArt In aArt
    For Each sUv In aUv
      For Each sDec In aDec
        Try sRes = Utils.Commande(sArt, sDec, sUv, "Four")
        If Error Then sRes = "ERREUR: " & Error.Text
        TestKit.Check("T16/Four/" & sArt & "/uv" & sUv & "/dec" & sDec, sRes)
      Next
    Next
    ' UTILS-A10 : branche org <> "Four", colonne code inexistante dans Fiches_Ligbl (erreur figée)
    Try sRes = Utils.Commande(sArt, "2", "1", "Cli")
    If Error Then sRes = "ERREUR: " & Error.Text
    TestKit.Check("T16/Cli/" & sArt, sRes)
  Next

End

Public Sub T17Orientation()

  Dim aChoix As String[] = ["F", "B", "FM"]
  Dim sChoix As String
  Dim bRes As Boolean
  Dim sRes As String
  Dim aNum As String[] = ["000001", "000002", "000003", "999999"]
  Dim sNum As String

  TestKit.OuvreBase()
  ' Sans option bois : aucune lecture de la base
  For Each sChoix In aChoix
    Start.LocalSettings["/Soc01/bois"] = False
    TestKit.Check("T17/sans_option/" & sChoix, Utils.orientation("000001", sChoix))
  Next
  ' UTILS-A09 : la branche FM interroge la table Bl (erreur figée)
  ' Option bois sur Laurux01.sql (tables de l'option absentes) : erreurs figées
  Start.LocalSettings["/Soc01/bois"] = True
  For Each sChoix In aChoix
    Try bRes = Utils.orientation("000001", sChoix)
    If Error Then
      sRes = "ERREUR: " & Error.Text
    Else
      sRes = TestKit.Canonique(bRes)
    Endif
    TestKit.Check("T17/bois_laurux01/" & sChoix, sRes)
  Next
  ' Option bois avec le jeu dérivé (tables minimales de l'option)
  TestKit.OuvreBase("utils_orientation")
  For Each sNum In aNum
    For Each sChoix In aChoix
      Try bRes = Utils.orientation(sNum, sChoix)
      If Error Then
        sRes = "ERREUR: " & Error.Text
      Else
        sRes = TestKit.Canonique(bRes)
      Endif
      TestKit.Check("T17/bois/" & sNum & "/" & sChoix, sRes)
    Next
  Next
  Try bRes = Utils.orientation("C001", "FM", "Client")
  If Error Then
    sRes = "ERREUR: " & Error.Text
  Else
    sRes = TestKit.Canonique(bRes)
  Endif
  TestKit.Check("T17/bois/FM_nom", sRes)

End

Public Sub T18Glb()

  ' MySQL direct (configuration de test)
  Utils.glb()
  TestKit.Check("T18/mysql/type", Utils.db.Type)
  ' Hôte de la base de test : 127.0.0.1 sur l'hôte, « db » dans le conteneur runner, vérifié par égalité
  TestKit.Check("T18/mysql/Host_conf", Utils.db.Host = Start.LocalSettings["/dbase/Host"])
  ' Port de la base de test : propre à chaque bac à sable (LAURUX_TEST_DB_PORT), vérifié par égalité
  TestKit.Check("T18/mysql/Port_conf", Utils.db.Port = Start.LocalSettings["/dbase/Port"])
  TestKit.Check("T18/mysql/Name", Utils.db.Name)
  TestKit.Check("T18/mysql/Login", Utils.db.Login)
  TestKit.Check("T18/mysql/Password", Utils.db.Password)
  ' MySQL + tunnel SSH
  Start.LocalSettings["/dbase/Prefixe"] = "pre_"
  Start.LocalSettings["/dbase/Con-ssh"] = True
  Start.LocalSettings["/dbase/Host"] = "serveur.mysql"
  Start.LocalSettings["/dbase/Port"] = "3307"
  Start.LocalSettings["/dbase/ssh/Portlocal"] = "13999"
  Start.LocalSettings["/dbase/ssh/Portssh"] = "2222"
  Start.LocalSettings["/dbase/ssh/Passwssh"] = "2D0D0D0D0D0D"
  Start.LocalSettings["/dbase/ssh/Passphrase"] = "phrase"
  Start.LocalSettings["/dbase/ssh/Hostssh"] = "passerelle.ssh"
  Start.LocalSettings["/dbase/ssh/Login"] = "util"
  Utils.glb()
  TestKit.Check("T18/ssh/Host", Utils.db.Host)
  TestKit.Check("T18/ssh/Port", Utils.db.Port)
  TestKit.Check("T18/ssh/Name", Utils.db.Name)
  TestKit.Check("T18/ssh/MysqlPort", Utils.mysqlPort)
  TestKit.Check("T18/ssh/MysqlServeur", Utils.MysqlServeur)
  TestKit.Check("T18/ssh/RemotePort", Utils.RemotePort)
  TestKit.Check("T18/ssh/SshPort", Utils.SshPort)
  TestKit.Check("T18/ssh/SshPassw", Utils.SshPassw)
  TestKit.Check("T18/ssh/SshPassphrase", Utils.SshPassphrase)
  TestKit.Check("T18/ssh/SshHost", Utils.SshHost)
  TestKit.Check("T18/ssh/SshUser", Utils.SshUser)
  ' SQLite
  Start.LocalSettings["/dbase/type"] = "sqlite3"
  Start.LocalSettings["/dbase/Host"] = "/tmp/bases"
  Utils.glb()
  TestKit.Check("T18/sqlite/type", Utils.db.Type)
  TestKit.Check("T18/sqlite/Host", Utils.db.Host)
  TestKit.Check("T18/sqlite/Name", Utils.db.Name)

End

Public Sub T19Ciel()

  Dim r As Result
  Dim sErr As String

  TestKit.OuvreBase()
  r = Utils.db.Exec("SHOW TABLES LIKE 'Ciel_Lrx%'")
  TestKit.Check("T19/avant/tables", r.Count)
  Try Utils.Ciel()
  If Error Then sErr = "ERREUR: " & Error.Text
  TestKit.Check("T19/appel1/erreur", sErr)
  r = Utils.db.Exec("SHOW TABLES LIKE 'Ciel_Lrx%'")
  TestKit.Check("T19/apres/tables", r.Count)
  r = Utils.db.Exec("SHOW COLUMNS FROM Fiches_Parametres LIKE 'imp_ciel'")
  TestKit.Check("T19/apres/imp_ciel", r.Count)
  If r.Available Then TestKit.Check("T19/apres/imp_ciel/type", r!Type)
  r = Utils.db.Exec("SHOW COLUMNS FROM Ciel_Lrx")
  TestKit.Check("T19/Ciel_Lrx/colonnes", r.Count)
  r = Utils.db.Exec("SHOW COLUMNS FROM Ciel_Lrx_Jo")
  TestKit.Check("T19/Ciel_Lrx_Jo/colonnes", r.Count)
  sErr = ""
  Try Utils.Ciel()
  If Error Then sErr = "ERREUR: " & Error.Text
  TestKit.Check("T19/appel2/erreur", sErr)

End

Public Sub T20MkdirRmdir()

  Dim sBase As String = User.Home &/ "t20"

  TestKit.Check("T20/Mkdir_p/simple", Utils.Mkdir_p(sBase &/ "simple"))
  TestKit.Check("T20/Mkdir_p/simple/existe", Exist(sBase &/ "simple"))
  TestKit.Check("T20/Mkdir_p/simple/droits", Stat(sBase &/ "simple").Auth)
  TestKit.Check("T20/Mkdir_p/imbrique", Utils.Mkdir_p(sBase &/ "a/b/c", "rwx------"))
  TestKit.Check("T20/Mkdir_p/imbrique/existe", Exist(sBase &/ "a/b/c"))
  TestKit.Check("T20/Mkdir_p/imbrique/droits", Stat(sBase &/ "a/b/c").Auth)
  TestKit.Check("T20/Mkdir_p/existant", Utils.Mkdir_p(sBase &/ "simple"))
  TestKit.Check("T20/Rmdir_rf/imbrique", Utils.Rmdir_rf(sBase &/ "a"))
  TestKit.Check("T20/Rmdir_rf/imbrique/existe", Exist(sBase &/ "a"))
  TestKit.Check("T20/Rmdir_rf/absent", Utils.Rmdir_rf(sBase &/ "absent"))
  TestKit.Check("T20/Rmdir_rf/racine", Utils.Rmdir_rf("/"))
  TestKit.Check("T20/Rmdir_rf/home", Utils.Rmdir_rf(User.Home))
  TestKit.Check("T20/Rmdir_rf/home/existe", Exist(User.Home))
  TestKit.Check("T20/Rmdir_rf/Null", Utils.Rmdir_rf(Null))
  TestKit.Check("T20/Rmdir_rf/simple", Utils.Rmdir_rf(sBase &/ "simple"))
  TestKit.Check("T20/Rmdir_rf/simple/existe", Exist(sBase &/ "simple"))

End

Public Sub T21Log()

  Dim hObj As New Collection

  Start.Arg_Debug = ""
  Utils.Log("TestNom", "message 1")
  Utils.Log("TestNom", "message 2", LLog.Error)
  TestKit.Check("T21/nom/nb_loggers", Start.LLogColl.Count)
  TestKit.Check("T21/nom/existe", Start.LLogColl.Exist("TestNom"))
  TestKit.Check("T21/nom/fichier", Exist(User.Home &/ "tmp/Debug/TestNom.log"))
  TestKit.Check("T21/nom/active", Start.LLogColl["TestNom"].Enabled)
  Start.Arg_Debug = "3,3"
  Utils.Log(hObj, "message objet")
  Utils.Log(hObj, "message objet 2")
  TestKit.Check("T21/objet/nb_loggers", Start.LLogColl.Count)
  TestKit.Check("T21/objet/existe", Start.LLogColl.Exist("Collection"))
  TestKit.Check("T21/objet/active", Start.LLogColl["Collection"].Enabled)

End
