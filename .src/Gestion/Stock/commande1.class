' Gambas class file

Create Static

Private $opt As String
Private $req As String
Private $win As Window
Private $panel As Panel
Private tr As TriGen
Private Col As Collection
Private $etat As Integer
Private $prop As New ObjProp[]
Private $cond As String               ''cle pour acceder a la commande, sous forme 'four='401X' and 
Private $numlock As String
Private $validBR As Boolean           ''a true si la modif vient de la validation des entrées
Private $Apdf As Boolean               ''si copie ged
Private $rd As RadioButton
Private $Bval As Variant = Null

Public Bsel As Boolean = False
Public Bval As Variant = Null
Public tbl As Achat


Public Sub _new(Optional num As String, nfour As String, dt As LDate, etat As Integer = Achat.Reception)

  Dim ch As Chainage
  
  $opt = Utils.Option()
  If $opt <> "N" Then
    TabStrip1.Count += 1
    TabStrip1.Text = "Options"
    TabStrip1.Picture = Picture["Icones/Saisiefacture.png"]
  Endif
  If Not Start.LocalSettings["/Soc" & Start.Societe & "/prixRecpt"] Then
    TabStrip1[1].Visible = False
    If $opt <> "N" Then TabStrip1[2].Visible = False
  Endif
  
  rececp.Tag = Achat.Sans
  dte.Type = TextReg.EstDate
  dte.dte.G = Now
  totfrais.Type = TextReg.EstNum
  totfrais.nbdec = "2"
  totaht.Type = TextReg.EstNum
  totaht.nbdec = "2"
  totttc.Type = TextReg.EstNum
  totttc.nbdec = "2"
  Qtes.Type = TextReg.EstNum
  Qtes.nbdec = "3"
  totht.Type = TextReg.EstNum
  totht.nbdec = "2"
  
  ch = New Chainage([fcode, ncom, com])
  fcode.SetFocus
  tbl = New Achat($prop, Panel2, panel3) As "Achat"
  tbl.VisibleTot = False
  tbl.show
  $etat = Achat.Reception
  
  If nfour Then
    $Bval = ["Fiches_Entrecpt.four": nfour, "Fiches_Entrecpt.numrecpt": num, "Fiches_Entrecpt.ddate": dt.L]
    $etat = etat
    bsel = True
    tbl.fourisseur = nfour
    tbl.ndoc = num
    tbl.date = dt
    fcode.Text = nfour
    dte.Text = dt.L
    tbl.ind = -1
    $validBR = True
  Endif
  'requetes préparées
  'Achats
  Utils.db.Prepare("requ_cli", "SELECT a.*,Fiches_TarTemp.*,Fiches_Tarcli.*,art_code,art_paht,art_pbht,art_txconv,art_tr,art_prvt,art_cdarr,art_coef,cli_code,cli_nom FROM (SELECT DISTINCT cart,ccli FROM Fiches_Tarcli WHERE cart = @code UNION SELECT DISTINCT art AS cart,code AS ccli FROM Fiches_TarTemp WHERE art = code AND temp_type = &1) AS a LEFT JOIN Fiches_TarTemp ON art=a.cart AND temp_type=&1 AND code = a.ccli LEFT JOIN  Fiches_Tarcli ON Fiches_Tarcli.cart = a.cart AND a.ccli = Fiches_Tarcli.ccli LEFT JOIN Fiches_Cli ON cli_code=a.ccli LEFT JOIN Fiches_Art ON art_code=a.cart WHERE a.cart=@code ", GesTar.TarCli)
  Utils.db.Prepare("requ_typ", "SELECT a.*,Fiches_TarTemp.*,Fiches_TarTypcli.*,art_code,art_paht,art_pbht,art_txconv,art_tr,art_prvt,art_cdarr,art_coef,Fiches_Typec.code,Fiches_Typec.* FROM (SELECT DISTINCT cart,type FROM Fiches_TarTypcli WHERE cart = @code UNION SELECT DISTINCT art AS cart,code AS type FROM Fiches_TarTemp WHERE art = @code AND temp_type = &1) AS a left JOIN Fiches_TarTemp ON art=a.cart AND temp_type= &1 AND Fiches_TarTemp.code = a.type  LEFT JOIN Fiches_TarTypcli ON a.cart=Fiches_TarTypcli.cart AND a.type=Fiches_TarTypcli.type LEFT JOIN Fiches_Typec ON Fiches_Typec.code=a.type JOIN Fiches_Art ON  art_code=a.cart WHERE a.cart=@code ", GesTar.TarTcli)
  
End

Public Sub Form_Open()
  
  Dim rd As RadioButton
  
  TabStrip1.Index = 0
  $win = New Window As "Window"
  $win.Arrangement = Arrange.Vertical
  $panel = New Panel($win) As "panel"
  $panel.Arrangement = Arrange.Horizontal
  $panel.h = 27
  $panel.Width = Me.Width + 40
  rd = New RadioButton($panel) As "commande"
  rd.Text = "Liste des commandes"
  rd.Expand = True
  rd = New RadioButton($panel) As "reception"
  rd.Text = "Liste des bons de réception"
  rd.Expand = True
  rd = New RadioButton($panel) As "valide"
  rd.Text = "Liste des bons de réception validées"
  rd.Expand = True
  $panel = New Panel($win)
  $win.Text = "Sélection des entrées"
  $win.Width = Me.Width + 50
  $win.Height = Me.Height - 100
  $win.Center
  $panel.Width = $win.Width - 10
  $panel.Height = $win.Height - 30
  $panel.X = 0
  $panel.y = 0
  $win.X = 0
  $win.Y = 0
  $win.Show
  If $Bval Then ColTri_MajSel($Bval)
  rd.Value = True
  $rd = rd
  $rd.Tag = Achat.Sans
  Me.Font = Font["Serif,-2"]
  
End

Public Sub form_Close()
  
  If $validBR Then DocActif.free_lock("Achat", $numlock)
  If Not IsNull(tbl) And If tbl.ligne.Count > 0 And Not $validBR Then
    If Message.Question("Vous avez une saisie en cours\nVoulez vous fermer quand même ?", "Oui", "Non") = 2 Then
      Stop Event
      Return 
    Else
      If $etat <> Achat.CreaCommande Then DocActif.free_lock("Achat", $numlock)
      $validBR = True
      $win.Close()
    Endif
  Else
    $win.Close()
  Endif

End

Public Sub Window_Close()

  If Not IsNull(tbl) And If tbl.ligne.Count > 0 And Not $validBR Then
    If Message.Question("Vous avez une saisie en cours\nVoulez vous fermer quand même ?", "Oui", "Non") = 2 Then
      Stop Event
      Return 
    Else
      If $etat <> Achat.CreaCommande Then DocActif.free_lock("Achat", $numlock)
      $validBR = True
      Me.Close
    Endif
  Else
    Me.Close
  Endif

End

Public Sub fcode_LostFocus()

  If fcode.Text Then FourMan(fcode.Text)

End

Public Sub com_LostFocus()

  If Not IsNull(tbl) Then tbl.commentaire = com.Text

End

Public Sub nbl_LostFocus()

  If Not IsNull(tbl) Then tbl.ndoc = nbl.Text

End

Public Sub ncom_LostFocus()

  If Not IsNull(tbl) Then tbl.ndoc = ncom.Text

End

Public Sub dte_LostFocus()

  If Not IsNull(tbl) Then tbl.date = dte.dte

End

Public Sub Achat_Ajou(Value As Sailig)

  Dim gt As GesTar
  Dim opt As Artopt
  Dim obs As Observer
  
  gt = New GesTar(Ptarif, Value) As "Tarif"
  If $opt <> "N" Then 
    TabStrip1.Index = TabStrip1.Count - 1
    opt = New Artopt(TabStrip1, $opt, value.MonControle["Frais"], value.MonControle["Px_Net"], value.MonControle["Px_Rev"], Null, value.MonControle["Code"], TabStrip1) As "opt"
    TabStrip1.Index = 0
    opt.Font = Font["+2"]
    value.Dernier = "Rem"
    Value.chain.sup(Value.MonControle["Frais"])
  Else
    Value.Dernier = "Frais"
  Endif
  stmini.Text = ""
  stmax.Text = ""
  comin.Text = ""
  stk.Text = ""
  qtecom.Text = ""
  Encom.Text = ""
  Value.AutresObj = New Object[Achat.ObjFin]
  Value.AutresObj[Achat.Tarif] = gt
  Value.AutresObj[Achat.Frais] = opt
  Value.chain.sup(Value.MonControle["Px_Net"])
  Value.chain.sup(Value.MonControle["Px_Rev"])
  obs = New Observer(Value.prx) As "LPrix"

End

Public Sub LPrix_change(lp As LPrix)

  Dim sl As Sailig
  
  totfrais.Value = 0
  totaht.Value = 0
  totht.Value = 0
  totttc.Value = 0
  Qtes.Value = 0
  For Each sl In tbl
    If sl Then
      If ($opt = "B" Or $opt = "T") And If Not IsNull(sl.AutresObj[Achat.Consignes]) Then
        If Not IsNull(sl.AutresObj[Achat.Consignes].ccd) Then totttc.Value += sl.AutresObj[Achat.Consignes].ccd.consigne.G
      Endif
      totfrais.Value += sl.MonControle["Frais"].Value * sl.prx.Qte
      totaht.Value += (sl.MonControle["Px_Net"].Value * sl.prx.Qte) 
      totht.Value += (sl.MonControle["Px_Net"].Value * sl.prx.Qte) + (sl.MonControle["Frais"].Value * sl.prx.Qte)
      totttc.Value += sl.prx.TotNTC.G
      Qtes.Value += sl.prx.Qte
      tbl.TotHt = totht.Value
      tbl.TotTtc = totttc.Value
    Endif
  Next
  
End


'***************Table de choix des commandes
Public Sub Update_Req()

  Dim k As String
  Dim Res As Result
  Dim prop As ObjProp
  
  Col = New Collection
   
  Res = Utils.db.Exec($req & " LIMIT 1")

  k = "--Code--"
  prop = New ObjProp(Res.Fields["four"], k)
  prop.cle = True
  Col.Add(prop, k)
  k = "------------------- Nom ---------------------"
  prop = New ObjProp(Res.Fields["fo_nom"], k)
  prop.tri = True
  Col.Add(prop, k)
  k = "--Numéro--"
  prop = New ObjProp(Res.Fields["numrecpt"], k)
  prop.cle = True
  Col.Add(prop, k)
  k = "-------- Date -----------"
  prop = New ObjProp(Res.Fields["ddate"], k)
  prop.AddChamp("Alignment", Align.Center, "dd.mm.yyyy")
  prop.cle = True
  prop.tri = True
  Col.Add(prop, k)
  k = "------ H.T ----------"
  prop = New ObjProp(Res.Fields["montant"], k)
  prop.AddChamp("Alignment", Align.Right, "0.00")
  Col.Add(prop, k)
  k = "------- T.T.C ---------"
  prop = New ObjProp(Res.Fields["mttc"], k)
  prop.AddChamp("Alignment", Align.Right, "0.00")
  Col.Add(prop, k)
  k = "------------------------- Commentaire ------------------------------"
  prop = New ObjProp(Res.Fields["commentaire"], k)
  Col.Add(prop, k)
  
  tr = New TriGen($Panel, Col, Res, $req, 20, Me) As "ColTri"
  
End

Public Sub ColTri_KeyPress()

  If Key.Code = Key.Esc Then Stop Event

End

Public Sub ColTri_MajSel(val As Variant)
  
  Dim col As String
  
  Stop Event
  If Not bsel Or IsNull(val) Then Return
  If Not IsNull(tbl) Then 
    If tbl.ligne.Count > 0 Then Return
  Endif
  If Bsel = True Then
    $Bval = Bval
    If Val Then
      $cond = ""
      For Each col In val
        If val.key Match "ddate" Then 
          $cond &= Utils.db.Subst(val.Key & "= &1", LDate(col).DT) & " AND " 
          dte.Text = LDate(col).L
        Else 
          $cond &= Utils.db.Subst(val.Key & " = &1", col) & " AND "
        Endif
        If val.Key Match "four" Then FourMan(col)
      Next
      $cond = Left($cond, -4)
      tbl.LitCommande($cond, $etat)
      Wait 0.1
      ChangVal($etat)
      $numlock = tbl.ndoc
      If Not DocActif.get_lock("Achat", tbl.ndoc) Then 
        tbl.Delete()
        Return
      Endif
      com.Text = tbl.commentaire
      If $etat = Achat.EnCommande Then 
        ncom.Text = tbl.ndoc
      Else 
        nbl.Text = tbl.ndoc
      Endif
      If $etat = Achat.Reception Then
        BlqSai(False)
        If $opt = "P" Or $opt = "N" Then
          dte.Enabled = True
        Endif
      Endif
      $win.Enabled = False
      tardt.Visible = False
      Me.Raise
    Endif
  Endif

End

'**************radio buttons*****************************
Public Sub commande_click()

  If Not IsNull(tbl) Then 
    If tbl.ligne.Count > 0 Then
      Stop Event
      Return
    Endif
  Endif
  $req = "SELECT four, numcom as numrecpt, ddate, montant, montantttc AS mttc,anomalie,commentaire,fo_nom FROM Fiches_Entcom JOIN Fiches_Four on four=fo_code"
  $etat = Achat.EnCommande
  Last.Tag = $etat
  $rd = Last
  Update_Req

End

Public Sub reception_click()

  If Not IsNull(tbl) Then 
    If tbl.ligne.Count > 0
      Stop Event
      Return
    Endif
  Endif
  $req = "SELECT  four,numrecpt, ddate, montant, mttc,anomalie,commentaire,fo_nom FROM Fiches_Entrecpt JOIN Fiches_Four on four=fo_code"
  $etat = Achat.Reception
  Last.Tag = $etat
  $rd = Last
  Update_Req
  tr.ExtraSel("validee= '0' ", "AND")

End

Public Sub Valide_click()

  If Not IsNull(tbl) Then 
    If tbl.ligne.Count > 0
      Stop Event
      Return
    Endif
  Endif
  $req = "SELECT four, numrecpt, ddate,montant, mttc,anomalie,commentaire,fo_nom FROM Fiches_Entrecpt JOIN Fiches_Four on four=fo_code "
  $etat = Achat.Validee
  Last.Tag = $etat
  $rd = Last
  Update_Req
  tr.ExtraSel("(validee= '1' or validee = '2') ", "AND")

End

Private Sub FourMan(four As String)      ''Récupere les info sur le fournisseur sélectionné
  
  Dim res As Result
  
  res = Utils.db.Exec("SELECT * FROM Fiches_Four WHERE fo_code = &1", four)
  If res.Available Then
    fcode.Text = four
    fo_nom.Text = res!fo_nom
    $Apdf = res!fo_copie
    generer.Visible = True
  Else
    Message.Warning("Fournisseur inconnu", "Ok")
    fo_nom.Text = ""
    fcode.SetFocus
    generer.Visible = False
  Endif
  If Not IsNull(tbl) Then tbl.fourisseur = four
  
End

'***********Gestion des boutons

Public Sub creation_Click()
  
  If Not IsNull(tbl) Then
    If tbl.ligne.Count > 0 Then
      Message.Info("Vous avez une saisie en cours, création impossible")
      Return
    Endif
  Endif
  
  tardt.Visible = False
  tbl.fourisseur = fcode.Text
  tbl.date = dte.dte
  tbl.ndoc = nbl.Text
  tbl.commentaire = com.Text
  tbl.ajout
  $etat = Achat.CreaCommande
  Panel3.Raise
  ChangVal($etat)

End

Public Sub imprime_Click()

  Dim rep As Report
  Dim prt As New Printer
 
  rep = tbl.imprime()
  If IsNull(rep) Then Return
  prt.OutputFile = User.Home & "/tmp/BonReception.pdf"
  rep.Print(prt)
  Visualiseur.Prog(prt.OutputFile)
  If $etat = Achat.Reception And $Apdf Then ged()

End

Public Sub mail_Click()

  If tbl.ligne.Count < 1 Or $etat = Achat.CreaCommande Then Return
  tbl.mail
  
End

Public Sub generer_Click()
  
  If tbl.ligne.Count < 1 Then 
    creation_Click() 
  Else If $etat = Achat.EnCommande Or $etat = Achat.CreaCommande Then
    If tbl.ligne[tbl.ligne.Max].MonControle["Code"].text Then tbl.ajout()
    tbl.generer(fcode.Text)
  Endif

End

Public Sub suppr_Click()

  Dim lg As Sailig
  
  If tbl.ligne.Count < 1 Or $etat = Achat.CreaCommande Then Return
  Utils.db.Begin
  For Each lg In tbl
    lg.AutresObj[Achat.Tarif].SupTarTemp()
  Next
  If tbl.SupAchat($etat, $Bval, True) Then 
    Utils.db.Rollback
    Return
  Endif
  Utils.db.Commit
  annul_Click()
  
End

Public Sub annul_Click()

  Dim lg As Sailig
  
  If $validBR Then 
    Me.Close
    Return
  Endif
  If tbl.ligne.Count < 1 Then Return
  'on supprime tous les tarifs
  Application.Busy = 1
  generer.Visible = False
  For Each lg In tbl
    lg.AutresObj[Achat.Tarif].Delete
    If $opt <> "N" Then lg.AutresObj[Achat.Frais].Close
  Next
  'on supprime les lignes saisies + mise à blanc
  tbl.Delete
  BlqSai(True)
  fcode.Clear
  fo_nom.Text = ""
  dte.dte.G = Now
  ncom.Clear
  nbl.Clear
  com.Clear
  totaht.Clear
  totht.Clear
  totttc.Clear
  Qtes.Clear
  totfrais.Clear
  stmini.Text = ""
  stmax.Text = ""
  comin.Text = ""
  stk.Text = ""
  qtecom.Text = ""
  Encom.Text = ""
  Etarif.Background = Color.ButtonBackground
  tardt.Visible = True
  If $etat <> Achat.CreaCommande Then DocActif.free_lock("Achat", $numlock)
  $win.Enabled = True
  If $etat = Achat.CreaCommande Then $etat = $rd.Tag
  tr.Update
  ChangVal(Achat.Sans)
  Wait 0.001
  Application.Busy = 0
  
End

Public Sub ValideS_Click()
  
  Application.Busy = 1
  If ValCom() Then 
    Application.Busy = 0
    Return
  Endif
  annul_Click()
  
End

Private Sub ValCom() As Boolean
  
  Dim nco As String
  Dim rep As Report
  Dim prt As Printer
  Dim lg As Sailig
  Dim res As Result
  
  If $etat = Achat.Validee Then Return True
  Application.Busy = 1
  If VerSai($etat) Then Return True
  If $etat = Achat.EnCommande Or $etat = Achat.CreaCommande Then nco = ncom.Text Else nco = nbl.Text
  Utils.db.Begin
  If tbl.ContMat() And $etat = Achat.Reception Then
    If Not tbl.CreMat() Then Return True
  Endif

  If $etat = Achat.Reception Then     'si c'est la derniere entrée on maj l'article
    For Each lg In tbl
      res = Utils.db.Exec("SELECT * FROM Fiches_Ligrecpt WHERE code = &1 AND daterecpt > &2", lg.MonControle["Code"].Text, dte.dte.D)
      If Not res.Available Then 
        lg.AutresObj[Achat.Tarif].EnrTarArt(lg)
      Endif
    Next
  Endif
  If $etat <> Achat.CreaCommande And If tbl.SupAchat($etat, $Bval, True, False) Then Return True
  If tbl.EnrAch($etat, dte.dte, nco, fcode.Text) Then Return True
  Utils.db.Commit
  
  rep = tbl.imprime(False)
  If IsNull(rep) Then Return False
  prt = New Printer
  prt.OutputFile = User.Home & "/tmp/BonReception.pdf"
  rep.Print(prt)
  If $Apdf Then ged()
  Return False
  
End

Private Sub ged()
  
  Dim lg As LGed
  Dim ret As Integer
  Dim tags As String[]
  Dim rResult As Result
  Dim origin, br As String
  
  'On conserve une copie du documents pour le fournisseur
  If $etat = Achat.CreaCommande Or $etat = Achat.EnCommande Then
    origin = "Commande"
    br = ncom.Text
  Else
    origin = "BR"
    br = nbl.Text
  Endif
  
  lg = LGed.Search(LGed.Fournisseurs, br, fcode.Text, origin)
  If IsNull(lg)
    lg = New LGed(Null, 0, LGed.Fournisseurs, origin, br, fcode.Text)
  Endif
  lg.DTE = dte.dte
  lg.TTC = LPrix(tbl.TotTtc)
  lg.HT = LPrix(tbl.TotHt)
  'On copie sur le disque le document autand de fois qu'il est produit (grace à la date), mais on conserve le dernier pointeur dans la table GED.
  ret = lg.PDFDupli(User.Home & "/tmp/BonReception.pdf", origin & br & "_" & dte.dte.F & "_" & fcode.Text & "-" & LDate(Now).FT & ".pdf")
  If ret = 1 Then
    lg.Supprime(False)
    Return
  Else
    'On ajoute les tags et les liens avec le document apres commit dans Doc_Ged
    lg.DelAllTag(False)
    lg.AddTag(origin & br)
    lg.AddTag(fcode.Text)
    rResult = Utils.db.Exec("SELECT tag_def FROM " & Cbase.Table("TabFour") & " WHERE fo_code = " & fcode.Text)
    If rResult.Available Then
      tags = LGed.String2Array(rResult!tag_def).Copy()
      lg.AddTags(tags)
    Endif
  Endif

End


Public Sub rececp_Click()

  Dim dt As VerifDate
  Dim lg As Sailig
  Dim win As Window
  Dim but As Button
  Dim vignette As TextReg
  Dim lab As Label
  Dim pan As Panel
  Dim vgn As String
  Dim dra As Boolean
  Dim sort As Integer
  Dim res As Result
  Dim rep As Report
  Dim prt As New Printer
  Dim vecr As VarEcr
  Dim dtv As LDate
  
  Select Case Last.Tag
    Case Achat.Sans
      ValidBR1.Showmodal
      
    Case Achat.Reception
      win = New Window
      win.Height = win.Font.Height * 4
      win.Width = win.Font.Size * 50
      win.Arrangement = Arrange.Vertical
      win.Border = False
      pan = New Panel(win)
      pan.Arrangement = Arrange.Horizontal
      pan.Expand = True
      lab = New Label(pan)
      lab.Text = "Date de l'écriture : "
      lab.Expand = True
      lab.Alignment = Align.Center
      vignette = New TextReg(pan)
      vignette.Type = TextReg.EstDate
      vignette.Expand = True
      pan = New Panel(win) 
      pan.Arrangement = Arrange.Horizontal
      pan.Expand = True
      but = New Button(pan) As "Bavec"
      but.Expand = True
      but.Picture = Picture["Icones/ecritures.png"]
      but.Tag = win
      but.Text = "Avec écriture\ncomptable"
      but = New Button(pan) As "Bsans"
      but.Picture = Picture["Icones/button_ok.png"]
      but.Expand = True
      but.Tag = win
      but.Text = "Sans écriture\ncomptable"
      but = New Button(pan) As "Ecraban"
      but.Expand = True
      but.Tag = win
      but.Picture = Picture["Icones/exit.png"]
      but.Text = "Abandon"
      vignette.SetFocus
      sort = win.Showmodal()
      dtv = New LDate(vignette.dte.G)
      
      If sort = 3 Then Return
      If ValCom() Then Return
      ValidBR1.Ecritures(dtv, dte.dte, nbl.Text, fcode.Text, sort, tbl.TotHt, tbl.TotTtc)
      annul_Click()
      
    Case Achat.CreaCommande, Achat.EnCommande
      If VerSai(Achat.Reception) Then Return
      tbl.fourisseur = fcode.Text
      tbl.ndoc = nbl.Text
      tbl.date = dte.dte
      tbl.commentaire = com.Text
      
      res = Utils.db.Exec("SELECT * FROM Fiches_Entrecpt WHERE four=&1 AND numrecpt = &2", fcode.Text, nbl.Text)
      If res.Available Then
        Message.Warning("Réception impossible ce numéro de BL est déjà attribué", "Ok")
        Return
      Endif
      
      dt = New VerifDate(dte.dte.G)
      If dt.DateCom.Apres(dte.dte) Then
        If Message.Warning("La date du mouvement est inférieur à celle de l'exercice\nContinuer pourrait provoquer des erreurs de stock", "Abandon", "Continuer") = 1 Then Return
      Endif
      
      If tbl.CreRec() = 0 Then Return
      
      If $opt = "B" Or $opt = "T" Then
        For Each lg In tbl
          If lg.AutresObj[Achat.FicheArt]["art_dra"] Then
            dra = True
            If lg.AutresObj[Achat.Consignes].ccd.suspendu Then vgn = True
            If dt.ClotDroi(Null, lg.AutresObj[Achat.FicheArt]["art_dra"]) Then Return
          Endif
        Next
        If vgn Then
          win = New Window
          win.Height = win.Font.Height * 6
          win.Width = win.Font.Size * 50
          win.Arrangement = Arrange.Vertical
          lab = New Label(win)
          lab.Text = "N° de vignette "
          lab.Alignment = Align.Center
          lab.Expand = True
          vignette = New TextReg(win) As "Nvign"
          vignette.Expand = True
          vignette.Type = TextReg.EstNum
          vignette.nbdec = "0"
          vignette.MaxLength = 25
          Utils.db.Exec("LOCK TABLES Fiches_Parametres WRITE")
          res = Utils.db.Exec("Select nvign From Fiches_Parametres")
          vignette.Text = Format(Val(res!nvign) + 1, "0000000000000000000000000")
          vignette.Enabled = False
          pan = New Panel(win)
          pan.Expand = True
          pan.Arrangement = Arrange.Horizontal
          but = New Button(pan) As "Babandon"
          but.Text = "Abandon"
          but.Picture = Picture["Icones/exit.png"]
          but.Expand = True
          but.Tag = win
          but = New Button(pan) As "Bvalide"
          but.Text = "Valider"
          but.Picture = Picture["Icones/button_ok.png"]
          but.Tag = win
          but.Expand = True
          sort = win.Showmodal()
          
          If sort = 0 Then 
            Utils.db.Exec("UNLOCK TABLES")
            Return
          Endif
          vgn = vignette.Text
          Utils.db.Exec("UPDATE Fiches_Parametres SET nvign= &1", Format(vignette.Value, "0000000000000000000000000"))
          Utils.db.Exec("UNLOCK TABLES")
        Endif
      Endif
      
      Utils.db.Begin
      If tbl.ContMat() Then
        If Not tbl.CreMat() Then Return
      Endif
      If $etat = Achat.EnCommande Or ($etat = Achat.Reception And Not dra) Then
        'on supprime l'ancienne commande de la BD
        If tbl.SupAchat($etat, $Bval) Then Return
      Endif
      'on enregistre la nouvelle
      For Each lg In tbl
        lg.AutresObj[Achat.Tarif].EnrTarArt(lg)
        lg.AutresObj[Achat.Tarif].EnrArt(fcode.Text, dte.dte)
        lg.AutresObj[Achat.Tarif].EnrEtiqu(lg)
      Next
      tbl.EnrAch(Achat.Reception, dte.dte, nbl.Text, fcode.Text, vgn)
      'on enregistre le pdf de réception
      rep = tbl.imprime(False)
      If IsNull(rep) Then Return
      prt.OutputFile = User.Home & "/tmp/BonReception.pdf"
      rep.Print(prt)
      If $Apdf Then ged()
      annul_Click()
      If tbl.CreReliquat() Then
        $etat = Achat.CreaCommande
        ChangVal($etat)
      Endif
  End Select
  
End

Public Sub Etarif_Click()       ''on enregistre tous les tarifs de la commande

  Dim lg As Sailig
  
  If Not IsNull(tbl) And If tbl.ligne.Count > 0 Then
    Utils.db.Begin
    For Each lg In tbl
      lg.AutresObj[Achat.Tarif].EnrTar(lg, tbl.fourisseur)
    Next
    Utils.db.Commit
  Endif
  Etarif.Background = Color.ButtonBackground
  
End

Public Sub tardt_Click()

  Dim td As DateTar
  
  td = New DateTar(Null, fcode.Text)
  td.Showmodal

End

Public Sub Import_Click()

  If $etat = Achat.CreaCommande Or $etat = Achat.EnCommande Or $etat = Achat.Sans Or tbl.ligne.Count < 1 Then tbl.Import()
  
End

Public Sub Tarif_EnrTar()

  Dim lg As Sailig
  
  lg = tbl.ligne[tbl.ind]
  Utils.db.Begin
  lg.AutresObj[Achat.Tarif].EnrTar(lg, tbl.fourisseur)
  Utils.db.Commit

End

Public Sub Tarif_CoulBout()

  Etarif.Background = Color.Red

End

Private Function VerSai(etat As Integer) As Boolean      ''on verifie la saisie avant validation
  
  Dim res As Result
  
  If tbl.ligne.Count < 1 Then Return True
  tbl.Netoyage("Code")
  If tbl.ligne.Count < 1 Then Return True
  If Not fcode.Text Then
    Message.Warning("Vous devez renseigner le fournisseur", "Ok")
    fcode.SetFocus
    Application.Busy = 0
    Return True
  Endif
  If Not nbl.Text And etat = Achat.Reception Then
    res = Utils.db.LockIncrement("dnbr", "Fiches_Parametres")
    nbl.Text = res!dnbr
    tbl.ndoc = res!dnbr
  Endif
  If Not dte.Text Then
    Message.Warning("Vous devez renseigner la date", "Ok")
    dte.SetFocus
    Application.Busy = 0
    Return True
  Endif
  
  If $etat = Achat.CreaCommande Then
    If Not ncom.Text Then
      res = Utils.db.LockIncrement("dncom", "Fiches_Parametres")
      ncom.Text = res!dncom
    Endif
    res = Utils.db.Exec("SELECT * FROM Fiches_Entcom WHERE numcom = &1", ncom.Text)
    If res.Available Then
      Message.Warning("Création impossible ce numéro de commande est déjà attribué", "Ok")
      ncom.SetFocus
      ncom.Text = ""
      Application.Busy = 0
      Return True
    Endif
  Endif
  If $etat = Achat.EnCommande And Not ncom.Text Then
    Message.Warning("Vous devez renseigner le numéro de commande ", "Ok")
    ncom.SetFocus
    Application.Busy = 0
    Return True
  Endif
  
  Return tbl.Doublon()
End

Private Sub BlqSai(Value As Boolean)
  
  fcode.Enabled = value
  RecFo.Enabled = value
  dte.Enabled = value
  ncom.Enabled = value
  nbl.Enabled = value
  
End

Private Sub ChangVal(etat As Integer)
  
  Select Case etat
    
    Case Achat.CreaCommande, Achat.EnCommande
      rececp.Enabled = True
      rececp.Text = "Réception"
      rececp.Picture = Picture["Icones/next.png"]
      
    Case Achat.Reception
      rececp.Enabled = True
      rececp.Text = "Valider les factures"
      rececp.Picture = Picture["Icones/button_ok.png"]
      
    Case Achat.Validee
      rececp.Enabled = False
    
    Case Achat.Sans
      rececp.Enabled = True
      rececp.Text = "Valider les réceptions"
      rececp.Picture = Picture["Icones/button_ok.png"]
      
  End Select
  rececp.Tag = etat
  
End

