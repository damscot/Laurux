+Public Sub Run_Tests()
+  ''Relaie l'option -T vers gb.test et quitte avec le code global (0 = aucun échec).
+  ''Chaque test (méthode publique d'un module .src/Tests/<lot>/*.test) est lancé dans son propre processus
+  ''« gbx3 -T Module.Méthode », comme le runner de non-régression : un résultat ne dépend ni de l'ordre des
+  ''tests ni de l'état statique laissé par un autre test. Les modules doivent être compilés (gbc3 -ag).
+  ''Arg_Test : all, list, Module, Module.Méthode, ou une liste séparée par des virgules.
+
+  Dim sRacine As String = Application.Path &/ ".src/Tests"
+  Dim aTests As New String[]
+  Dim aSel As New String[]
+  Dim sLot, sFic, sLigne, sTest, sDemande, sModule As String
+  Dim iEchecs As Integer
+
+  If Not Exist(sRacine) Then
+    Print "Tests indisponibles : répertoire source " & sRacine & " introuvable"
+    Quit 2
+  Endif
+  For Each sLot In Dir(sRacine, "*", gb.Directory).Sort()
+    For Each sFic In Dir(sRacine &/ sLot, "*.test").Sort()
+      sModule = File.BaseName(sFic)
+      For Each sLigne In Split(File.Load(sRacine &/ sLot &/ sFic), "\n")
+        sLigne = Trim(sLigne)
+        If Left(sLigne, 11) = "Public Sub " And If InStr(sLigne, "(") > 12 Then
+          sTest = Trim(Mid(sLigne, 12, InStr(sLigne, "(") - 12))
+          If Left(sTest, 1) <> "_" Then aTests.Add(sModule & "." & sTest)
+        Endif
+      Next
+    Next
   Next
