' Gambas test file

''Tests de Cfacture (.hidden/reference/.src/Caisse/Reports/Cfacture.class/test.md, CFACTURE-T01, T05, T07).
''Le PDF est écrit dans un fichier temporaire et son texte extrait par « pdftotext -layout » (une clé par ligne non
''vide) ; le pied de page de BasPage est réduit à « Page n/m » (date, heure et utilisateur variables).
''T02 à T04 et T06 restent à faire : Level1, Level2T, Com, Level2F, Level4 lisent Caisse.Ba4 (auto-instance de
''l'écran Caisse, classe complexe exclue). Valeurs attendues : assets/CfactureTest/expected.txt. Pas de base.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Formats", "_new : une ligne Entete par format (a3, 80mm, a4, a5, letter, legal, dymoc)")
  TestKit.Desc("T05Livre", "Livre de caisse : Level3, Level2E, Level2, Lines2, BasPage sur 2 pages")
  TestKit.Desc("T07Logo2", "Logo2 : logo désactivé, puis activé avec un fichier absent")

End

Public Sub _Setup()

  TestKit.Begin("Caisse", "CfactureTest")

End

Private Function Nouveau(sCle As String, sFormat As String) As Cfacture

  Dim pdf As Cfacture

  Try pdf = New Cfacture("P", "mm", sFormat)
  If Error Then
    TestKit.Check(sCle & "/new", "ERREUR: " & Error.Text)
    Return Null
  Endif
  pdf.Open()
  pdf.AliasNbPages()
  Return pdf

End

Private Sub Verifie(sCle As String, pdf As Cfacture)

  Dim sFic As String = Temp$("cfac") & ".pdf"
  Dim sTxt As String
  Dim sLig As String
  Dim n As Integer

  Try pdf.Output(sFic, False)
  If Error Then
    TestKit.Check(sCle & "/output", "ERREUR: " & Error.Text)
    Return
  Endif
  Shell "pdftotext -layout " & Shell$(sFic) & " -" To sTxt
  sTxt = Replace(sTxt, "\f", "<saut de page>\n")
  For Each sLig In Split(sTxt, "\n")
    sLig = RTrim(sLig)
    If sLig = "" Then Continue
    If InStr(sLig, "Impression demandée par") > 0 Then sLig = Trim(Left(sLig, InStr(sLig, " - ") - 1)) & " - <date> - <utilisateur>"
    Inc n
    TestKit.Check(sCle & "/l" & Format$(n, "00"), sLig)
  Next
  TestKit.Check(sCle & "/lignes", n)

End

Public Sub T01Formats()

  Dim sFmt As String
  Dim pdf As Cfacture

  For Each sFmt In ["a3", "80mm", "a4", "a5", "letter", "legal", "dymoc"]
    pdf = Nouveau("T01/" & sFmt, sFmt)
    If Not pdf Then Continue
    Try pdf.AddPage()
    Try pdf.Entete("Format " & sFmt, "10", "10", "B", False)
    If Error Then TestKit.Check("T01/" & sFmt & "/entete", "ERREUR: " & Error.Text)
    Verifie("T01/" & sFmt, pdf)
  Next

End

Public Sub T05Livre()

  Dim pdf As Cfacture = Nouveau("T05", "a4")
  Dim i As Integer
  Dim y As Integer

  pdf.AddPage()
  pdf.Level3("Livre de caisse du 15/06/2018", "10", True)
  pdf.Level2E(25)
  y = 32
  For i = 1 To 3
    pdf.Level2("Article " & i, Format$(i * 1.5, "0.00"), CStr(i), y)
    y += 5
  Next
  pdf.Lines2(y)
  pdf.BasPage()
  pdf.AddPage()
  pdf.Level3("Suite", "10", False)
  pdf.Level2("Total", "9,00", "6", 25)
  pdf.BasPage()
  Verifie("T05", pdf)

End

Public Sub T07Logo2()

  Dim pdf As Cfacture

  Start.LocalSettings["/Soc" & Start.Societe & "/caisse/logo"] = False
  pdf = Nouveau("T07/sans", "a4")
  pdf.AddPage()
  Try pdf.Logo2("fac", True)
  TestKit.Check("T07/sans/erreur", IIf(Error, Error.Text, ""))
  Verifie("T07/sans", pdf)

  Start.LocalSettings["/Soc" & Start.Societe & "/caisse/logo"] = True
  Start.LocalSettings["/Soc" & Start.Societe & "/caisse/ilogo"] = "/tmp/laurux-test/logo-absent.png"
  pdf = Nouveau("T07/absent", "a4")
  pdf.AddPage()
  Try pdf.Logo2("fac", True)
  TestKit.Check("T07/absent/erreur", IIf(Error, Error.Text, ""))

End
