' Gambas test file

''Tests de Prodcomposes ouvrant TriArticles en ShowModal (.hidden/reference/.src/Gestion/Tables/Prodcomposes.class/test.md,
''PRODCOMPOSES-T03). Module séparé (vague 8, modèle MaterielModalTest) : un Timer du module retrouve la fenêtre
''TriArticles ouverte et simule la sélection (Bsel = True puis ColTri_MajSel(code)). Écran affiché (Show) pour que la
''grille Colartprdc reçoive ses événements Data ; Entrée et clics remplacés par l'appel direct des gestionnaires.
''Jeu prodcomposes_shared/prodcomposes_pc. Valeurs attendues : assets/ProdcomposesModalTest/expected.txt (clone de référence).

Private $hTimer As Timer
Private $sChoix As String

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T03AjoutMoModif", "PC1 : radio MO, MO 01 choisie par TriArticles (Button6), quantité 1, Ajouter MO ; clic sur la ligne A1, quantité 3, Ajouter : Fiches_PrdComp et prix")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "ProdcomposesModalTest")
  TestKit.OuvreBase("prodcomposes_shared/prodcomposes_pc")
  Start.LocalSettings["/Coul/Znaff"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Focus"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Znss"] = "background: 16777215;"

End

Private Sub Programme(sChoix As String)

  $sChoix = sChoix
  $hTimer = New Timer As "_Choix"
  $hTimer.Delay = 500
  $hTimer.Enabled = True

End

Public Sub _Choix_Timer()

  Dim hWin As Window

  For Each hWin In Windows
    If Object.Type(hWin) <> "TriArticles" Then Continue
    $hTimer.Enabled = False
    If $sChoix Then
      Object.SetProperty(hWin, "Bsel", True)
      Object.Call(hWin, "ColTri_MajSel", [$sChoix])
    Else
      hWin.Close()
    Endif
    Return
  Next

End

Private Sub Etat(hF As Object, sCle As String)

  Dim sNom, sTxt As String
  Dim rResult As Result
  Dim hGrid As Object = hF.Controls["Colartprdc"]
  Dim i, j As Integer

  For Each sNom In ["Code", "CArt", "Desg2", "Qte", "PmpA", "Pmp", "Marge", "Button3"]
    TestKit.Check(sCle & "/" & sNom, Object.GetProperty(hF.Controls[sNom], "Text"))
  Next
  rResult = Utils.db.Exec("SELECT codec, libelle, qte, mo FROM Fiches_PrdComp WHERE codep = 'PC1' ORDER BY codec")
  If rResult.Available Then
    Repeat
      TestKit.Check(sCle & "/prdcomp_" & rResult!codec, rResult!libelle & "|" & rResult!qte & "|" & CStr(rResult!mo))
    Until rResult.MoveNext()
  Endif
  For i = 0 To hGrid.Rows.Count - 1
    sTxt = ""
    For j = 0 To 3
      sTxt &= hGrid[i, j].Text & "|"
    Next
    TestKit.Check(sCle & "/grille_" & i, sTxt)
  Next

End

Public Sub T03AjoutMoModif()

  Dim hF As New Prodcomposes
  Dim hGrid As Object = hF.Controls["Colartprdc"]
  Dim i As Integer

  hF.Show()
  Object.SetProperty(hF.Controls["Code"], "Text", "PC1")
  hF.Cprdcomp()
  Wait 0.2
  Object.SetProperty(hF.Controls["rmo"], "Value", True)
  Programme("01")
  Try hF.Button6_Click()
  TestKit.Check("T03/mo/selection_erreur", IIf(Error, Error.Text, "<aucune>"))
  TestKit.Check("T03/mo/Bsel", hF.Bsel)
  Try hF.Button3_Click()
  TestKit.Check("T03/mo/ajout_erreur", IIf(Error, Error.Text & " " & Error.Where, "<aucune>"))
  Wait 0.2
  Etat(hF, "T03/mo")
  For i = 0 To hGrid.Rows.Count - 1
    If hGrid[i, 0].Text = "A1" Then hGrid.Row = i
  Next
  TestKit.Check("T03/modif/ligne", hGrid.Row)
  Try hF.Colartprdc_Click()
  TestKit.Check("T03/modif/clic_erreur", IIf(Error, Error.Text, "<aucune>"))
  TestKit.Check("T03/modif/Qte_lue", Object.GetProperty(hF.Controls["Qte"], "Text"))
  Object.SetProperty(hF.Controls["Qte"], "Text", "3")
  Try hF.Button3_Click()
  TestKit.Check("T03/modif/ajout_erreur", IIf(Error, Error.Text & " " & Error.Where, "<aucune>"))
  Wait 0.2
  Etat(hF, "T03/modif")
  hF.Close()

End
