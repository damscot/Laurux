  lab.font = Font["Serif,Blod,9"]
  lab.Text = "Intitulé"
  lab.Alignment = Align.Center
  lab.Border = ReportBorder["Right:1pt #000000"]
  lab.Expand = True
  lab = New ReportLabel(conth)
  lab.font = Font["Serif,Blod,9"]
  lab.Text = "Quantité"
  lab.Alignment = Align.Center
  lab.Width = "15mm"
  If chiffre Then
    lab.Border = ReportBorder["Right:1pt #000000"]
