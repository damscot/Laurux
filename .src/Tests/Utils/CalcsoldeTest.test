' Gambas test file

''Tests de Calcsolde.Calcul (.hidden/reference/.src/Utils/Calcsolde.class/test.md, CALCSOLDE-T01 à T05, T07).
''Valeurs attendues : assets/CalcsoldeTest/expected.txt, produites dans le clone de référence.
''Jeu de données : .hidden/Tests/Utils/assets/calcsolde_shared/calcsolde.sql. Calcul est appelé sur l'instance automatique du formulaire
''(jamais affiché) ; journal de report à nouveau : jdr de Fiches_Parametres (« 90 »).

Private $hTimer As Timer
Private $sVu As String

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01CompteGeneral", "`Calcul` compte général")
  TestKit.Desc("T02Tresorerie", "`Calcul` trésorerie")
  TestKit.Desc("T03SansEcriture", "Compte sans écriture validée")
  TestKit.Desc("T04AppelPointage", "Appel style `Pointage`")
  TestKit.Desc("T05Arrondi", "Arrondi")
  TestKit.Desc("T07PointageSuppression", "Pointage : suppression du relevé 2 (« Oui » par Timer), Calcul(512000, True) : solde recalculé")

End

Public Sub _Setup()

  TestKit.Begin("Utils", "CalcsoldeTest")
  TestKit.OuvreBase("calcsolde_shared/calcsolde")

End

Private Sub Compte(sCpt As String) As String

  Dim r As Result

  r = Utils.db.Exec("SELECT solde, soldep FROM Fiches_Comptes WHERE compte_cc = &1", sCpt)
  If Not r.Available Then Return "<absent>"
  Return "solde=" & TestKit.Canonique(r!solde) & " soldep=" & TestKit.Canonique(r!soldep)

End

Private Sub Calc(sCle As String, sCpt As String, bTreso As Boolean, Optional sJan As String)

  Try Calcsolde.Calcul(sCpt, bTreso, sJan)
  If Error Then TestKit.Check(sCle & "/erreur", "ERREUR: " & Error.Text)
  TestKit.Check(sCle, Compte(sCpt))

End

Public Sub T01CompteGeneral()

  TestKit.Check("T01/initial", Compte("607000"))
  Calc("T01/treso_faux", "607000", False, "90")
  Calc("T01/treso_vrai", "607000", True, "90")

End

Public Sub T02Tresorerie()

  TestKit.Check("T02/initial", Compte("512000"))
  Calc("T02/512000", "512000", True, "90")
  Calc("T02/512000/autre_journal", "512000", True, "10")

End

Public Sub T03SansEcriture()

  TestKit.Check("T03/initial", Compte("512001"))
  Calc("T03/512001", "512001", True, "90")
  Calc("T03/inexistant", "999999", True, "90")
  Calc("T03/vide", "", True, "90")

End

Public Sub T04AppelPointage()

  ' Appel de Pointage.class : Calcul(cpt, True) sans jan (CALCSOLDE-A01 : soldep non recalculé)
  Calc("T04/512000", "512000", True)

End

Public Sub T05Arrondi()

  Calc("T05/411001", "411001", True, "90")
  TestKit.Check("T05/LPrix/D", LPrix(-0.005).D & " " & LPrix(2.675).D & " " & LPrix(-15.104).D)

End

Public Sub _Rep_Timer()
  ''Pendant la boîte Message.Question de Pointage.SuppressionRlv_Click : relève son texte et clique « Oui ».

  Dim hW As Window
  Dim hC As Object

  For Each hW In Windows
    If Object.Type(hW) = "FMessage" Then
      $hTimer.Enabled = False
      For Each hC In hW.Controls
        If Object.Type(hC) = "Label" Or Object.Type(hC) = "TextLabel" Then $sVu &= Object.GetProperty(hC, "Text") & " / "
      Next
      For Each hC In hW.Controls
        If Object.Type(hC) = "Button" Then
          If Replace(Object.GetProperty(hC, "Text"), "&", "") = "Oui" Then
            hC.Value = True
            Return
          Endif
        Endif
      Next
    Endif
  Next

End

Private Sub Mvt512(sCle As String)
  ''Écritures du compte 512000 : pointage et n° de relevé.

  Dim r As Result
  Dim i As Integer

  r = Utils.db.Exec("SELECT * FROM " & Cbase.Table("TabMvt") & " WHERE compte = &1 ORDER BY lind", "512000")
  TestKit.Check(sCle & "_nb", r.Count)
  If Not r.Available Then Return
  Repeat
    TestKit.Check(sCle & i, r!numero & "|" & r!montantd & "|" & r!montantc & "|" & r!pointee & "|" & r!nrlv)
    Inc i
  Until r.MoveNext()

End

Public Sub T07PointageSuppression()
  ''CALCSOLDE-T07 : chemin de Pointage, suppression d'un relevé (jeu Compta/pointage_shared/pointage_rappro, en
  ''lecture seule) : écran Pointage instancié sans affichage, compte 512000 et relevé 2 posés, SuppressionRlv_Click,
  ''« Oui » au Message.Question par un Timer du module ; relevé supprimé, Fiches_Mvt dépointé, puis
  ''Calcsolde.Calcul(Cpt, True) sans jan : solde recalculé, soldep inchangé (CALCSOLDE-A01).

  Dim hF As Pointage
  Dim r As Result

  TestKit.OuvreBase("Compta/pointage_shared/pointage_rappro")
  TestKit.Check("T07/compte_avant", Compte("512000"))
  Mvt512("T07/mvt_avant")
  Try hF = New Pointage
  If Error Then
    TestKit.Check("T07/new", "ERREUR: " & Error.Text)
    Return
  Endif
  Object.SetProperty(hF.Controls["Cpt"], "Text", "512000")
  Object.SetProperty(hF.Controls["Nrel"], "Text", "2")
  $sVu = ""
  $hTimer = New Timer As "_Rep"
  $hTimer.Delay = 300
  $hTimer.Enabled = True
  Try hF.SuppressionRlv_Click()
  If Error Then TestKit.Check("T07/suppr_err", "ERREUR: " & Error.Text)
  $hTimer.Enabled = False
  TestKit.Check("T07/message", $sVu)
  r = Utils.db.Exec("SELECT count(*) AS nb FROM " & Cbase.Table("TabRappro") & " WHERE cpt = &1 AND nreleve = &2", "512000", "2")
  TestKit.Check("T07/releve_nb", r!nb)
  Mvt512("T07/mvt_apres")
  TestKit.Check("T07/compte_apres", Compte("512000"))
  Object.Lock(hF)

End
