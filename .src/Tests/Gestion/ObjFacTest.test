Private Sub TableBl(aBl As String[])

  Dim sBl As String
  Dim aPart As String[]

  Utils.db.Exec("DROP TABLE IF EXISTS Bl")
  Utils.db.Exec("CREATE TABLE Bl (num Char(12) NOT NULL, code Char(10), nom Char(35), date date)" & Utils.db.Engine())
  For Each sBl In aBl
    aPart = Split(sBl, ":")
    Utils.db.Exec("INSERT INTO Bl (num, code, nom, date) VALUES (&1, &2, &3, '2018-06-15')", aPart[0], aPart[1], aPart[2])
  Next

End

Private Sub FinMois(sCle As String, sCli As String, Optional sNom As String)

  Dim hObj As ObjFac

  hObj = New ObjFac("", ObjFac.finmois, Dte())
  hObj.numcli = sCli
  Try hObj.calcul(sNom)
  TestKit.Check(sCle & "/erreur", IIf(Error, "ERREUR: " & Error.Text & " " & Error.Where, "<aucune>"))
  TestKit.Check(sCle & "/doc", "dteech=" & IIf(Object.IsValid(hObj.dteech), hObj.dteech.L, "") & " tsaisreg=" & hObj.tsaisreg)
  Totaux(sCle, hObj)

End

