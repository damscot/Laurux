' Gambas test file

''Tests de Caleditcmat (.hidden/reference/.src/Gestion/option/Caleditcmat.class/test.md).
''Valeurs attendues : assets/CaleditcmatTest/expected.txt, produites dans le clone de référence.
''Écran instancié sans affichage (New Caleditcmat) ; contrôles posés par Controls[...] puis gestionnaires appelés
''directement (Control_Click, Edition_Click, Redition_Click, detail_Click). Message.Question de la clôture : réponse
''par un Timer du module (technique TresorTest). Visualiseur.Prog neutralisé (/Soc01/caisse/CmdVis = true) ; le PDF
''produit (~/tmp/cmtmat.pdf) est lu par pdftotext. État de Fiches_ligregie relevé par requête.
''Jeu caleditcmat_shared/cmat_base (régies 01 et 03 suspendues, 02 et 04 acquittées ; inventaire 2018-01-01 ; stock
''de début de juin 2018 ; mouvements E/S/C de juin non clôturés).

Private $hTimer As Timer
Private $sBouton As String
Private $sVu As String

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01ControleOk", "Juin 2018, suspendu puis acquitté → Control : Textcontrol, aucune écriture")
  TestKit.Desc("T02ControleAnomalies", "BL non facturés du mois et du mois précédent, article à régie inexistante, facture archivée sans ligne de régie → Control : Textcontrol")
  TestKit.Desc("T03ProvisoireSuspendu", "Juin 2018, suspendu, édition provisoire : texte PDF, Fiches_ligregie inchangée")
  TestKit.Desc("T04ProvisoireAcquitte", "Juin 2018, acquitté, édition provisoire : texte PDF, Fiches_ligregie inchangée")
  TestKit.Desc("T05ClotureSuspendu", "Juin 2018, suspendu, Clôture → Oui (Timer) : lignes S/E/C clôturées, lignes M du 2018-07-01")
  TestKit.Desc("T06ClotureRefusee", "Clôture refusée : mois déjà clôturé, mois précédent non clôturé, inventaire > 12 mois, aucun inventaire, réponse Non")
  TestKit.Desc("T07Reedition", "Après clôture de juin (suspendu) → Rédition : texte PDF")
  TestKit.Desc("T08CalculArrondis", "calcregie coché / décoché × math / inf / sup × décimales 0 et 2 : lignes M écrites par la clôture")
  TestKit.Desc("T09Detail", "Juin 2018 → Detail : texte de ~/tmp/tarif.pdf")
  TestKit.Desc("T10EditionsStock", "Inventaire, Inventaire tournant, Stock de départ, Stock : ~/tmp/stockmat.pdf produit, Application.Busy")
  TestKit.Desc("T11DateInvalide", "Mois 13 → Control puis Edition provisoire : Textcontrol, Application.Busy, fichier PDF")
  TestKit.Desc("T13DetailSansRegie", "Fiches_regie vide → Detail : erreur figée (A07)")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "CaleditcmatTest")
  TestKit.OuvreBase("caleditcmat_shared/cmat_base")
  Start.LocalSettings["/Coul/Znaff"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Focus"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Znss"] = "background: 16777215;"
  Start.LocalSettings["/Soc" & Start.Societe & "/bois"] = -1
  Start.LocalSettings["/Soc" & Start.Societe & "/caisse/CmdVis"] = "true"
  Try Mkdir User.Home & "/tmp"

End

Public Sub _Rep_Timer()
  ''Pendant une boîte Message : relève son texte et clique le bouton $sBouton.

  Dim hW As Window
  Dim hC As Object

  For Each hW In Windows
    If Object.Type(hW) = "FMessage" Or InStr(Object.Type(hW), "Message") Then
      $hTimer.Enabled = False
      For Each hC In hW.Controls
        If Object.Type(hC) = "Label" Or Object.Type(hC) = "TextLabel" Then $sVu &= Object.GetProperty(hC, "Text") & " / "
      Next
      For Each hC In hW.Controls
        If Object.Type(hC) = "Button" Then
          If Replace(Object.GetProperty(hC, "Text"), "&", "") = $sBouton Then
            hC.Value = True
            Return
          Endif
        Endif
      Next
    Endif
  Next

End

Private Sub Reponse(sBouton As String)

  $sBouton = sBouton
  $sVu = ""
  $hTimer = New Timer As "_Rep"
  $hTimer.Delay = 300
  $hTimer.Enabled = True

End

Private Function Ouvre(sMois As String, sAnne As String, bSuspendu As Boolean, Optional bCloture As Boolean) As Object

  Dim hF As Object

  hF = New Caleditcmat
  Object.SetProperty(hF.Controls["Textmois"], "Text", sMois)
  Object.SetProperty(hF.Controls["Textanne"], "Text", sAnne)
  If bSuspendu Then
    Object.SetProperty(hF.Controls["suspendu"], "Value", True)
  Else
    Object.SetProperty(hF.Controls["acquite"], "Value", True)
  Endif
  If bCloture Then
    Object.SetProperty(hF.Controls["cloture"], "Value", True)
  Else
    Object.SetProperty(hF.Controls["provisoire"], "Value", True)
  Endif
  Return hF

End

Private Sub Etat(sCle As String)
  ''Lignes de Fiches_ligregie (hors lignes du jeu identiques) : type, date, régie, volumes, clôture.

  Dim r As Result
  Dim aRes As New String[]

  r = Utils.db.Exec("SELECT dtmouv, type, coderegie, volume, volumeap, volumess, cloture FROM Fiches_ligregie ORDER BY dtmouv, type, coderegie, code")
  If r.Available Then
    Repeat
      aRes.Add(Format(r!dtmouv, "yyyy-mm-dd") & " " & r!type & " " & r!coderegie & " " & CStr(r!volume) & " " & CStr(r!volumeap) & " " & CStr(r!volumess) & " " & CStr(r!cloture))
    Until r.MoveNext()
  Endif
  TestKit.Check(sCle & "/ligregie", aRes.Join(" ; "))

End

Private Sub Pdf(sCle As String, sFichier As String)

  Dim sTxt As String
  Dim aLig As New String[]
  Dim sL As String

  If Not Exist(sFichier) Then
    TestKit.Check(sCle & "/pdf", "<absent>")
    Return
  Endif
  Exec ["pdftotext", "-layout", sFichier, "-"] To sTxt
  For Each sL In Split(sTxt, "\n")
    sL = Trim(sL)
    If sL = "" Then Continue
    sL = Replace(sL, Format(Now, "dd/mm/yyyy"), "<date du jour>")
    aLig.Add(sL)
  Next
  TestKit.Check(sCle & "/pdf_produit", True)
  TestKit.Check(sCle & "/pdf", aLig.Join(" ¶ "))
  Kill sFichier

End

Private Sub Ddcl(sCle As String)
  ''Dernière Declaration lue par le rapport (ses méthodes <champ>_Data posent Caleditcmat.ddcl, auto-instance) :
  ''seule trace relevable des montants calculés par Edit (le PDF gb.report ne se lit pas par pdftotext).

  Dim hD As Object

  Try hD = Caleditcmat.ddcl
  If Error Or If IsNull(hD) Then
    TestKit.Check(sCle & "/ddcl", Null)
    Return
  Endif
  TestKit.Check(sCle & "/ddcl", "vae " & CStr(hD.totvol.vae.vdp) & "/" & CStr(hD.totvol.vae.ven) & "/" & CStr(hD.totvol.vae.vso) & "/" & CStr(hD.totvol.vae.vfp) & " vap " & CStr(hD.totvol.vap.vdp) & "/" & CStr(hD.totvol.vap.ven) & "/" & CStr(hD.totvol.vap.vso) & "/" & CStr(hD.totvol.vap.vfp) & " qteimp " & CStr(hD.qteimp) & " tarifdr " & CStr(hD.tarifdr) & " tarifss " & CStr(hD.tarifss) & " droit " & CStr(hD.droit) & " secu " & CStr(hD.secu) & " volumess " & CStr(hD.volumess))
  Caleditcmat.ddcl = Null

End

Private Sub Textcontrol(sCle As String, hF As Object)

  TestKit.Check(sCle & "/textcontrol", Object.GetProperty(hF.Controls["Textcontrol"], "Text"))

End

Private Sub Appel(sCle As String, hF As Object, sMethode As String)

  Try Object.Call(hF, sMethode)
  If Error Then TestKit.Check(sCle & "/" & sMethode, "ERREUR: " & Error.Text)
  TestKit.Check(sCle & "/busy", Application.Busy)
  Application.Busy = 0

End

Public Sub T01ControleOk()

  Dim hF As Object

  hF = Ouvre("06", "2018", True)
  Appel("T01/suspendu", hF, "Control_Click")
  Textcontrol("T01/suspendu", hF)
  hF = Ouvre("06", "2018", False)
  Appel("T01/acquitte", hF, "Control_Click")
  Textcontrol("T01/acquitte", hF)
  Etat("T01")

End

Private Sub BlNonFactures()

  Utils.db.Exec("INSERT INTO Fiches_Bl (numbl, cdclibl, datebl, type, imp) VALUES ('BL0901', '411001', '2018-06-10', 'B', 0), ('BL0902', '411001', '2018-05-10', 'B', 0)")
  Utils.db.Exec("INSERT INTO Fiches_Ligbl (num_ligbl, numlig_ligbl, code_ligbl, dte_ligbl) VALUES ('BL0901', '1', '001', '2018-06-10'), ('BL0901', '2', '002', '2018-06-10'), ('BL0902', '1', '001', '2018-05-10')")
  Utils.db.Exec("UPDATE Fiches_Art SET art_dra = '99' WHERE art_code = '002'")
  ' facture archivée : ligne 1 sans ligne de régie, ligne 2 avec sa ligne de régie (num FA0000901, numlig 2)
  Utils.db.Exec("INSERT INTO Fiches_HistoFac (numfac, datefac) VALUES ('FA0000901', '2018-06-12')")
  Utils.db.Exec("INSERT INTO Fiches_HistoLigfac (num_ligfac, numlig_ligfac, code_ligfac, dtligbl_ligfac) VALUES ('FA0000901', '1', '001', '2018-06-12'), ('FA0000901', '2', '001', '2018-06-12')")
  Utils.db.Exec("INSERT INTO Fiches_ligregie (dtmouv, num, numlig, type, codeart, coderegie, qte, volume, cloture) VALUES ('2018-06-12', 'FA0000901', 'fa2', 'S', '001', '02', 1, 0.70, 0)")

End

Public Sub T02ControleAnomalies()

  Dim hF As Object

  BlNonFactures()
  hF = Ouvre("06", "2018", False)
  Appel("T02/acquitte", hF, "Control_Click")
  Textcontrol("T02/acquitte", hF)
  hF = Ouvre("06", "2018", True)
  Appel("T02/suspendu", hF, "Control_Click")
  Textcontrol("T02/suspendu", hF)

End

Public Sub T03ProvisoireSuspendu()

  Dim hF As Object

  hF = Ouvre("06", "2018", True)
  Appel("T03", hF, "Edition_Click")
  Textcontrol("T03", hF)
  Ddcl("T03")
  Pdf("T03", User.Home & "/tmp/cmtmat.pdf")
  Etat("T03")

End

Public Sub T04ProvisoireAcquitte()

  Dim hF As Object

  hF = Ouvre("06", "2018", False)
  Appel("T04", hF, "Edition_Click")
  Textcontrol("T04", hF)
  Ddcl("T04")
  Pdf("T04", User.Home & "/tmp/cmtmat.pdf")
  Etat("T04")

End

Private Sub Cloture(sCle As String, hF As Object, sBouton As String)

  Reponse(sBouton)
  Appel(sCle, hF, "Edition_Click")
  $hTimer.Enabled = False
  TestKit.Check(sCle & "/message", $sVu)
  Textcontrol(sCle, hF)
  Ddcl(sCle)

End

Public Sub T05ClotureSuspendu()

  Dim hF As Object

  hF = Ouvre("06", "2018", True, True)
  Cloture("T05", hF, "Oui")
  Pdf("T05", User.Home & "/tmp/cmtmat.pdf")
  Etat("T05")

End

Public Sub T06ClotureRefusee()

  Dim hF As Object

  ' réponse Non
  hF = Ouvre("06", "2018", True, True)
  Cloture("T06/non", hF, "Non")
  Etat("T06/non")
  ' mois précédent (mai) non clôturé pour juillet
  hF = Ouvre("07", "2018", True, True)
  Cloture("T06/precedent", hF, "Oui")
  Etat("T06/precedent")
  ' mois déjà clôturé : juin après clôture
  hF = Ouvre("06", "2018", True, True)
  Cloture("T06/clos_1", hF, "Oui")
  hF = Ouvre("06", "2018", True, True)
  Cloture("T06/deja", hF, "Oui")
  Etat("T06/deja")
  ' inventaire de plus de 12 mois puis aucun inventaire (acquitté, juin)
  Utils.db.Exec("UPDATE Fiches_ligregie SET dtmouv = '2017-01-01' WHERE type = 'I'")
  hF = Ouvre("06", "2018", False, True)
  Cloture("T06/inventaire_ancien", hF, "Oui")
  Utils.db.Exec("DELETE FROM Fiches_ligregie WHERE type = 'I'")
  hF = Ouvre("06", "2018", False, True)
  Cloture("T06/sans_inventaire", hF, "Oui")
  Etat("T06/fin")

End

Public Sub T07Reedition()

  Dim hF As Object

  hF = Ouvre("06", "2018", True, True)
  Cloture("T07/cloture", hF, "Oui")
  Try Kill User.Home & "/tmp/cmtmat.pdf"
  hF = Ouvre("06", "2018", True)
  Appel("T07", hF, "Redition_Click")
  Textcontrol("T07", hF)
  Ddcl("T07")
  Pdf("T07", User.Home & "/tmp/cmtmat.pdf")

End

Public Sub T08CalculArrondis()
  ''Chaque combinaison clôture juin (suspendu) puis est annulée (lignes M de juillet supprimées, lignes de juin rouvertes).

  Dim hF As Object
  Dim bRegie As Boolean
  Dim sArr, sDec, sCle As String
  Dim r As Result
  Dim aRes As String[]

  For Each bRegie In [True, False]
    For Each sArr In ["math", "inf", "sup"]
      For Each sDec In ["0", "2"]
        sCle = "T08/" & IIf(bRegie, "regie", "lignes") & "_" & sArr & "_" & sDec
        hF = Ouvre("06", "2018", True, True)
        Object.SetProperty(hF.Controls["calcregie"], "Value", bRegie)
        Object.SetProperty(hF.Controls[sArr], "Value", True)
        Object.SetProperty(hF.Controls["nbdec"], "Text", sDec)
        Cloture(sCle, hF, "Oui")
        Try Kill User.Home & "/tmp/cmtmat.pdf"
        aRes = New String[]
        r = Utils.db.Exec("SELECT coderegie, volume, volumeap, volumess FROM Fiches_ligregie WHERE type = 'M' AND dtmouv = '2018-07-01' ORDER BY coderegie")
        If r.Available Then
          Repeat
            aRes.Add(r!coderegie & " " & CStr(r!volume) & " " & CStr(r!volumeap) & " " & CStr(r!volumess))
          Until r.MoveNext()
        Endif
        TestKit.Check(sCle & "/M", aRes.Join(" ; "))
        Utils.db.Exec("DELETE FROM Fiches_ligregie WHERE type = 'M' AND dtmouv = '2018-07-01'")
        Utils.db.Exec("UPDATE Fiches_ligregie SET cloture = 0 WHERE dtmouv BETWEEN '2018-06-02' AND '2018-06-30'")
      Next
    Next
  Next

End

Public Sub T09Detail()

  Dim hF As Object

  hF = Ouvre("06", "2018", True)
  Appel("T09", hF, "detail_Click")
  Pdf("T09", User.Home & "/tmp/tarif.pdf")

End

Public Sub T10EditionsStock()
  ''Le contenu des éditions EditStkDepart est testé par EditStkDepartTest ; ici l'appel de chaque bouton, sur le jeu
  ''de la classe (sans Fiches_Inv/Fiches_InvT ni art_stkdep : erreurs figées) puis sur editstkdepart_shared/cmat_base.

  Editions("T10/cmat_base")
  TestKit.OuvreBase("editstkdepart_shared/cmat_base")
  Editions("T10/editstkdepart")

End

Private Sub Editions(sCle As String)

  Dim hF As Object
  Dim sB As String

  hF = Ouvre("06", "2018", True)
  For Each sB In ["inv", "invt", "stdep", "stock"]
    Try Kill User.Home & "/tmp/stockmat.pdf"
    Appel(sCle & "/" & sB, hF, sB & "_Click")
    TestKit.Check(sCle & "/" & sB & "/pdf", Exist(User.Home & "/tmp/stockmat.pdf"))
  Next

End

Public Sub T11DateInvalide()

  Dim hF As Object

  hF = Ouvre("13", "2018", True)
  Try Object.Call(hF, "Control_Click")
  If Error Then TestKit.Check("T11/control", "ERREUR: " & Error.Text)
  TestKit.Check("T11/control/busy", Application.Busy)
  Textcontrol("T11/control", hF)
  Try Object.Call(hF, "Edition_Click")
  If Error Then TestKit.Check("T11/edition", "ERREUR: " & Error.Text)
  TestKit.Check("T11/edition/busy", Application.Busy)
  Application.Busy = 0
  Pdf("T11", User.Home & "/tmp/cmtmat.pdf")
  Etat("T11")

End

Public Sub T13DetailSansRegie()

  Dim hF As Object

  Utils.db.Exec("DELETE FROM Fiches_regie")
  hF = Ouvre("06", "2018", True)
  Appel("T13", hF, "detail_Click")
  Pdf("T13", User.Home & "/tmp/tarif.pdf")

End
