SELECT DISTINCT SUM(CASE WHEN qte_ligbl IS NULL THEN '0' ELSE REPLACE(qte_ligbl,',','.') END ) * -1 as qte FROM Fiches_Ligbl JOIN Fiches_Bl ON num_ligbl = numbl WHERE dte_ligbl >= '20180601' And (type = 'B' OR type = 'F') AND code_ligbl='003' AND typel_ligbl = 'A' UNION ALL(SELECT SUM(CASE WHEN qte_ligbl IS NULL THEN '0' ELSE REPLACE(qte_ligbl,',','.') END ) * -1 as qte FROM Fiches_LigblM JOIN Fiches_BlM ON num_ligbl=numbl WHERE dte_ligbl >= '20180601' and (type = 'B' OR type = 'F') AND code_ligbl='003' AND typel_ligbl = 'A') UNION ALL(SELECT DISTINCT SUM(CASE WHEN qte_ligfac IS NULL THEN '0' ELSE REPLACE(qte_ligfac,',','.') END ) * -1 as qte FROM Fiches_HistoFac JOIN Fiches_HistoLigfac ON num_ligfac=numfac WHERE dtligbl_ligfac >= '20180601' AND code_ligfac='003' AND typel_ligfac = 'A') UNION ALL(SELECT SUM(CASE WHEN qte_ligfac IS NULL THEN '0' ELSE REPLACE(qte_ligfac,',','.') END ) * -1 as qte FROM Fiches_HistoFacM JOIN Fiches_HistoLigfacM ON num_ligfac=numfac WHERE dtligbl_ligfac >= '20180601' AND code_ligfac='003' AND typel_ligfac = 'A') UNION ALL(SELECT SUM(CASE WHEN qte IS NULL THEN '0' ELSE REPLACE(qte,',','.') END ) * '1.0000' as qte FROM Fiches_Ligrecpt WHERE daterecpt>= '20180601' AND code='003') UNION ALL(SELECT SUM(CASE WHEN qtep IS NULL THEN '0' ELSE REPLACE(qtep,',','.') END - CASE WHEN qtem IS NULL THEN '0' ELSE REPLACE(qtem,',','.') END ) as qte FROM Fiches_Mvtexp WHERE daterecpt>='20180601' AND code='003') UNION ALL(SELECT SUM(CASE WHEN qtep IS NULL THEN '0' ELSE REPLACE(qtep,',','.') END  - CASE WHEN qtem IS NULL THEN '0' ELSE REPLACE(qtem,',','.') END ) as qte FROM Fiches_Mvtexpdc WHERE daterecpt>='20180601' AND code='003') UNION ALL(SELECT SUM(CASE WHEN type='S' THEN CASE WHEN qte IS NULL THEN '0' ELSE REPLACE(qte,',','.') END * -1 ELSE CASE WHEN qte IS NULL THEN '0' ELSE REPLACE(qte,',','.') END END) AS qte FROM Fiches_Sdepots WHERE code='01' AND date >= '20180601' AND cart='003')
