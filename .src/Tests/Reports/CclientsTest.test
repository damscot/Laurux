' Gambas test file

''Tests de Cclients (.hidden/reference/.src/Reports/Cclients.class/test.md, CCLIENTS-T01 à T03).
''Chaque test produit un PDF non compressé (SetCompression(False)) dans un fichier temporaire et vérifie :
''le texte rendu par « pdftotext -layout » (une clé par ligne non vide), le nombre et la taille des pages
''(pdfinfo) et l'empreinte md5 du fichier PDF (flux : positions, polices, couleurs), après masquage de
''/CreationDate, de la date du jour et de User.Name. Valeurs attendues : assets/CclientsTest/expected.txt,
''produites dans le clone de référence. Pas de base de données. T04, T05 (rejeux) restent à faire.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Clients", "Clients portrait : Entete, Level1, 3 Level2, Lines, BasPage sur 2 pages")
  TestKit.Desc("T02Sage", "Clients Sage : Level2S avec domiciliation renseignée puis vide")
  TestKit.Desc("T03Fournisseurs", "Fournisseurs paysage : EnteteP, Level1F, 3 Level2F, LinesP, BasPageP puis BasPage")

End

Public Sub _Setup()

  TestKit.Begin("Reports", "CclientsTest")

End

Private Function Nouveau(Optional sOrient As String = "Portrait", Optional sFormat As String = "A4") As Cclients

  Dim pdf As Cclients

  pdf = New Cclients(sOrient, "mm", sFormat)
  pdf.SetCompression(False)
  pdf.Open()
  pdf.AliasNbPages()
  Return pdf

End

' Écrit le PDF, vérifie chaque ligne non vide du texte extrait puis l'empreinte du fichier masqué.
Private Sub Verifie(sCle As String, pdf As Cclients)

  Dim sFic As String = Temp$("rep") & ".pdf"
  Dim sTxt As String
  Dim sLig As String
  Dim sBuf As String
  Dim sMd5 As String
  Dim n As Integer

  Try pdf.Output(sFic, False)
  If Error Then
    TestKit.Check(sCle & "/output", "ERREUR: " & Error.Text)
    Return
  Endif
  Shell "pdftotext -layout " & Shell$(sFic) & " -" To sTxt
  sTxt = Replace(sTxt, Format$(Date(Now), "dd/mm/yyyy"), "<date>")
  sTxt = Replace(sTxt, User.Name, "<utilisateur>")
  sTxt = Replace(sTxt, "\f", "<saut de page>\n")
  For Each sLig In Split(sTxt, "\n")
    sLig = RTrim(sLig)
    If sLig = "" Then Continue
    Inc n
    TestKit.Check(sCle & "/l" & Format$(n, "000"), sLig)
  Next
  TestKit.Check(sCle & "/lignes", n)
  Shell "pdfinfo " & Shell$(sFic) & " | grep -E '^(Pages|Page size)'" To sBuf
  TestKit.Check(sCle & "/pdfinfo", Trim(sBuf))
  ' Flux : masquage des valeurs variables puis empreinte
  sBuf = File.Load(sFic)
  sTxt = ""
  For Each sLig In Split(sBuf, "\n")
    If InStr(sLig, "/CreationDate") > 0 Then Continue
    sTxt &= sLig & "\n"
  Next
  sTxt = Replace(sTxt, Format$(Date(Now), "dd/mm/yyyy"), "<date>")
  sTxt = Replace(sTxt, User.Name, "<utilisateur>")
  File.Save(sFic & ".flux", sTxt)
  Shell "md5sum < " & Shell$(sFic & ".flux") To sMd5
  TestKit.Check(sCle & "/flux_md5", Trim(Left(sMd5, 32)))

End

Public Sub T01Clients()

  Dim pdf As Cclients = Nouveau()

  pdf.Entete("Liste des clients")
  pdf.Level1()
  pdf.Level2("411001", "DUPONT", "Jean", "1 rue A", "Bât B", "44000", "NANTES", "0240000001", "0600000001", "10", "5", 30, "CHQ")
  pdf.Level2("411002", "MARTIN", "", "2 rue B", "", "75001", "PARIS", "", "", "0", "0", 40, "")
  pdf.Lines("50")
  pdf.BasPage()
  pdf.Entete("Liste des clients (suite)")
  pdf.Level1()
  pdf.Level2("411003", "DURAND", "Paul", "3 rue C", "", "69000", "LYON", "0400000003", "", "", "", 30, "VIR")
  pdf.Lines("40")
  pdf.BasPage()
  Verifie("T01", pdf)

End

Public Sub T02Sage()

  Dim pdf As Cclients = Nouveau()

  pdf.Entete("Clients Sage")
  pdf.Level2S("411001", "DUPONT", "1 rue A", "Bât B", "44000", "NANTES", "BANQUE X", "12345", "67890", "00011122233", 30)
  pdf.Level2S("411002", "MARTIN", "2 rue B", "", "75001", "PARIS", "", "", "", "", 40)
  Verifie("T02", pdf)

End

Public Sub T03Fournisseurs()

  Dim pdf As Cclients = Nouveau("Landscape")

  pdf.EnteteP("Liste des fournisseurs")
  pdf.Level1F()
  pdf.Level2F("401001", "FOURNI UN", "Anne", "1 rue A", "", "44000", "NANTES", "0240000001", "0600000001", 30)
  pdf.Level2F("401002", "FOURNI DEUX", "", "2 rue B", "ZI", "75001", "PARIS", "", "", 40)
  pdf.Level2F("401003", "FOURNI TROIS", "Luc", "", "", "", "", "", "", 50)
  pdf.LinesP("60")
  pdf.BasPageP()
  pdf.BasPage()
  Verifie("T03", pdf)

End
