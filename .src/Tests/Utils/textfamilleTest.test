' Gambas test file

''Tests de textfamille (.hidden/reference/.src/Utils/textfamille.class/test.md, TEXTFAMILLE-T01 à T04).
''Contrôle créé dans une fenêtre non affichée (Xvfb du runner) ; ipr fixé dans la configuration de test
''(copie temporaire de Laurux-test.conf). Les zones internes sont lues par Children.
''TEXTFAMILLE-T05/T06 (saisie dans la fiche article, ipr absent) relèvent de scénarios GUI.

Private $hWin As Window

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Construction", "Construction")
  TestKit.Desc("T02Text", "`text` écriture/lecture")
  TestKit.Desc("T03NiveauVide", "Niveau vide intermédiaire")
  TestKit.Desc("T04Clear", "`Clear`")

End

Public Sub _Setup()

  TestKit.Begin("Utils", "textfamilleTest")

End

Private Function Cree(Ipr As Integer[]) As textfamille

  Start.LocalSettings["/Soc" & Start.Societe & "/ipr"] = Ipr
  $hWin = New Window
  Return New textfamille($hWin)

End

Private Function Zones(hTf As textfamille) As String

  Dim aRes As New String[]
  Dim hCtrl As Control
  Dim hTxt As TextBox

  For Each hCtrl In hTf.Children
    If hCtrl Is TextBox Then
      hTxt = hCtrl
      aRes.Add("[" & hTxt.Text & "]")
    Endif
  Next
  Return aRes.Join("|")

End

Public Sub T01Construction()

  Dim hTf As textfamille = Cree([1, 3, 5])
  Dim hCtrl As Control
  Dim hTxt As TextBox
  Dim i As Integer

  TestKit.Check("T01/nb_enfants", hTf.Children.Count)
  For Each hCtrl In hTf.Children
    TestKit.Check("T01/" & i & "/classe", Object.Type(hCtrl))
    If hCtrl Is TextBox Then
      hTxt = hCtrl
      TestKit.Check("T01/" & i & "/MaxLength", hTxt.MaxLength)
      TestKit.Check("T01/" & i & "/Width", hTxt.Width)
    Endif
    Inc i
  Next
  TestKit.Check("T01/text_initial", hTf.text)

End

Public Sub T02Text()

  Dim aEntrees As String[] = ["A0102", "A01", "A", "", "A0102XYZ"]
  Dim hTf As textfamille = Cree([1, 3, 5])
  Dim sVal As String

  For Each sVal In aEntrees
    hTf.text = sVal
    TestKit.Check("T02/" & sVal & "/zones", Zones(hTf))
    TestKit.Check("T02/" & sVal & "/text", "[" & hTf.text & "]")
  Next

End

Public Sub T03NiveauVide()

  Dim hTf As textfamille = Cree([1, 3, 5])
  Dim hCtrl As Control
  Dim hTxt As TextBox
  Dim i As Integer

  ' Zone 1 vide, zone 2 = "01", zone 3 vide
  For Each hCtrl In hTf.Children
    If hCtrl Is TextBox Then
      hTxt = hCtrl
      If i = 1 Then hTxt.Text = "01"
      Inc i
    Endif
  Next
  TestKit.Check("T03/zones", Zones(hTf))
  TestKit.Check("T03/text", "[" & hTf.text & "]")
  ' Zone 1 vide, zone 3 = "02"
  hTf.text = ""
  i = 0
  For Each hCtrl In hTf.Children
    If hCtrl Is TextBox Then
      hTxt = hCtrl
      If i = 2 Then hTxt.Text = "02"
      Inc i
    Endif
  Next
  TestKit.Check("T03/zone3/text", "[" & hTf.text & "]")

End

Public Sub T04Clear()

  Dim hTf As textfamille = Cree([1, 3, 5])

  hTf.text = "A0102"
  TestKit.Check("T04/avant", "[" & hTf.text & "]")
  hTf.Clear
  TestKit.Check("T04/zones", Zones(hTf))
  TestKit.Check("T04/apres", "[" & hTf.text & "]")

End
