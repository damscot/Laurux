' Gambas test file

''Tests de TypeClient (.hidden/reference/.src/Compta/Utils/TypeClient.class/test.md, TYPECLIENT-T01, T02, T03).
''Le contrôle (TreeView) est créé dans une fenêtre jamais affichée. Jeu typeclient_types (types 01, 02, 03 de
''Laurux01 et « A' »). Valeurs attendues : assets/TypeClientTest/expected.txt (clone de référence).

Private $hW As Window
Private $hTc As TypeClient

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Chargement", "Éléments chargés depuis Fiches_Typec (clés, libellés, ordre)")
  TestKit.Desc("T03Balance", "Écran Balance, types 01 et 03 sélectionnés, Imprimer : texte du PDF (pdftotext)")
  TestKit.Desc("T02Where", "Propriété `where` : aucune sélection, 1 type, 3 types, code avec apostrophe")

End

Public Sub _Setup()

  TestKit.Begin("Compta", "TypeClientTest")
  TestKit.OuvreBase("typeclient_types")
  $hW = New Window
  $hTc = New TypeClient($hW)

End

Private Sub Selectionne(aCles As String[])

  Dim sCle As String

  $hTc.UnselectAll
  For Each sCle In aCles
    $hTc[sCle].Selected = True
  Next

End

Public Sub T01Chargement()

  Dim sRes As String

  TestKit.Check("T01/nombre", $hTc.Count)
  If $hTc.MoveFirst() Then
    TestKit.Check("T01/elements", "<aucun>")
    Return
  Endif
  Repeat
    sRes &= $hTc.Item.Key & "=" & $hTc.Item.Text & " | "
  Until $hTc.MoveNext()
  TestKit.Check("T01/elements", sRes)

End

Public Sub T02Where()

  $hTc.Mode = Select.Multiple
  TestKit.Check("T02/aucune", $hTc.where)
  Selectionne(["02"])
  TestKit.Check("T02/un", $hTc.where)
  Selectionne(["01", "02", "03"])
  TestKit.Check("T02/trois", $hTc.where)
  Selectionne(["A'"])
  TestKit.Check("T02/apostrophe", $hTc.where)

End

Public Sub T03Balance()
  ''TYPECLIENT-T03, bloqué au rejeu (sélection dans le TreeView TypeClient) : écran Balance instancié sans affichage
  ''(jeu typeclient_balance : 411001 type 01, 411002 type 02, 411003 type 03), exercice 2018 posé, types 01 et 03
  ''sélectionnés dans TypeClient1, Button1_Click (Imprimer → BalanceM.Imprime) appelé directement ; PDF converti
  ''par pdftotext -layout via /Soc01/caisse/CmdVis (Visualiseur.Prog). Date d'édition et utilisateur masqués.

  Dim hF As Balance
  Dim hT As Object
  Dim sTxt As String = Temp$() & ".txt"
  Dim i As Integer
  Dim aL As String[]
  Dim sL As String

  TestKit.OuvreBase("typeclient_balance")
  Start.LocalSettings["/Soc01/caisse/CmdVis"] = "sh -c 'pdftotext -layout \"$0\" " & sTxt & "'"
  Try hF = New Balance
  If Error Then
    TestKit.Check("T03/new", "ERREUR: " & Error.Text)
    Return
  Endif
  Object.SetProperty(hF.Controls["DteN0"], "Text", "01.01.2018")
  Object.SetProperty(hF.Controls["Dten1"], "Text", "31.12.2018")
  hT = hF.Controls["TypeClient1"]
  hT["01"].Selected = True
  hT["03"].Selected = True
  TestKit.Check("T03/where", hT.where)
  Try hF.Button1_Click()
  If Error Then TestKit.Check("T03/imprimer_err", "ERREUR: " & Error.Text)
  ' Shell asynchrone : attente du texte (5 s au plus)
  For i = 1 To 50
    If Exist(sTxt) Then
      If Stat(sTxt).Size > 0 Then Break
    Endif
    Wait 0.1
  Next
  Wait 0.2
  If Not Exist(sTxt) Then
    TestKit.Check("T03/pdf", "<absent>")
  Else
    aL = Split(File.Load(sTxt), "\n")
    TestKit.Check("T03/pdf_lignes", aL.Count)
    For i = 0 To aL.Max
      sL = RTrim(aL[i])
      sL = Replace(sL, Format(Now, "dd/mm/yyyy"), "<date du jour>")
      sL = Replace(sL, "demandée par " & User.Name, "demandée par <utilisateur>")
      TestKit.Check("T03/pdf" & Format(i, "000"), sL)
    Next
  Endif
  Object.Lock(hF)

End
