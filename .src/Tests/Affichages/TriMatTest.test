' Gambas test file

''Tests de TriMat (.hidden/reference/.src/Affichages/TriMat.class/test.md).
''Valeurs attendues : assets/TriMatTest/expected.txt, produites dans le clone de référence.
''La fenêtre est instanciée sans être affichée (Org vide, ou « EdMat » pour T01/T05 : reprise dans l'auto-instance EdMat) et pilotée par ses méthodes
''publiques ; la liste est relue dans ColMat. Jeu Gestion/edmat_shared/edmat_base (8 matériels, lecture seule).

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Selection", "Org = EdMat : clic sur la 2e puis la 4e ligne (ColMat_Click) : EdMat.Bsel et EdMat.CodeMat, fenêtre fermée")
  TestKit.Desc("T05Annulation", "Sélection puis réouverture fermée sans choix (Close, équivalent d'Échap) : EdMat.Bsel reste vrai et l'ancien code reste dans EdMat.CodeMat (A02)")
  TestKit.Desc("T02FiltreTri", "Tri par intitulé, code (lpad), propriétaire, marque, type ; double-clic (tri décroissant) : listes")
  TestKit.Desc("T03VendusStock", "Boutons radio vendus (2), en stock (3), tous (1) : listes filtrées par mat_vendu")
  TestKit.Desc("T04Pagination", "Descendre et Remonter sur une liste d'une page : liste inchangée")

End

Public Sub _Setup()

  TestKit.Begin("Affichages", "TriMatTest")
  TestKit.OuvreBase("Gestion/edmat_shared/edmat_base")
  Start.LocalSettings["/Coul/Znaff"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Focus"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Znss"] = "background: 16777215;"

End

Private Sub Ouvre() As TriMat

  Dim hF As TriMat

  Try hF = New TriMat(True, False, "mat_design", "")
  If Error Then
    TestKit.Check("ouverture", "ERREUR: " & Error.Text & " " & Error.Where)
    Return Null
  Endif
  Return hF

End

Private Sub Ct(hF As TriMat, sNom As String) As Object

  Dim hC As Object

  hC = hF.Controls[sNom]
  Return hC

End

' ColMat : nombre de lignes, colonnes 0 et 2 de chaque ligne
Private Sub Grille(hF As TriMat) As String

  Dim hG As Object
  Dim i As Integer
  Dim s As String

  hG = Ct(hF, "ColMat")
  s = hG.Rows.Count & " :"
  For i = 0 To hG.Rows.Count - 1
    s &= " " & hG[i, 0].Text & "/" & hG[i, 2].Text
  Next
  Return s

End

Private Sub Trie(hF As TriMat) As String

  Dim hG As Object
  Dim i As Integer
  Dim aCode As New String[]
  Dim s As String

  hG = Ct(hF, "ColMat")
  For i = 0 To hG.Rows.Count - 1
    aCode.Add(hG[i, 0].Text)
    s &= " " & hG[i, 2].Text
  Next
  aCode.Sort()
  Return hG.Rows.Count & " : " & aCode.Join(" ") & " ; colonne :" & s

End

' Ouverture avec reprise dans l'auto-instance EdMat (Org = "EdMat"), sans afficher
Private Sub OuvreEdMat() As TriMat

  Dim hF As TriMat

  Try hF = New TriMat(True, False, "mat_design", "EdMat")
  If Error Then
    TestKit.Check("ouverture", "ERREUR: " & Error.Text & " " & Error.Where)
    Return Null
  Endif
  Return hF

End

Public Sub T01Selection()

  Dim hF As TriMat
  Dim hG As Object

  EdMat.Bsel = False
  EdMat.CodeMat = ""
  hF = OuvreEdMat()
  If IsNull(hF) Then Return
  hG = Ct(hF, "ColMat")
  hG.Row = 1
  TestKit.Check("T01/ligne1", hG[1, 0].Text)
  hF.ColMat_Click()
  TestKit.Check("T01/bsel1", EdMat.Bsel)
  TestKit.Check("T01/codemat1", EdMat.CodeMat)
  ' 2e matériel (borne haute)
  hF = OuvreEdMat()
  If IsNull(hF) Then Return
  hG = Ct(hF, "ColMat")
  hG.Row = 3
  TestKit.Check("T01/ligne3", hG[3, 0].Text)
  hF.ColMat_Click()
  TestKit.Check("T01/bsel2", EdMat.Bsel)
  TestKit.Check("T01/codemat2", EdMat.CodeMat)

End

Public Sub T05Annulation()

  Dim hF As TriMat
  Dim hG As Object

  EdMat.Bsel = False
  EdMat.CodeMat = ""
  hF = OuvreEdMat()
  If IsNull(hF) Then Return
  hG = Ct(hF, "ColMat")
  hG.Row = 2
  hF.ColMat_Click()
  TestKit.Check("T05/codemat_choisi", EdMat.CodeMat)
  ' Réouverture puis fermeture sans choix (Échap/F2 de ColMat_KeyPress : Me.Close)
  hF = OuvreEdMat()
  If IsNull(hF) Then Return
  hF.Close()
  TestKit.Check("T05/bsel_apres_annulation", EdMat.Bsel)
  TestKit.Check("T05/codemat_apres_annulation", EdMat.CodeMat)

End

Public Sub T02FiltreTri()

  Dim hF As TriMat
  Dim sChoix As String

  hF = Ouvre()
  If IsNull(hF) Then Return
  TestKit.Check("T02/ouverture", Grille(hF))
  hF.mat_Dblclk()
  TestKit.Check("T02/intitule_desc", Grille(hF))
  hF.mat_Dblclk()
  TestKit.Check("T02/intitule_asc", Grille(hF))
  hF.CO_GotFocus()
  TestKit.Check("T02/code", Grille(hF))
  hF.mat_Dblclk()
  TestKit.Check("T02/code_desc", Grille(hF))
  For Each sChoix In ["Propriétaire", "Numéro série", "Marque", "Type"]
    hF.mat_Dblclk()
    Ct(hF, "CB1").Text = sChoix
    hF.Cb1_GotFocus()
    ' Tri sur la seule colonne choisie : ordre des ex aequo non déterministe, codes triés et suite de la colonne
    TestKit.Check("T02/cb1[" & sChoix & "]", Trie(hF))
  Next
  Object.Lock(hF)

End

Public Sub T03VendusStock()

  Dim hF As TriMat
  Dim sRadio As String

  hF = Ouvre()
  If IsNull(hF) Then Return
  For Each sRadio In ["RadioButton2", "RadioButton3", "RadioButton1"]
    Ct(hF, sRadio).Value = True
    TestKit.Check("T03/" & sRadio, Grille(hF))
  Next
  Object.Lock(hF)

End

Public Sub T04Pagination()

  Dim hF As TriMat

  hF = Ouvre()
  If IsNull(hF) Then Return
  hF.Descendre_Click()
  TestKit.Check("T04/descendre", Grille(hF))
  hF.Remonter_Click()
  TestKit.Check("T04/remonter", Grille(hF))
  Object.Lock(hF)

End
