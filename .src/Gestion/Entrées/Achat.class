  lab.font = Font["Serif,9"]
  lab.Text = res!fo_adr1
  lab = New ReportLabel(contv)
  lab.font = Font["Serif,9"]
  lab.Text = res!fo_adr2
  lab = New ReportLabel(contv)
  lab.font = Font["Serif,9"]
  lab.Text = res!fo_cd_ptl & " " & res!fo_ville
  lab = New ReportLabel(contv)
  lab.font = Font["Serif,9"]
  lab.Text = "Tel : " & res!fo_tel_std
  lab = New ReportLabel(contv)
  lab.Height = "3mm"
  conth = New ReportHBox(contv)
  conth.BackGround = ReportBrush.Color(coul)
  conth.Border = ReportBorder["Top:1pt #000000;Bottom:1pt #000000;Left:1pt #000000;Right:1pt #000000"]
  lab = New ReportLabel(conth)
