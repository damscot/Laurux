drop Table IF exists Facturefm
CREATE TABLE Facturefm(code Char(8) NOT NULL,nom Char(35),cp Char(5),adr1 Char(35),adr2 Char(35),ville Char(35),totf Char(12),tottc Char(12),gestbl Decimal(6,2),PRIMARY KEY (code, nom))  ENGINE = InnoDB
drop Table IF exists Bl
CREATE TABLE Bl(num Char(12) NOT NULL,code Char(10),nom Char(35),date date,ht Char(12),ttc Char(12),PRIMARY KEY (num))  ENGINE = InnoDB
