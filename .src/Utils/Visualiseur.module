' Gambas module file

Public Sub Prog(Fic As String, Optional mime_type As String = "application/pdf") As String

  Dim $Exec As String

  If Start.LocalSettings["/Soc" & Start.Societe & "/caisse/CmdVis"] Then
    Shell Start.LocalSettings["/Soc" & Start.Societe & "/caisse/CmdVis"] & " " & Fic
  Else
    Desktop.Open(Fic)
  Endif

End
