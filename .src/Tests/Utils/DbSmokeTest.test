' Gambas test file

''Fumée du framework : base restaurée et ouverte par TestKit.OuvreBase (à supprimer quand des tests réels
''de base de données existeront).

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Version", "version")

End

Public Sub _Setup()

  TestKit.Begin("Utils", "DbSmokeTest")
  TestKit.OuvreBase()

End

Public Sub T01Version()

  Dim r As Result

  r = Utils.db.Exec("SELECT version FROM " & Cbase.Table("TabParam"))
  TestKit.Check("version", r!version)

End
