    lab.Border = ReportBorder["Right:1pt #000000"]
    lab.Expand = True
    lab = New ReportLabel(conth)
    lab.font = Font["Serif,Blod,9"]
    lab.Text = lg.MonControle["Qte"].text
    lab.Alignment = Align.Right
    lab.Width = "15mm"
    If chiffre Then
      lab.Border = ReportBorder["Right:1pt #000000"]
      lab = New ReportLabel(conth)
      lab.font = Font["Serif,Blod,9"]
      lab.Text = lg.MonControle["Px_Brut"].text
      lab.Alignment = Align.Right
      lab.Border = ReportBorder["Right:1pt #000000"]
      lab.Width = "30mm"
      lab = New ReportLabel(conth)
      lab.font = Font["Serif,Blod,9"]
      lab.Text = lg.MonControle["Rem"].Text
      lab.Alignment = Align.Right
      lab.Border = ReportBorder["Right:1pt #000000"]
      lab.Width = "15mm"
      lab = New ReportLabel(conth)
      lab.font = Font["Serif,Blod,9"]
      lab.Text = lg.MonControle["Px_Net"].Text
      lab.Alignment = Align.Right
      lab.Border = ReportBorder["Right:1pt #000000"]
      lab.Width = "30mm"
      lab = New ReportLabel(conth)
      lab.font = Font["Serif,Blod,9"]
      lab.Text = lg.MonControle["Px_Rev"].text
      lab.Alignment = Align.Right
      lab.Width = "30mm"
      If Me.opt = "B" Or Me.opt = "T" Then
        lab.Border = ReportBorder["Right:1pt #000000"]
        rep.Orientation = Printer.Landscape
        lab = New ReportLabel(conth)
        lab.font = Font["Serif,Blod,9"]
        lab.Text = lg.AutresObj[Achat.Consignes].ccd.consigne.L
        lab.Alignment = Align.Right
        lab.Width = "30mm"
        lab.Border = ReportBorder["Right:1pt #000000"]
        lab = New ReportLabel(conth)
        lab.font = Font["Serif,Blod,9"]
        lab.Text = lg.AutresObj[Consignes].ccd.degre
        lab.Alignment = Align.Right
        lab.Width = "15mm"
        lab.Border = ReportBorder["Right:1pt #000000"]
        lab = New ReportLabel(conth)
        lab.font = Font["Serif,Blod,9"]
        lab.Text = lg.AutresObj[Consignes].ccd.volume_total().TotBHT.G
        lab.Alignment = Align.Right
        lab.Width = "20mm"
        lab.Border = ReportBorder["Right:1pt #000000"]
        lab = New ReportLabel(conth)
        lab.font = Font["Serif,Blod,9"]
        lab.Text = lg.AutresObj[Consignes].ccd.volume_total().TotNHT.G 
        lab.Alignment = Align.Right
        lab.Width = "20mm"
      Endif
    Endif
  Next
  
  If chiffre Then
    lab = New ReportLabel(rep)
    lab.Height = "4mm"
    lab.font = Font["Serif,Blod,10"]
    lab.Alignment = Align.Right
    lab.Border = ReportBorder["Top:1pt #000000;Bottom:1pt #000000;Left:1pt #000000;Right:1pt #000000"]
    lab.Text = "TOTAL HT : " & Format(TotHt, "0.00") & "   TOTAL TTC  : " & Format(TotTtc, "0.00")
  Endif
  contv = New ReportVBox(rep)
  contv.Expand = True
  conth = New ReportHBox(rep)
  conth.Fixed = True
  lab = New ReportLabel(conth)
  lab.Text = Format$(Now, "dd/mm/yyyy hh.nn") & " - Impression demandée par " & User.Name
  lab.font = Font["Serif,8"]
  lab = New ReportLabel(conth)
  lab.Text = ("=\"Page : \" & Page ")
  lab.font = Font["Serif,8"]
  lab.Expand = True
  lab.Alignment = Align.Right
  
  Return rep

End

Private Function ChoixCode() As Integer        ''on choisi si on imprime le code article/fournisseur/central
  
  Dim win As Window
  Dim pan As Panel
  Dim rd, rd1, rd2 As RadioButton
  Dim bt As Button
  
  win = New Window
  win.Arrangement = Arrange.Vertical
  win.Text = "Sélection du code à éditer"
  win.Height = win.Font.Height * 5
  win.Width = win.Font.Size * 55
  pan = New Panel(win)
  pan.Arrangement = Arrange.Vertical
  pan.Expand = True
  rd = New RadioButton(pan) 
  rd.Text = "Code article"
  rd.Expand = True
  rd.Value = True
  rd1 = New RadioButton(pan) 
  rd1.Text = "Référence fournisseur"
  rd1.Expand = True
  rd2 = New RadioButton(pan) 
  rd2.Text = "Référence centrale"
  rd2.Expand = True
  bt = New Button(win) As "ButT"
  bt.Text = "Ok"
  bt.Width = win.Font.Size * 6
  bt.Tag = win
  
  win.Showmodal()
  
  If rd.Value Then Return 0
  If rd1.Value Then Return 1
  If rd2.Value Then Return 2
  
End

Public Sub ButT_click()
  
  Last.Tag.Close

End

Public Sub mail()

  Dim win As Window
  Dim pan As Panel
  Dim cb As ComboBox
  Dim rd, rd1 As RadioButton
  Dim bt As Button
  Dim res As Result
  Dim rep As Report
  Dim prt As New Printer
  Dim tMail As String[]
  
  win = New Window
  win.Arrangement = Arrange.Vertical
  win.Text = "Envoi de commande"
  win.Height = win.Font.Height * 5
  win.Width = win.Font.Size * 45
  pan = New Panel(win)
  pan.Arrangement = Arrange.Horizontal
  pan.Expand = True
  rd = New RadioButton(pan) 
  rd.Text = "Chiffrée"
  rd.Expand = True
  rd.Value = True
  rd1 = New RadioButton(pan) 
  rd1.Text = "Non chiffrée"
  rd1.Expand = True
  cb = New ComboBox(win) As "mail"
  cb.Expand = True
  res = Utils.db.Exec("SELECT * FROM Mails_Four WHERE code = &1", $fournisseur)
  If res.Available Then
    Repeat
      cb.Add(res!mail)
    Until res.MoveNext()
  Endif
  res = Utils.db.Exec("SELECT * FROM Fiches_ContactF WHERE code = &1", $fournisseur)
  If res.Available Then 
    cb.add(res!nom & " " & res!pnm & " | " & res!mail)
  Endif
  $mail = cb.Text
  bt = New Button(win) As "ButT"
  bt.Text = "Ok"
  bt.Width = win.Font.Size * 6
  bt.Tag = win
  
  win.ShowModal()
  
  rep = imprime(True, rd.Value)
  If IsNull(rep) Then Return
    tMail = Split($mail, "|")
    Try $mail = tMail[1]
  prt.OutputFile = User.Home & "/tmp/BonCommande.pdf"
  rep.Print(prt)
  EnvMail.Envoi2($mail, "Notre commande du " & $dte.L, "Bonjour, \nMerci de bien vouloir prendre en compte notre commande ci_jointe \nCordialement.", prt.OutputFile)
  
End

Public Sub mail_change()

  $mail = Last.Text

End

Public Sub mail_click()

  $mail = Last.Text

End
