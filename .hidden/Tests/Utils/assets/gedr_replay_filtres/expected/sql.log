select *, GROUP_CONCAT(tag SEPARATOR ',') as parse_having_tags from Fiches_Tag inner join Docs_Tag as t on lind=t.tag_lind inner join Docs_Ged as d on d.lind=t.doc_lind limit 1
select *, GROUP_CONCAT(tag SEPARATOR ',') as parse_having_tags from Fiches_Tag inner join Docs_Tag as t on lind=t.tag_lind inner join Docs_Ged as d on d.lind=t.doc_lind       order by t.doc_lind limit 0, 22
