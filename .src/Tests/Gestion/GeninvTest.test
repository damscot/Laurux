Public Sub T13FeuilleComptage()
  ''GENINV-T13 : génération (tri par défaut) puis feuille de comptage, stock théorique coché puis décoché ; ordre
  ''des lignes lu sans ORDER BY (GENINV-A01, figé).

  Dim hF As Geninv

  TestKit.OuvreBase("geninv_shared/inv_gen_articles")
  hF = Fiche("15/06/2018")
  Reponses([])
  hF.gen_Inv()
  FinReponses("T13/gen")
  Object.SetProperty(hF.Controls["Stkt"], "Value", CheckBox.True)
  Feuille(hF, "T13/stock")
  Object.SetProperty(hF.Controls["Stkt"], "Value", CheckBox.False)
  Feuille(hF, "T13/sans_stock")
  Object.Lock(hF)

End

Public Sub T14ImpressionErreurs()
  ''GENINV-T14 : feuille demandée sans Fiches_Inv, puis avec un article supprimé de Fiches_Art après la génération
  ''(rarts lu sans Available, GENINV-A04) : « Veuillez génerer votre inventaire » dans les deux cas (figé).

  Dim hF As Geninv

  TestKit.OuvreBase("geninv_shared/inv_gen_articles")
  hF = Fiche("15/06/2018")
  Feuille(hF, "T14/absente")
  Object.Lock(hF)
  TestKit.OuvreBase("geninv_shared/inv_gen_supprime")
  hF = Fiche("15/06/2018")
  Feuille(hF, "T14/supprime")
  Object.Lock(hF)

End

Public Sub T15Pagination()
  ''GENINV-T15 : 45 articles stockés (jeu inv_gen_nombreux) : changement de page à 288 mm, en-têtes répétés.

  Dim hF As Geninv

  TestKit.OuvreBase("geninv_shared/inv_gen_nombreux")
  hF = Fiche("15/06/2018")
  Reponses([])
  hF.gen_Inv()
  FinReponses("T15/gen")
  Inventaire("T15")
  Feuille(hF, "T15/feuille")
  Object.Lock(hF)

End
