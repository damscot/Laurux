Public Sub Achat_gotfocus(Value As Sailig)

  affstk()
  
  If Value.MonControle["Code"].hasfocus Then 
    Panel3.Y = tbl.Tableau.Y + Value.Y 
    Panel3.X = Value.MonControle["Code"].W + Value.MonControle["Rech"].W
    Panel3.Visible = True
  Else
    Panel3.Visible = False
  Endif

End

Public Sub Achat_lostfocus(Value As Sailig)

  affstk()

End

Private Sub affstk()
  
  Dim res, resc As Result
  Dim enco, qteac As Float
  
  Try res = tbl.ligne[tbl.ind].AutresObj[Achat.FicheArt]
  If Not IsNull(res) And If res.Available Then
    resc = Utils.db.Exec("SELECT SUM(qte) AS qte FROM Fiches_Ligcom WHERE code = &1", res!art_code)
    If IsNull(resc!qte) Then enco = 0 Else enco = resc!qte
    Encom.Text = "En commande : " & Str(Round(enco, -3))
    stmini.Text = "Stock mini : " & Str(res!art_stkmin)
    stmax.Text = "Stock maxi : " & Str(res!art_stkmax)
    comin.Text = "Commande minimum : " & res!art_mincom
    stk.Text = "Stock : " & Str(res!art_qte)
    qteac = res!art_stkmax - res!art_qte
    If Not IsNull(res!art_mincom) And If qteac < Val(res!art_mincom) Then qteac = Val(res!art_mincom)
    qtecom.Text = "Quantitée à commander : " & Str(qteac / CFloat(res!art_txconv))
  Endif
  
End
