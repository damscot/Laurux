' Gambas test file

''Tests de Tleg (.hidden/reference/.src/Gestion/Tables/Tleg.class/test.md, TLEG-T04).
''Écran instancié sans affichage (jeu tleg_shared/tleg_court : texte ABC), texte saisi dans Intitule puis Button2_Click
''(Enregistrer) ; lecture en facturation par un ObjFac instancié directement (option /Soc01/Conditions).
''Valeurs attendues : assets/TlegTest/expected.txt (clone de référence).

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T04LectureFacture", "Texte enregistré par Tleg (Button2) repris par ObjFac.treserve (Conditions vrai) ; faux : non lu")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "TlegTest")
  TestKit.OuvreBase("tleg_shared/tleg_court")
  Start.LocalSettings["/Coul/Znaff"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Focus"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Znss"] = "background: 16777215;"

End

Public Sub T04LectureFacture()

  Dim hForm As Object
  Dim hObj As ObjFac
  Dim rResult As Result

  hForm = New Tleg
  hForm.Form_Open()
  TestKit.Check("T04/avant", Object.GetProperty(hForm.Controls["Intitule"], "Text"))
  Object.SetProperty(hForm.Controls["Intitule"], "Text", "RESERVE DE PROPRIETE modifiee\nLigne 2 & suite")
  hForm.Button2_Click()
  rResult = Utils.db.Exec("SELECT lind, intitule FROM Fiches_Tleg ORDER BY lind")
  TestKit.Check("T04/table", rResult!lind & ":" & rResult!intitule & " (" & rResult.Count & ")")
  Object.Lock(hForm)
  Start.LocalSettings["/Soc" & Start.Societe & "/Conditions"] = True
  hObj = New ObjFac("B00001", ObjFac.bl, LDate(2018, 6, 15))
  TestKit.Check("T04/objfac_conditions", hObj.reserve & " / " & hObj.treserve)
  Start.LocalSettings["/Soc" & Start.Societe & "/Conditions"] = False
  hObj = New ObjFac("B00001", ObjFac.bl, LDate(2018, 6, 15))
  TestKit.Check("T04/objfac_sans_conditions", hObj.reserve & " / " & hObj.treserve)

End
