DROP TABLE IF EXISTS centralisation
CREATE TABLE centralisation(numrub Char(5) NOT NULL,intitrub Char(70),type Char(1),detail Char(1),compte Char(8),intitcpt Char(50),Col1 Char(12),Col2 Char(12),col3 Char(12),col4 Char(12),amortissement Tinyint(1),amortissement2 Tinyint(1),actif Tinyint(1),actif2 Tinyint(1),PRIMARY KEY (numrub, amortissement, amortissement2)) ENGINE = InnoDB
DROP TABLE IF EXISTS Comptes
CREATE TABLE Comptes(compte char(8) NOT NULL ,intitule VarCHAR(40) , solde Decimal(14,4) NOT NULL ,solde2 Decimal(14,4) NOT NULL ,annee char(2), numrub Char(5),intitrub VarCHAR(40) , type Char(1),detail char(1), Col1 Char(14),Col2 Char(14),col3 Char(14),col4 Char(14),amortissement Tinyint(1),amortissement2 Tinyint(1),actif Tinyint(1),actif2 Tinyint(1),PRIMARY KEY (compte)) ENGINE = InnoDB
