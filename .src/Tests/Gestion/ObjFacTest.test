' Gambas test file

''Tests d'ObjFac (.hidden/reference/.src/Gestion/Facturation/ObjFac.class/test.md, OBJFAC-T01 à T13, T16).
''Objet de facturation instancié directement (New ObjFac(num, choix, date)), sans l'écran Facture ; date du document
''figée au 15.06.2018. Jeu objfac_shared/facturation_base (clients 411801-411804, BL B10001-B10011, archives F00020/F00030).
''Options posées par Start.LocalSettings avant l'instanciation. Collections sérialisées triées par clé.
''Valeurs attendues : assets/ObjFacTest/expected.txt (clone de référence).

Private $sEvt As String
Private $hTimer As Timer
Private $hBox As Window
Private $sVu As String

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Options", "_new : lecture des options /Soc01/… (valeurs distinctes), devise, journal, sms lu sur /TxtF (A04)")
  TestKit.Desc("T02Recherche", "_new : recherche du document (BL, BlM, n° facture, archive HistoFac/HistoFacM, fin de mois, inconnu)")
  TestKit.Desc("T03FicheClient", "numcli : adresse, exemplaires, événements, échéance et texte de règlement selon le client ; client inexistant")
  TestKit.Desc("T04CalculBl", "calcul d'un BL simple : 2 articles (20 % et 2,10 %) + 1 MO, remise ligne")
  TestKit.Desc("T05TypesLignes", "calcul : lignes C multi-lignes, R, T (avec et sans ligne2), O (article composé), E/D/P")
  TestKit.Desc("T05bArticleInexistant", "calcul : article inexistant (A08) puis taux de ligne mtx_ligfac NULL (A09) : erreurs de calc figées")
  TestKit.Desc("T06Frais", "calcul : frais de gestion, client exonéré, auto-entrepreneur, les deux (A03 figée)")
  TestKit.Desc("T07Avoir", "calcul : BL négatif (libellés AVOIR) ; total en lettres (doclet, ligne TD)")
  TestKit.Desc("T08Archive", "calcul : facture archivée en Fiches_HistoFac et Fiches_HistoFacM")
  TestKit.Desc("T09FinMois", "calcul en fin de mois : table Bl de 2 BL, option nblfac ; client divers (nom)")
  TestKit.Desc("T10Ecotaxe", "Écotaxes HT et TTC (A01 figée), pxsdec, simpcond, remise ignorée sur BL")
  TestKit.Desc("T11CumulRemises", "Deux calcul successifs sur le même objet (fin de mois) : remart/remmo cumulés (A02 figée)")
  TestKit.Desc("T12EcritureCompt", "ecriturecompt sur une facture : Fiches_Mvt, Fiches_Bl (numfac, imp, reg), Fiches_Suivis")
  TestKit.Desc("T12bTicketNonMouline", "ecriturecompt sur un BL réglé par un ticket non mouliné : message (Timer), aucune écriture")
  TestKit.Desc("T12cCompteInexistant", "ecriturecompt pour un client sans compte (411803) : messages EcrAuto (Timer), écritures partielles dans Fiches_Mvt")
  TestKit.Desc("T13Origine", "FactType2Orig et Orig2FactType : énumérations, -1, 99, BL, Facture, x")
  TestKit.Desc("T15VerifDat", "verifdat : sans échéance, période close (messages par Timer), dtmouv vrai/faux, BL d'entretien (A06)")
  TestKit.Desc("T16Performance", "calcul d'un BL de 500 lignes : nombre de lignes et totaux (durée non comparée)")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "ObjFacTest")
  TestKit.OuvreBase("objfac_shared/facturation_base")
  $sEvt = ""

End

Public Sub _Obj_nombre(value As String)

  $sEvt &= "nombre(" & value & ") "

End

Public Sub _Obj_fttc(value As Boolean)

  $sEvt &= "fttc(" & value & ") "

End

Public Sub _Obj_echeance(value As LDate)

  $sEvt &= "echeance(" & value.L & ") "

End

Public Sub _Obj_modreg(value As String)

  $sEvt &= "modreg(" & value & ") "

End

Private Function Dte() As LDate

  Return LDate(2018, 6, 15)

End

Private Sub Opt(sCle As String, vVal As Variant)

  Start.LocalSettings["/Soc" & Start.Societe & "/" & sCle] = vVal

End

Private Function Trie(aLig As String[]) As String

  aLig.Sort()
  Return aLig.Join(" | ")

End

Private Sub Totaux(sCle As String, hObj As ObjFac)

  Dim hLig As Object
  Dim hTva As Object
  Dim hEcr As VarEcr
  Dim aLig As String[]

  TestKit.Check(sCle & "/montants", "ht=" & hObj.montht & " tva=" & hObj.monttva & " ttc=" & hObj.montttc & " art=" & hObj.montart & " mo=" & hObj.montmo & " remart=" & hObj.remart & " remmo=" & hObj.remmo & " gestion=" & hObj.gestion)
  aLig = New String[]
  If Object.IsValid(hObj.ligne) Then
    For Each hLig In hObj.ligne
      aLig.Add(hObj.ligne.Key & ":" & hLig.type & ":" & hLig.Index & ":" & hLig.code & ":" & hLig.libel & ":" & hLig.stk & ":" & hLig.unit & ":" & hLig.qte & ":" & hLig.puht & ":" & hLig.putc & ":" & hLig.brht & ":" & hLig.brtc & ":" & hLig.rem & ":" & hLig.neht & ":" & hLig.nettc & ":" & hLig.tx)
    Next
  Endif
  TestKit.Check(sCle & "/ligne", Trie(aLig))
  aLig = New String[]
  If Object.IsValid(hObj.tva) Then
    For Each hTva In hObj.tva
      aLig.Add(hObj.tva.Key & ":" & hTva.num & ":" & hTva.taux & ":" & hTva.totht & ":" & hTva.tottc & ":" & hTva.tottva)
    Next
  Endif
  TestKit.Check(sCle & "/tva", Trie(aLig))
  aLig = New String[]
  If Object.IsValid(hObj.ecrit) Then
    For Each hEcr In hObj.ecrit
      aLig.Add(hObj.ecrit.Key & ":" & hEcr.compte & ":" & hEcr.intitul & ":" & hEcr.libelle & ":" & hEcr.montantd & ":" & hEcr.montantc & ":" & hEcr.numdoc & ":" & IIf(Object.IsValid(hEcr.dte), hEcr.dte.L, "") & ":" & IIf(Object.IsValid(hEcr.dteech), hEcr.dteech.L, ""))
    Next
  Endif
  TestKit.Check(sCle & "/ecrit", Trie(aLig))
  TestKit.Check(sCle & "/eco", "tee=" & hObj.eco.tee & " tea=" & hObj.eco.tea)

End

Private Sub Calcule(sCle As String, sNum As String, iChoix As Integer)

  Dim hObj As ObjFac

  Try hObj = New ObjFac(sNum, iChoix, Dte())
  If Error Then
    TestKit.Check(sCle & "/new", "ERREUR: " & Error.Text)
    Return
  Endif
  Try hObj.calcul()
  TestKit.Check(sCle & "/erreur", IIf(Error, "ERREUR: " & Error.Text & " " & Error.Where, "<aucune>"))
  TestKit.Check(sCle & "/doc", "numbl=" & hObj.numbl & " numfac=" & hObj.numfac & " numcli=" & hObj.numcli & " tab=" & hObj.tab & " dtedoc=" & IIf(Object.IsValid(hObj.dtedoc), hObj.dtedoc.L, "") & " dteech=" & IIf(Object.IsValid(hObj.dteech), hObj.dteech.L, ""))
  Totaux(sCle, hObj)

End

Public Sub T01Options()

  Dim hObj As ObjFac
  Dim aCle As String[] = ["Recap", "Impttc", "Entete", "Conditions", "Pied", "Imp2L", "Col", "Impstocke", "ImpTotbl", "Poids", "TxtF", "Rglt", "Totstring", "Coupon", "Impbl", "AffArt", "AutoEnt", "Franchise", "Depots", "Prxdec", "Libdevis", "glogo3", "glogo", "Materiel", "Cheque", "Pdf5", "Pdf6", "AffClient", "Carte"]
  Dim i As Integer

  ' Booléens alternés (vrai pour les rangs pairs) ; /Sms faux pour distinguer A04
  For i = 0 To aCle.Max
    Opt(aCle[i], (i Mod 2) = 0)
  Next
  Opt("Sms", False)
  Opt("LTxtF", "Texte de reglement")
  Opt("Taxe", "TVA-T")
  Opt("Siret", "SIRET-T")
  Opt("Devis2", "Bas de devis")
  Opt("Devis", "Valable 30 jours")
  Opt("Factchemin", "/tmp/laurux-test/factures")
  Opt("FactcheminV", "/tmp/laurux-test/cgv.txt")
  Opt("Pdfchemin", "/tmp/laurux-test/joint.pdf")
  hObj = New ObjFac("B10001", ObjFac.bl, Dte())
  TestKit.Check("T01/booleens", "recap=" & hObj.recap & " ttc=" & hObj.ttc & " entete=" & hObj.entete & " reserve=" & hObj.reserve & " pied=" & hObj.pied & " ligne2=" & hObj.ligne2 & " colon=" & hObj.colon & " stock=" & hObj.Stock & " blrecap=" & hObj.blrecap & " poids=" & hObj.poids & " breg=" & hObj.breg & " saisreg=" & hObj.saisreg & " doclet=" & hObj.doclet & " coupon=" & hObj.coupon & " nblfac=" & hObj.nblfac & " affref=" & hObj.affref & " autoent=" & hObj.autoent & " franctva=" & hObj.franctva & " mdepo=" & hObj.mdepo & " pxsdec=" & hObj.pxsdec & " libdev=" & hObj.libdev & " adrlogo=" & hObj.adrlogo & " lgo=" & hObj.lgo & " gmateriel=" & hObj.gmateriel & " cheque=" & hObj.cheque & " joinfac=" & hObj.joinfac & " joinsms=" & hObj.joinsms & " affclient=" & hObj.AffClient & " intcheque=" & hObj.intcheque & " intcarte=" & hObj.intcarte & " sms=" & hObj.sms)
  TestKit.Check("T01/textes", "treg=" & hObj.treg & " treserve=" & Left(hObj.treserve, 30) & " tpied=" & IIf(Object.IsValid(hObj.tpied), hObj.tpied.Count, -1) & " libtaxe=" & hObj.libtaxe & " libsire=" & hObj.libsire & " txtlibdev=" & hObj.txtlibdev & " txtvldev=" & hObj.txtvldev & " pdfchemin=" & hObj.pdfchemin & " condvent=" & hObj.condvent & " pdf=" & hObj.pdf)
  TestKit.Check("T01/base", "devise=" & hObj.devise & " journal=" & hObj.journal & " choix=" & hObj.choix & " dtmouv=" & hObj.dtmouv & " blchif=" & hObj.blchif & " simpcond=" & hObj.simpcond)
  ' Options inversées : textes par défaut (Taxe, Siret vides), Libdevis faux, Conditions faux
  For i = 0 To aCle.Max
    Opt(aCle[i], (i Mod 2) = 1)
  Next
  Opt("Taxe", "")
  Opt("Siret", "")
  hObj = New ObjFac("B10001", ObjFac.finmois, Dte())
  TestKit.Check("T01/inverses", "recap=" & hObj.recap & " ttc=" & hObj.ttc & " reserve=" & hObj.reserve & " breg=" & hObj.breg & " treg=" & hObj.treg & " saisreg=" & hObj.saisreg & " libdev=" & hObj.libdev & " txtlibdev=" & hObj.txtlibdev & " libtaxe=" & hObj.libtaxe & " libsire=" & hObj.libsire & " sms=" & hObj.sms & " tab=" & hObj.tab)

End

Public Sub T02Recherche()

  Dim hObj As ObjFac
  Dim aCas As String[] = ["bl:B10001", "bl:B10007", "facture:F00010", "bl:XXXXXX", "archive:F00020", "archive:F00030", "archive:F99999", "finmois:", "finmois:M"]
  Dim sCas As String
  Dim aPart As String[]
  Dim iChoix As Integer

  For Each sCas In aCas
    aPart = Split(sCas, ":")
    Select Case aPart[0]
      Case "bl"
        iChoix = ObjFac.bl
      Case "facture"
        iChoix = ObjFac.facture
      Case "archive"
        iChoix = ObjFac.archive
      Case "finmois"
        iChoix = ObjFac.finmois
    End Select
    Try hObj = New ObjFac(aPart[1], iChoix, Dte())
    If Error Then
      TestKit.Check("T02/" & sCas, "ERREUR: " & Error.Text)
    Else
      TestKit.Check("T02/" & sCas, "numbl=" & hObj.numbl & " numfac=" & hObj.numfac & " tab=" & hObj.tab & " choix=" & hObj.choix)
    Endif
  Next

End

Private Sub Client(sCle As String, sNum As String, sCli As String, Optional bBreg As Boolean)

  Dim hObj As ObjFac

  Opt("TxtF", bBreg)
  Opt("LTxtF", "Texte de reglement des preferences")
  $sEvt = ""
  hObj = New ObjFac(sNum, ObjFac.bl, Dte()) As "_Obj"
  Try hObj.numcli = sCli
  If Error Then
    TestKit.Check(sCle & "/erreur", "ERREUR: " & Error.Text)
    Return
  Endif
  TestKit.Check(sCle & "/evenements", Trim($sEvt))
  TestKit.Check(sCle & "/exemplaires", hObj.nbexplemplaire)
  If Object.IsValid(hObj.adrfac) Then
    TestKit.Check(sCle & "/adrfac", hObj.adrfac.nom & "|" & hObj.adrfac.adr1 & "|" & hObj.adrfac.adr2 & "|" & hObj.adrfac.cp & "|" & hObj.adrfac.ville & "|" & hObj.adrfac.pays)
  Else
    TestKit.Check(sCle & "/adrfac", "<null>")
  Endif
  TestKit.Check(sCle & "/autoent", hObj.autoent)
  TestKit.Check(sCle & "/sauvpdf", hObj.sauvpdf)
  TestKit.Check(sCle & "/tsaisreg", hObj.tsaisreg)
  TestKit.Check(sCle & "/dteech", IIf(Object.IsValid(hObj.dteech), hObj.dteech.L, "<null>"))

End

