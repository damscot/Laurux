'***************************************************************************************************
'*               gestion du materiel
'***************************************************************************************************

Public Function ContMat() As Boolean            ''Si au moins une des lignes saisie concerne le materiel
  
  Dim lig As Sailig
  
  For Each lig In Me
    If lig.AutresObj[Materiel] Then Return True
  Next
  Return False
  
End

Public Sub CreMat() As Boolean             ''créer le tableau de saisie des n° de série
  
  Dim res As Result
  Dim lig As Sailig
  Dim obj As ObjProp
  Dim prop As New ObjProp[]
  Dim win As Window
  Dim sorti As Integer
  Dim pan As Panel
  Dim i As Integer
  Dim ch As Chainage
  
  Application.Busy = 0
  res = Utils.db.Exec("SELECT * FROM Fiches_Materiels LIMIT 1")
  win = CreFen(ByRef pan)
  win.Name = "mat"
  
  obj = New ObjProp(res.Fields["mat_code"], "Code")
  obj.AddChamp("MaxLenght", 15)
  obj.AddChamp("ReadOnly", True)
  obj.Height = win.Font.H + 4
  obj.Width = win.Font.Size * 12
  prop.Add(obj)
  
  obj = New ObjProp(res.Fields["mat_design"], "Désignation")
  obj.AddChamp("ReadOnly", True)
  obj.AddChamp("MaxLenght", 50)
  obj.Height = win.Font.H + 4
  obj.Width = win.Font.Size * 50
  prop.Add(obj)
  
  obj = New ObjProp(res.Fields["mat_serie"], "Série") As "serie"
  obj.Height = win.Font.H + 4
  obj.Width = win.Font.Size * 35
  obj.AddChamp("activescan", True)
  obj.AddChamp("MaxLenght", 30)
  prop.Add(obj)
  
  mat = New SaiTableau(prop, pan)
  mat.VisibleChoi = False
  mat.VisibleTot = False
  mat.VisibleTuto = False
  pan.Show
  mat.show
  ch = New Chainage([])
  For Each lig In Me
    If lig.AutresObj[Materiel] Then
      res = Utils.db.Exec("SELECT * FROM Fiches_Materiels WHERE mat_rcpt=&1 AND mat_four=&2  AND mat_code=&3", $ndoc, $fournisseur, lig.MonControle["Code"].Text)
      For i = 0 To lig.MonControle["Qte"].Value - 1
        mat.ajout()
        mat.ligne[mat.ind].Dernier = ""
        mat.ligne[mat.ind].chain.sup(mat.ligne[mat.ind].MonControle["Code"], 2)
        mat.ligne[mat.ind].MonControle["Code"].Text = lig.MonControle["Code"].Text
        mat.ligne[mat.ind].MonControle["Désignation"].Text = lig.MonControle["Désignation"].Text
        If res.Available Then
          If Not res.MoveTo(i) Then mat.ligne[mat.ind].MonControle["Série"].text = res!mat_serie
          If Not res.MoveTo(i) And If res!mat_vendu Then 
            mat.ligne[mat.ind].MonControle["Série"].Enabled = False
            mat.ligne[mat.ind].MonControle["Série"].tooltip = "matériel déjà vendu, modification impossible"
          Endif
          res.MoveFirst()
        Endif
        ch.add([mat.ligne[mat.ind].MonControle["Série"]])
        mat.ligne[mat.ind].Tag = mat.ligne[mat.ind].MonControle["Série"].text
      Next
    Endif
  Next
  sorti = win.Showmodal()
  If sorti = 0 Then 
    Application.Busy = 0
    Return False 
  Else 
    Return True
  Endif
  
End

Public Sub abandon_click()

  Application.Busy = 0
  Last.Tag.Close(0)

End

Public Sub valider_click()

  Dim lig, ligart As Sailig
  Dim res As Result
  Dim cde As String
  Dim ns As Boolean = True
  
  If Last.Tag.name = "mat" Then
    'Controle si on peut vaider
    For Each lig In mat
      If Not lig.MonControle["Série"].Text And ns Then
        If Message.Warning("Tous les n° de série ne sont pas renseignés\nVoulez vous continuer ?", "Oui", "Non") = 1 Then 
          ns = False
          Continue
        Else
          Return
        Endif
      Endif
      res = Utils.db.Exec("SELECT * FROM Fiches_Materiels WHERE mat_serie=&1 AND mat_code=&2 AND mat_rcpt <> &3", mat.ligne[mat.ind].MonControle["Série"].Text, mat.ligne[mat.ind].MonControle["Code"].Text, $ndoc)
      If res.Available Then
        Message.Warning("Validation impossible, le n° de série : " & mat.ligne[mat.ind].MonControle["Série"].Text & " existe déjà ", "Ok")
        Return
      Endif
    Next
    'on supprime les n° de cette commande
    For Each lig In mat
      res = Utils.db.Exec("SELECT * FROM Fiches_Materiels WHERE mat_serie=&1 AND mat_code=&2 AND mat_rcpt = &3", lig.Tag, lig.MonControle["Code"].Text, $ndoc)
      If res.Available And If Not res!mat_vendu Then
        Utils.db.Delete("Fiches_Materiels", "mat_rcpt=&1 AND mat_four=&2 AND mat_serie=&3 ", $ndoc, $fournisseur, lig.Tag)
      Endif
    Next
    'on créer les n° saisies
    For Each lig In mat
      If Not lig.MonControle["Série"].Text Or lig.MonControle["Série"].Enabled = False Then Continue
      If lig.MonControle["Code"].Text <> cde Then
        cde = lig.MonControle["Code"].Text 
        For Each ligart In Me
          If ligart.MonControle["Code"].Text = cde Then Break
        Next
      Endif
      res = Utils.db.Create("Fiches_Materiels")
      res!mat_serie = lig.MonControle["Série"].Text
      res!mat_code = lig.MonControle["Code"].Text
      res!mat_four = $fournisseur
      res!mat_design = ligart.MonControle["Désignation"].Text
      res!mat_design2 = ligart.AutresObj[FicheArt]["art_design2"]
      res!mat_paht = ligart.MonControle["Px_Net"].Value
      res!mat_frais = ligart.MonControle["Frais"].Value
      res!mat_prvt = ligart.MonControle["Px_Rev"].Value
      res!mat_cdarr = ligart.AutresObj[FicheArt]["art_cdarr"]
      res!mat_nbd = ligart.AutresObj[FicheArt]["art_nbd"]
      res!mat_dec = ligart.AutresObj[FicheArt]["art_dec"]
      res!mat_dfour = $fournisseur
      res!mat_dpa = ligart.AutresObj[FicheArt]["art_dpa"]
      res!mat_ddate = $dte.GnT
      res!mat_rcpt = $ndoc
      res!mat_dfour = $fournisseur
      res!mat_cequ = ligart.AutresObj[FicheArt]["art_cequ"]
      res!mat_cbarre = ligart.AutresObj[FicheArt]["art_cbarre"]
      res!mat_dpa = ligart.AutresObj[FicheArt]["art_dpa"]
      res!mat_eco = ligart.AutresObj[FicheArt]["art_eco"]
      res!mat_fam = ligart.AutresObj[FicheArt]["art_fam"]
      res!mat_qte = "1"
      res!mat_tva = ligart.AutresObj[FicheArt]["taux_tva"]
      res!mat_cequ = ligart.AutresObj[FicheArt]["art_cequ"]
      res!mat_coef = ligart.AutresObj[FicheArt]["art_coef"]
      res!mat_eco = ligart.AutresObj[FicheArt]["art_eco"]
      res!mat_poids = ligart.AutresObj[FicheArt]["art_poids"]
      res!mat_poids2 = ligart.AutresObj[FicheArt]["art_poids2"]
      res!mat_photo = ligart.AutresObj[FicheArt]["art_photo"]
      res!mat_crst = ligart.AutresObj[FicheArt]["art_crst"]
      res!mat_vendu = False
      res!mat_marque = ligart.AutresObj[FicheArt]["art_marque"]
      res.Update()
    Next
  Endif
  Last.Tag.Close(1)

End

Private Function CreFen(ByRef pan As Panel) As Window
  
  Dim pan1 As Panel
  Dim but As Button
  Dim win As Window
  
  win = New Window
  win.Border = False
  pan = New Panel(win)
  pan.Arrangement = Arrange.Vertical
  pan.Width = win.Font.Size * 97
  pan.Height = (win.Font.H + 4) * 28
  pan.X = 0
  pan.Y = 0
  win.Height = pan.Height + (win.Font.H + 4) * 2
  win.Width = pan.Width
  pan1 = New Panel(win)
  pan1.Arrangement = Arrange.Horizontal
  pan1.Width = win.Width
  pan1.Height = (win.Font.H + 4) * 2
  pan1.X = 0
  pan1.Y = pan.Height
  
  but = New Button(pan1) As "abandon"
  but.Expand = True
  but.Tag = win
  but.Text = "Abandon"
  but.Picture = Picture["Icones/exit.png"]
  but = New Button(pan1) As "valider"
  but.Expand = True
  but.Text = "Valider"
  but.Tag = win
  but.Picture = Picture["Icones/button_ok.png"]
  Return win

End 
'***************************************************************************************************
'Gestion des reliquats de commande
'***************************************************************************************************
Public Sub CreRec() As Boolean          ''ouvre la fenetre des réceptions et reliquats

  Dim lig As Sailig
  Dim obj As ObjProp
  Dim prop As New ObjProp[]
  Dim win As Window
  Dim sorti As Integer
  Dim pan As Panel
  Dim ch As Chainage
  Dim obs As Observer
  
  $reli = 2
  win = CreFen(ByRef pan)
  win.Name = "rec"
  
  obj = New ObjProp(Null, "Code")
  obj.AddChamp("MaxLenght", 15)
  obj.AddChamp("ReadOnly", True)
  obj.Height = win.Font.H + 4
  obj.Width = win.Font.Size * 12
  prop.Add(obj)
  
  obj = New ObjProp(Null, "Désignation")
  obj.AddChamp("ReadOnly", True)
  obj.AddChamp("MaxLenght", 50)
  obj.Height = win.Font.H + 4
  obj.Width = win.Font.Size * 39
  prop.Add(obj)
  
  obj = New ObjProp(Null, "Qte_Comm") 
  obj.Height = win.Font.H + 4
  obj.Width = win.Font.Size * 15
  obj.AddChamp("Type", TextReg.EstNum)
  obj.AddChamp("ReadOnly", True)
  prop.Add(obj)
  
  obj = New ObjProp(Null, "Qte_Reçu") 
  obj.Height = win.Font.H + 4
  obj.Width = win.Font.Size * 15
  obj.AddChamp("Type", TextReg.EstNum)
  prop.Add(obj)
  
  obj = New ObjProp(Null, "Reliquat") 
  obj.Height = win.Font.H + 4
  obj.Width = win.Font.Size * 15
  obj.AddChamp("Type", TextReg.EstNum)
  obj.AddChamp("ReadOnly", True)
  prop.Add(obj)
  
  rec = New SaiTableau(prop, pan)
  rec.VisibleChoi = False
  rec.VisibleTot = False
  rec.VisibleTuto = False
  pan.Show
  rec.show
  ch = New Chainage([])
  Me.Netoyage("Code")
 
  For Each lig In Me 
    rec.ajout()
    rec.ligne[rec.ind].AutresObj = New Variant[RelFin]
    rec.ligne[rec.ind].Dernier = ""
    rec.ligne[rec.ind].chain.sup(rec.ligne[rec.ind].MonControle["Code"], 3)
    rec.ligne[rec.ind].MonControle["Code"].Text = lig.MonControle["Code"].Text
    rec.ligne[rec.ind].AutresObj[RelArt] = lig.MonControle["Code"].Text
    rec.ligne[rec.ind].MonControle["Désignation"].Text = lig.MonControle["Désignation"].Text
    rec.ligne[rec.ind].MonControle["Qte_Comm"].Text = lig.MonControle["Qte"].Text
    rec.ligne[rec.ind].MonControle["Qte_Comm"].nbdec = lig.AutresObj[FicheArt]!art_dec
    obs = New Observer(rec.ligne[rec.ind].MonControle["Qte_Comm"]) As "Reliquat"
    rec.ligne[rec.ind].MonControle["Qte_Reçu"].text = lig.MonControle["Qte"].Text
    rec.ligne[rec.ind].MonControle["Qte_Reçu"].nbdec = lig.AutresObj[FicheArt]!art_dec
    obs = New Observer(rec.ligne[rec.ind].MonControle["Qte_Reçu"]) As "Reliquat"
    rec.ligne[rec.ind].MonControle["Reliquat"].Value = 0
    rec.ligne[rec.ind].AutresObj[RelQte] = 0
    rec.ligne[rec.ind].MonControle["Reliquat"].nbdec = lig.AutresObj[FicheArt]!art_dec
    ch.add([rec.ligne[rec.ind].MonControle["Qte_Reçu"]])
  Next
  sorti = win.Showmodal()
  If sorti = 0 Then Return False 
  For Each lig In Me
    lig.MonControle["Qte"].Text = rec.ligne[lig.Ind].MonControle["Qte_Reçu"].Text
    Try lig.AutresObj[Achat.Consignes].ccd.qte = rec.ligne[lig.Ind].MonControle["Qte_Reçu"].Value
    Me.ind = lig.Ind
    calcul
  Next
  For Each lig In rec
    If lig.MonControle["Reliquat"].Value > 0 Then
      Application.Busy = 0
      $reli = Message.Question("Voulez vous générer une commande de reliquat ?", "Oui", "Non")
      Application.Busy = 1
      Break
    Endif
  Next
  Return True

End

Public Sub Reliquat_lostfocus()

  rec.ligne[rec.ind].MonControle["Reliquat"].Value = rec.ligne[rec.ind].MonControle["Qte_Comm"].Value - rec.ligne[rec.ind].MonControle["Qte_Reçu"].Value
  rec.ligne[rec.ind].AutresObj[RelQte] = rec.ligne[rec.ind].MonControle["Reliquat"].Value

End

Public Sub CreReliquat() As Boolean    ''Creer et affiche la commande de reliquat 
  
  Dim lig As Sailig
  
  If $reli = 2 Then Return False
  For Each lig In rec
    If lig.AutresObj[RelQte] > 0 Then
      $etat = achat.CreaCommande
      ajout()
      Me.ligne[Me.ind].MonControle["Qte"].Value = lig.AutresObj[RelQte] 
      ligne_LecCode(lig.AutresObj[RelArt])
    Endif
  Next
  Return True
  
End
