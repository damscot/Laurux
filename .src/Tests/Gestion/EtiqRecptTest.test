' Gambas test file

''Tests de EtiqRecpt (.hidden/reference/.src/Gestion/Etiquettes/EtiqRecpt.class/test.md, ETIQRECPT-T01).
''Valeurs attendues : assets/EtiqRecptTest/expected.txt, produites dans le clone de référence.
''La fenêtre est instanciée sans être affichée (_New calcule les compteurs) ; en fin de test, ses événements sont verrouillés.

Public Sub _Desc()
  ''Descriptions des tests du module (./Laurux -T list) ; ignoré par gb.test.

  TestKit.Desc("T01Compteurs", "Ouverture avec files de 3 lignes produits (4 étiquettes) et 2 lignes gondoles (3) : Nbetip, Nbetic, Nbetig")

End

Public Sub _Setup()

  TestKit.Begin("Gestion", "EtiqRecptTest")
  TestKit.OuvreBase("etiqrecpt_shared/etiqrecpt_base")

End

Public Sub T01Compteurs()

  Dim hF As EtiqRecpt

  ' Couleurs absentes de Laurux-test.conf : Val("") donnerait Null dans _New (Type mismatch)
  Start.LocalSettings["/Coul/Znaff"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Focus"] = "background: 16777215;"
  Start.LocalSettings["/Coul/Znss"] = "background: 16777215;"
  Try hF = New EtiqRecpt
  If Error Then
    TestKit.Check("T01/_new", "ERREUR: " & Error.Text & " " & Error.Where)
    Return
  Endif
  TestKit.Check("T01/Nbetip", Object.GetProperty(hF.Controls["Nbetip"], "Text"))
  TestKit.Check("T01/Nbetic", Object.GetProperty(hF.Controls["Nbetic"], "Text"))
  TestKit.Check("T01/Nbetig", Object.GetProperty(hF.Controls["Nbetig"], "Text"))
  TestKit.Check("T01/Codetiq.Count", Object.GetProperty(hF.Controls["Codetiq"], "Count"))
  Object.Lock(hF)

End
