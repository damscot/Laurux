SELECT  montantd,montantc,dte,compte,libelle,intitule,numero,jour,numdoc,tresorerie,lettree,pointee,CASE WHEN pointee=True THEN 'O' ELSE 'n' END AS parse_having_P,cloturee,dateech,collectif,numlot,relance,lind,nrlv ,Case WHEN lettree = 1 Then '&HDFFFBF' WHEN pointee = 1 Then '&HFFDFBF' WHEN cloturee = 1 Then '&H808080' WHEN provisoire = 1 Then '&HFFFFDC' ELSE '&HFFFFFF&' END as bgcolor FROM Fiches_Mvt1 WHERE dte BETWEEN '2017-06-01' AND '2017-12-31 23:59:59' AND provisoire=False  AND compte='411001'  AND lettree='0' AND jour<>'90' UNION (SELECT montantd,montantc,dte,compte,libelle,intitule,numero,jour,numdoc,tresorerie,lettree,pointee,CASE WHEN pointee=True THEN 'O' ELSE 'n' END AS parse_having_P,cloturee,dateech,collectif,numlot,relance,lind,nrlv ,Case WHEN lettree = 1 Then '&HDFFFBF' WHEN pointee = 1 Then '&HFFDFBF' WHEN cloturee = 1 Then '&H808080' WHEN provisoire = 1 Then '&HFFFFDC' ELSE '&HC0C0C0' END as bgcolor FROM Fiches_Mvt WHERE dte BETWEEN '2017-06-01' AND '2018-06-15 23:59:59' AND provisoire=False  AND  compte='411001'  AND lettree='0' AND jour<>'90'  AND jour<>'90') ORDER BY  dte asc
