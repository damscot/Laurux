+Private Function Home_Test() As String
+  ''Crée un HOME de test neuf et vide, toujours sous /tmp/laurux-test/ (mktemp -d : nom unique, jamais un chemin
+  ''fourni de l'extérieur), avec ~/tmp, ~/.config/gambas3 (présents chez tout utilisateur de Laurux) et le marqueur
+  ''.laurux-test-home ; renvoie son chemin. User.Home y est redirigé par Env_Home (libhome, LD_PRELOAD) : le verrou
+  ''Laurux.lock, ~/tmp, ~/.config, la GED ou les journaux d'un test ne touchent jamais le HOME réel.
+
+  Dim sDir As String
+
+  Shell "mkdir -p /tmp/laurux-test && mktemp -d /tmp/laurux-test/home-XXXXXXXX" To sDir
+  sDir = Trim(sDir)
+  If Not (sDir Begins "/tmp/laurux-test/home-") Or If Not IsDir(sDir) Then Error.Raise("HOME de test non créé : " & sDir)
+  Mkdir sDir &/ "tmp"
+  Mkdir sDir &/ ".config"
+  Mkdir sDir &/ ".config/gambas3"
+  Mkdir sDir &/ "run"
+  Chmod sDir &/ "run" To "rwx------"
+  File.Save(sDir &/ ".laurux-test-home", "HOME de test créé par Laurux -T ; supprimé à la fin du test\n")
+  Return sDir
+
+End
+
+Private Function Env_Home(sRoot As String, sHome As String) As String
+  ''Préfixe « env … » qui fait de sHome le HOME du processus lancé, et de « laurux » son utilisateur (comme dans le
+  ''conteneur runner) : HOME et User.Home/User.Name de Gambas, lus dans la base des
+  ''comptes : bibliothèque .src/Tests/Framework/libhome/libhome.c chargée par LD_PRELOAD, compilée au besoin dans
+  ''/tmp/laurux-test/). Sans gcc ni bibliothèque : HOME seul, avec un avertissement.
+
+  Static sLib As String
+  Dim sSource As String = sRoot &/ ".src/Tests/Framework/libhome/libhome.c"
+  Dim sCible As String = "/tmp/laurux-test/libhome-" & User.Id & ".so"
+  Dim sPrecharge As String
+
+  If Not sLib Then
+    If Exist(sSource) Then
+      If Not Exist(sCible) Or If Stat(sSource).LastModified > Stat(sCible).LastModified Then
+        Shell "mkdir -p /tmp/laurux-test && gcc -shared -fPIC -O2 -o " & Shell$(sCible) & " " & Shell$(sSource) & " -ldl" Wait
+      Endif
+    Endif
+    If Exist(sCible) Then
+      sLib = sCible
+    Else
+      Print "Avertissement : bibliothèque libhome indisponible (gcc ?) : User.Home reste le HOME réel"
+      sLib = "-"
+    Endif
+  Endif
+  sPrecharge = Application.Env["LD_PRELOAD"]
+  If sLib = "-" Then Return "env HOME=" & Shell$(sHome) & " XDG_RUNTIME_DIR=" & Shell$(sHome &/ "run") & " GIO_USE_VFS=local GVFS_DISABLE_FUSE=1 GTK_USE_PORTAL=0 QT_NO_XDG_DESKTOP_PORTAL=1"
+  Return "env HOME=" & Shell$(sHome) & " XDG_RUNTIME_DIR=" & Shell$(sHome &/ "run") & " GIO_USE_VFS=local GVFS_DISABLE_FUSE=1 GTK_USE_PORTAL=0 QT_NO_XDG_DESKTOP_PORTAL=1 LAURUX_TEST_HOME=" & Shell$(sHome) & " LAURUX_TEST_USER=laurux USER=laurux LD_PRELOAD=" & Shell$(sLib & IIf(sPrecharge, ":" & sPrecharge, ""))
+
+End
+
+Private Function Lance_Surveille(sCmd As String, sDir As String, sNom As String, sMotif As String, iCodeMotif As Integer, sMessage As String) As Integer
+  ''Lance sCmd (commande shell) dans sa propre session (setsid) par le script sDir/<sNom>.sh et renvoie son code :
+  ''- la console est écrite dans sDir/console.txt et suivie par tail (affichée au fil de l'eau ; aucun tube que des
+  ''  processus restants garderaient ouvert) ;
+  ''- si la console contient le motif grep sMotif (boîte d'erreur Gambas modale qui bloquerait), tout le groupe est
+  ''  tué 2 s après et le code est iCodeMotif (message sMessage) ;
+  ''- à la fin, toute la session est tuée (pkill -s : y compris le groupe propre créé par « timeout » ; Laurux
+  ''  intercepte SIGTERM, « timeout » seul le laisserait vivant) ;
+  ''- Ctrl+C / SIGTERM reçu par le script : le groupe est tué, code 130.
+
+  Dim aScript As New String[]
+
+  aScript.Add("#!/bin/bash")
+  aScript.Add("# Généré par Laurux -T (Start.Lance_Surveille)")
+  aScript.Add("OUT=" & Shell$(sDir))
+  aScript.Add(": > \"$OUT/console.txt\"; rm -f \"$OUT/.motif\"")
+  aScript.Add("setsid bash -c " & Shell$(sCmd) & " > \"$OUT/console.txt\" 2>&1 < /dev/null &")
+  aScript.Add("pid=$!")
+  aScript.Add("trap 'pkill -KILL -s $pid 2>/dev/null; exit 130' INT TERM")
+  aScript.Add("( tail -n +1 -f --pid=$pid \"$OUT/console.txt\" | grep -m1 -q " & sMotif & " && sleep 2 && touch \"$OUT/.motif\" && pkill -KILL -s $pid ) 2>/dev/null &")
+  aScript.Add("veille=$!")
+  aScript.Add("tail -n +1 -f --pid=$pid \"$OUT/console.txt\"")
+  aScript.Add("wait $pid; rc=$?")
+  aScript.Add("pkill -KILL -s $pid 2>/dev/null  # toute la session : timeout crée son propre groupe de processus")
+  aScript.Add("kill $veille 2>/dev/null")
+  aScript.Add("if [ -e \"$OUT/.motif\" ]; then rc=" & iCodeMotif & "; rm -f \"$OUT/.motif\"; echo " & Shell$("[" & sMessage & "]") & " | tee -a \"$OUT/console.txt\"; fi")
+  aScript.Add("exit $rc")
+  File.Save(sDir &/ sNom & ".sh", aScript.Join("\n") & "\n")
+  Shell "bash " & Shell$(sDir &/ sNom & ".sh") Wait
+  Return Process.LastValue
+
+End
+
+Private Function Bus_Prive() As String
+  ''« dbus-run-session -- » (s'il est installé) : bus de session D-Bus privé, arrêté à la fin du processus lancé. Sans
+  ''lui, Qt/gb.desktop démarrent un bus (dbus-launch --autolaunch) qui survit au test et écrit dans son HOME.
+
+  If System.Find("dbus-run-session") Then Return "dbus-run-session -- "
+  Return ""
+
+End
+
+Private Sub Fin_Home(sHome As String)
+  ''Suppression du HOME de test créé par Home_Test, après chaque test gb.test (Run_Tests) et après chaque rejeu de
+  ''scénario (Run_Scenario), réussi ou non ; LAURUX_TEST_GARDER=1 le conserve (débogage : chemin affiché).
+  ''Garde-fous, tous requis, sinon rien n'est supprimé (message « garde-fou ») :
+  ''1. chemin de la forme /tmp/laurux-test/home-<nom> (un seul niveau, sans « .. ») ;
+  ''2. répertoire réel, pas un lien symbolique ; chemin résolu (realpath) de la même forme ;
+  ''3. ni « / », ni le HOME réel de l'utilisateur (lu sans libhome), ni un parent de celui-ci ;
+  ''4. marqueur .laurux-test-home (fichier) présent.
+  ''Puis démontage paresseux des points de montage FUSE situés dessous (lus dans /proc/mounts) et rm -rf limité
+  ''au système de fichiers du HOME de test (--one-file-system).
+
+  Dim sResolu, sReel, sMontages, sLigne, sPoint, sNom As String
+  Dim aChamps As String[]
+
+  If Application.Env["LAURUX_TEST_GARDER"] = "1" Then
+    Print "# HOME de test conservé : " & sHome
+    Return
+  Endif
+  ' 1. forme du chemin
+  sNom = Mid(sHome, Len("/tmp/laurux-test/home-") + 1)
+  If Not (sHome Begins "/tmp/laurux-test/home-") Or If Not sNom Or If InStr(sNom, "/") Or If InStr(sHome, "..") Then
+    Print "# HOME de test non supprimé (garde-fou : chemin) : " & sHome
+    Return
+  Endif
+  ' 2. répertoire réel, chemin résolu de la même forme
+  If Not Exist(sHome) Then Return
+  If Stat(sHome).Type <> gb.Directory Then
+    Print "# HOME de test non supprimé (garde-fou : pas un répertoire ou lien symbolique) : " & sHome
+    Return
+  Endif
+  Shell "realpath -e -- " & Shell$(sHome) To sResolu
+  sResolu = Trim(sResolu)
+  If sResolu <> sHome Then
+    Print "# HOME de test non supprimé (garde-fou : chemin résolu " & sResolu & ") : " & sHome
+    Return
+  Endif
+  ' 3. ni « / » ni le HOME réel (base des comptes lue sans la bibliothèque libhome) ni un de ses parents
+  Shell "env -u LD_PRELOAD getent passwd " & CStr(User.Id) & " | cut -d: -f6 | xargs -r realpath -e --" To sReel
+  sReel = Trim(sReel)
+  If sResolu = "/" Or If Not sReel Or If sResolu = sReel Or If sReel Begins sResolu & "/" Then
+    Print "# HOME de test non supprimé (garde-fou : HOME réel « " & sReel & " ») : " & sHome
+    Return
+  Endif
+  ' 4. marqueur posé par Home_Test
+  If Not Exist(sResolu &/ ".laurux-test-home") Or If Stat(sResolu &/ ".laurux-test-home").Type <> gb.File Then
+    Print "# HOME de test non supprimé (garde-fou : marqueur absent) : " & sHome
+    Return
+  Endif
+  ' points de montage FUSE éventuels sous le HOME de test (portail de documents, gvfs) : démontage paresseux
+  Shell "cat /proc/mounts" To sMontages
+  For Each sLigne In Split(sMontages, "\n")
+    aChamps = Split(sLigne, " ")
+    If aChamps.Count < 2 Then Continue
+    sPoint = Replace(aChamps[1], "\\040", " ")
+    If sPoint Begins sResolu & "/" Then Shell "fusermount3 -u -z " & Shell$(sPoint) & " 2>/dev/null" Wait
+  Next
+  Shell "rm -rf --one-file-system -- " & Shell$(sResolu) Wait
+
+End
+
+Private Function Run_Scenario(sRoot As String, sSpec As String, Optional sId As String) As Boolean
+  ''Rejoue le scénario GUI <lot>/<nom> (.hidden/Tests/<lot>/assets/<nom>/ : scenario.log, meta.json) et renvoie
+  ''True si le code de sortie du rejeu est celui attendu (« code_sortie » de meta.json, défaut 0).
+  ''1. supprime les bases autres que Laurux01 (serveur marqué comme serveur de test seulement, TestKit.NettoieBases),
+  ''   restaure Laurux01.sql puis le jeu « dataset » (assets du scénario, voir TestKit.JeuDeDonnees) sur la base de test
+  ''   $LAURUX_TEST_DB_HOST:$LAURUX_TEST_DB_PORT (défaut 127.0.0.1:13306), utilisateur laurux ;
+  ''2. prépare la configuration (Laurux-test.conf, hôte et port réécrits, clés « conf » de meta.json
+  ''   {"/section/clé": valeur} appliquées par-dessus, « {ftp} » y étant remplacé par l'URL du faux serveur FTP
+  ''   lancé si meta.json porte « ftp » : "ok" | "refus" | "absent", voir TestKit.FtpFactice ; « {home} » et
+  ''   « {out} » y sont remplacés par le HOME de test du fils et le répertoire de sortie ; fichiers reçus dans
+  ''   ftp/, commandes dans ftp.trace), copie les fichiers d'entrée du
+  ''   scénario dans /tmp/laurux-test/ (même chemin sur le poste et dans le conteneur), place les enveloppes
+  ''   mysql/mysqldump de Framework/bin en tête du PATH, dirige Desktop.Open vers laurux-ouvrir
+  ''   (TestKit.OuvertureFactice, trace dans ouvrir.trace), remplace les outils externes sans effet sur Laurux
+  ''   (clients mail, synthèse vocale, gammu, wput… : faux programmes de Framework/bin, trace dans outils.trace) ;
+  ''3. lance un processus Laurux fils « -r --replay-exit » avec la société et les « args » du scénario, sous
+  ''   « faketime » à la « date » du scénario si faketime est installé (Gambas ne peut pas décaler sa propre
+  ''   horloge), limité par « timeout » (20 s, davantage seulement avec « timeout_accord ») ;
+  ''4. écrit dans $LAURUX_TEST_OUT, sinon output/tests/<lot>_<nom>_<date>/ : rejeu.sh (lancement), console.txt,
+  ''   replay.log(.out), sql.log (requêtes Exec_SQL), dump.sql (mariadb-dump brut), dump_<base>.sql pour chaque base
+  ''   de « bases » (meta.json), fichiers/<chemin> pour chaque fichier de « fichiers » (meta.json : chemin relatif
+  ''   au HOME de test du fils, ou « @<nom> » pour un fichier de la sortie, ex. @Laurux.conf, @ouvrir.trace ;
+  ''   « <fichier absent> » s'il n'existe pas), exit_code.
+  ''   Erreur non interceptée (boîte d'erreur Gambas) : rejeu arrêté, code 125 ; délai dépassé : code 124.
+  ''Le processus -T ne pose pas le verrou ~/Laurux.lock : seul le fils le pose.
+
+  Dim sLot As String = Split(sSpec, "/")[0]
+  Dim sNom As String = Split(sSpec, "/")[1]
+  Dim sDir As String = sRoot &/ ".hidden/Tests" &/ sLot &/ "assets" &/ sNom
+  Dim cMeta As Collection
+  Dim sOut, sHost, sPort, sCnx, sConf, sCmd, sFic, sLigne, sExe, sDataset, sJournal, sHome As String
+  Dim aConf As New String[]
+  Dim aSql As New String[]
+  Dim vArg As Variant
+  Dim iTimeout, iCode, iAttendu, iPos, iChamp As Integer
+  Dim hConf As Settings
+  Dim sSrc, sDst, sFtp As String
+
+  cMeta = JSON.Decode(File.Load(sDir &/ "meta.json"))
+  sOut = Application.Env["LAURUX_TEST_OUT"]
+  If Not sOut Then sOut = sRoot &/ "output/tests" &/ sLot & "_" & sNom & "_" & Format(Now, "yyyymmdd-hhnnss")
+  Shell "mkdir -p " & Shell$(sOut) Wait
+  sHost = Application.Env["LAURUX_TEST_DB_HOST"]
+  If Not sHost Then sHost = "127.0.0.1"
+  sPort = Application.Env["LAURUX_TEST_DB_PORT"]
+  If Not sPort Then sPort = "13306"
+  ' 1. base de test
+  If TestKit.ServeurTest() Then
+    Print "Rejeu " & sSpec & " : " & TestKit.ServeurTest()
+    Return False
+  Endif
+  TestKit.NettoieBases(sHost, sPort, "Laurux01")
+  sCnx = "/usr/bin/mariadb -h " & Shell$(sHost) & " -P " & Shell$(sPort) & " -u laurux -plaurux "
+  Shell sCnx & "-e " & Shell$("DROP DATABASE IF EXISTS Laurux01; CREATE DATABASE Laurux01 CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;") & " && " & sCnx & "Laurux01 < " & Shell$(sRoot &/ "Laurux01.sql") Wait
+  If Process.LastValue <> 0 Then
+    Print "Rejeu " & sSpec & " : restauration de la base de test impossible (" & sHost & ":" & sPort & ")"
+    Return False
+  Endif
+  If cMeta.Exist("dataset") And If cMeta["dataset"] Then
+    sDataset = TestKit.JeuDeDonnees(sRoot, cMeta["dataset"], sLot, sNom)
+    Shell sCnx & "Laurux01 < " & Shell$(sDataset) Wait
+    If Process.LastValue <> 0 Then
+      Print "Rejeu " & sSpec & " : jeu de données non chargé (" & sDataset & ")"
+      Return False
+    Endif
+  Endif
+  sExe = Application.Path &/ Application.Name
+  If Not Exist(sExe) Or If IsDir(sExe) Then
+    Print "Rejeu " & sSpec & " : exécutable " & sExe & " introuvable (lancer l'archive Laurux : ./Laurux -T …)"
+    Return False
+  Endif
+  ' HOME de test du fils, créé avant la configuration (marqueur {home} des valeurs de « conf »)
+  sHome = Home_Test()
+  File.Save(sOut &/ "home.txt", sHome & "\n") ' HOME de test du fils (conservé avec LAURUX_TEST_GARDER=1)
+  ' 2. configuration, fichiers d'entrée, journal à rejouer
+  sConf = sOut &/ "Laurux.conf"
+  For Each sLigne In Split(File.Load(sRoot &/ ".src/Tests/Framework/Laurux-test.conf"), "\n")
+    If sLigne Begins "Host=" Then
+      sLigne = "Host=\"" & sHost & "\""
+    Else If sLigne Begins "Port=" Then
+      sLigne = "Port=\"" & sPort & "\""
+    Endif
+    aConf.Add(sLigne)
+  Next
+  File.Save(sConf, aConf.Join("\n"))
+  If cMeta.Exist("ftp") And If cMeta["ftp"] Then ' faux serveur FTP (FtpClient, wput)
+    Try Shell "rm -rf " & Shell$(sOut &/ "ftp") & " " & Shell$(sOut &/ "ftp.trace") Wait
+    sFtp = TestKit.FtpFactice(CStr(cMeta["ftp"]), sOut &/ "ftp")
+  Endif
+  If cMeta.Exist("conf") And If cMeta["conf"] Then ' surcharge propre au scénario : {"/section/clé": valeur}
+    hConf = New Settings(sConf)
+    For Each vArg In cMeta["conf"]
+      If TypeOf(vArg) = gb.String Then ' marqueurs : {ftp} URL du faux serveur, {home} HOME de test, {out} sorties
+        If sFtp Then vArg = Replace(vArg, "{ftp}", sFtp)
+        vArg = Replace(Replace(vArg, "{home}", sHome), "{out}", sOut)
+      Endif
+      hConf[cMeta["conf"].Key] = vArg
+    Next
+    hConf.Save()
+  Endif
+  Shell "mkdir -p /tmp/laurux-test" Wait
+  For Each sFic In Dir(sDir, "*", gb.File)
+    If sFic = "scenario.log" Or If sFic = "meta.json" Then Continue
+    Try Kill "/tmp/laurux-test" &/ sFic
+    Copy sDir &/ sFic To "/tmp/laurux-test" &/ sFic
+  Next
+  Try Kill sOut &/ "replay.log"
+  Try Kill sOut &/ "replay.log.out"
+  Copy sDir &/ "scenario.log" To sOut &/ "replay.log"
+  ' 3. processus Laurux fils
+  iTimeout = 20
+  If cMeta.Exist("timeout") Then
+    If cMeta["timeout"] > 20 And If Not cMeta["timeout_accord"] Then
+      Print "Rejeu " & sSpec & " : timeout " & cMeta["timeout"] & " s sans « timeout_accord », ramené à 20 s"
+    Else
+      iTimeout = cMeta["timeout"]
+    Endif
+  Endif
+  ' Desktop.Open du fils : faux programme laurux-ouvrir (XDG temporaires, portail désactivé), trace dans sOut
+  TestKit.OuvertureFactice(sOut &/ "ouvrir.trace")
+  sCmd = Env_Home(sRoot, sHome) & " PATH=" & Shell$(sRoot &/ ".src/Tests/Framework/bin" & ":" & Application.Env["PATH"])
+  sCmd &= " LAURUX_TEST_DB_HOST=" & Shell$(sHost) & " LAURUX_TEST_DB_PORT=" & Shell$(sPort)
+  sCmd &= " LAURUX_FACTICE_TRACE=" & Shell$(sOut &/ "outils.trace") ' outils externes factices de Framework/bin
+  sCmd &= " GB_DESKTOP_PORTAL_ENABLED=0 SDL_AUDIODRIVER=dummy " & Bus_Prive() & "timeout -k 2 " & iTimeout & " "
+  If cMeta.Exist("date") And If cMeta["date"] And If System.Find("faketime") Then
+    sCmd &= "faketime -f " & Shell$("@" & cMeta["date"]) & " "
+  Endif
+  sCmd &= Shell$(sExe) & " -c " & Shell$(sConf) & " -l --logfile " & Shell$(sOut &/ "replay.log") & " -r --replay-exit"
+  If cMeta.Exist("societe") And If cMeta["societe"] Then
+    sCmd &= " -s " & Shell$(cMeta["societe"])
   Else
-    Print "!!!!!!!!!!!!!!!!!!!!!!!!!!!!!"
+    sCmd &= " -s 01"
   Endif
-  
-  Utils.Exit(success)
-  
+  If cMeta.Exist("args") And If cMeta["args"] Then
+    For Each vArg In cMeta["args"]
+      sCmd &= " " & Shell$(CStr(vArg))
+    Next
+  Endif
+  Print "Rejeu " & sSpec & " : " & sCmd
+  ' erreur non interceptée (« Classe.Méthode.ligne: … » puis boîte d'erreur Gambas modale) : arrêt, code 125
+  iCode = Lance_Surveille(sCmd, sOut, "rejeu", "-E '\\.[A-Za-z_][A-Za-z0-9_:]*\\.[0-9]+: '", 125, "erreur fatale : boîte d'erreur Gambas, rejeu arrêté")
+  If iCode = 130 Then Test_Interrompu = True ' Ctrl+C pendant le rejeu (trap du script)
+  TestKit.FinFtp()
+  File.Save(sOut &/ "exit_code", CStr(iCode) & "\n")
+  ' 4. sorties : requêtes Exec_SQL du journal rejoué, dump brut de la base
+  sJournal = sOut &/ "replay.log.out"
+  If Not Exist(sJournal) Then sJournal = sOut &/ "replay.log"
+  For Each sLigne In Split(File.Load(sJournal), "\n")
+    iPos = 0
+    For iChamp = 1 To 8
+      iPos = InStr(sLigne, ";", iPos + 1)
+      If iPos = 0 Then Break
+    Next
+    If iPos = 0 Then Continue
+    If Split(sLigne, ";")[2] = "Exec_SQL" Then aSql.Add(Mid(sLigne, iPos + 1))
+  Next
+  File.Save(sOut &/ "sql.log", aSql.Join("\n") & "\n")
+  Shell "/usr/bin/mariadb-dump -h " & Shell$(sHost) & " -P " & Shell$(sPort) & " -u laurux -plaurux --skip-dump-date --skip-comments Laurux01 > " & Shell$(sOut &/ "dump.sql") Wait
+  If cMeta.Exist("bases") And If cMeta["bases"] Then ' bases supplémentaires créées ou modifiées par le scénario
+    For Each vArg In cMeta["bases"]
+      Shell "/usr/bin/mariadb-dump -h " & Shell$(sHost) & " -P " & Shell$(sPort) & " -u laurux -plaurux --skip-dump-date --skip-comments " & Shell$(CStr(vArg)) & " > " & Shell$(sOut &/ "dump_" & CStr(vArg) & ".sql") & " 2>/dev/null" Wait
+    Next
+  Endif
+  If cMeta.Exist("fichiers") And If cMeta["fichiers"] Then ' fichiers produits à comparer (avant Fin_Home)
+    Try Shell "rm -rf " & Shell$(sOut &/ "fichiers") Wait
+    For Each vArg In cMeta["fichiers"]
+      sFic = CStr(vArg)
+      If sFic Begins "/" Or If InStr(sFic, "..") Then
+        Print "Rejeu " & sSpec & " : fichier « " & sFic & " » ignoré (chemin relatif sans « .. » attendu)"
+        Continue
+      Endif
+      If sFic Begins "@" Then
+        sFic = Mid(sFic, 2)
+        sSrc = sOut &/ sFic
+      Else
+        sSrc = sHome &/ sFic
+      Endif
+      sDst = sOut &/ "fichiers" &/ sFic
+      Shell "mkdir -p " & Shell$(File.Dir(sDst)) Wait
+      If Exist(sSrc) And If Not IsDir(sSrc) Then
+        Copy sSrc To sDst
+      Else
+        File.Save(sDst, "<fichier absent>\n")
+      Endif
+    Next
+  Endif
+  Fin_Home(sHome)
+  iAttendu = 0
+  If cMeta.Exist("code_sortie") Then iAttendu = cMeta["code_sortie"]
+  Print "Rejeu " & IIf(sId, sId & " ", "") & sSpec & " : code " & iCode & " (attendu " & iAttendu & ") ; sorties dans " & sOut
+  Return iCode = iAttendu
+
 End
 
