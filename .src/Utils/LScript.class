' Gambas class file

Inherits Array
Create Static

Private $prog As String
Private $arguments As String[]
Private $runinshell As Boolean


Public Sub _New(Optional Program As String = "", Optional Arguments As String[] = [], Optional RunInShell As Boolean = True)
  
   $prog = Program
   $arguments = Arguments
   $runinshell = RunInShell
  
End

Public Sub _call(Optional Prog As String, Optional Argu As String[] = [], Optional RuSh As Boolean = True) As LScript

  Dim $CLScript As LScript
  
  $CLScript = New LScript(Prog, Argu, RuSh)
  Return $CLScript

End

Public Function Run() As Integer

  Utils.Log(Me, "Run script " & $prog & " " & $arguments.Join(" "), Logger.Info)
  
  If $prog = "debug" Then
    Show()
    Return 0
  Endif

  If $prog = "debug2" Then
    Show(False)
    Return 0
  Endif
  
  $arguments.Add($prog, 0)
  
  If $runinshell Then
    Try Shell $arguments.Join(" ") Wait
    If Error Then
      Utils.Log(Me, "Fail to run script (shell): " & Error.Text, Logger.Error)
      Return 1
    Endif
  Else 
    Try Exec $arguments Wait
    If Error Then
      Utils.Log(Me, "Fail to run script (exec): " & Error.Text, Logger.Error)
      Return 1
    Endif
  Endif
  
  Return 0

End

Public Sub RunA(Als As LScript[]) As Integer
  
  Dim $elem As LScript
  
  For Each $elem In Als
    If $elem.Run() Then Return 1
  Next
  
  Return 0
  
End


Private Function Show(Optional MessageBox As Boolean = True)

  Dim arglist As String
  
  arglist = $arguments.Join("\n")
  If MessageBox Then
    Message.Info("Le script sera executé avec les arguments suivant :\n" & arglist)
  Else
    Print "Le script sera executé avec les arguments suivant :\n" & arglist
  Endif

End

