+Private Function Test_Choisi(aTest As String[], sDemande As String, bListe As Boolean) As Boolean
+  ''True si le test correspond à l'élément de sélection sDemande (voir Run_Tests).
+
+  Dim iChamp As Integer
+  Dim bMotif As Boolean
+  Dim sValeur As String
+
+  If Not sDemande Then Return False
+  If sDemande = "all" Then Return aTest[8] = "1" Or bListe
+  bMotif = InStr(sDemande, "*") Or InStr(sDemande, "?") Or InStr(sDemande, "[")
+  For Each iChamp In [0, 1, 2, 3, 4, 5, 7]
+    sValeur = aTest[iChamp]
+    If Not sValeur Then Continue
+    If bMotif Then
+      If Not (LCase(sValeur) Like LCase(sDemande)) Then Continue
+    Else
+      If LCase(sValeur) <> LCase(sDemande) Then Continue
     Endif
+    ' scénario non validé : seulement s'il est listé, ou désigné exactement par son nom, son chemin ou lot/nom
+    If aTest[8] = "1" Or bListe Then Return True
+    If Not bMotif And If iChamp >= 3 And If iChamp <= 5 Then Return True
   Next
-  
-  If success Then
-    Print "*****************************"
+  Return False
+
+End
+
+Private Function Test_Id(sClasse As String, sMethode As String) As String
+  ''Identifiant test.md d'une méthode gb.test « Tnn<Objet> » : <CLASSE>-Tnn (ex. LPrix, T03Somme → LPRIX-T03).
+
+  Dim i As Integer = 2
+  Dim sCar As String
+
+  If Left(sMethode) <> "T" Then Return ""
+  While i <= Len(sMethode)
+    sCar = Mid(sMethode, i, 1)
+    If sCar < "0" Or If sCar > "9" Then Break
+    Inc i
+  Wend
+  If i = 2 Or If i > Len(sMethode) Then Return ""
+  sCar = Mid(sMethode, i, 1)
+  If sCar <> "_" And If (sCar < "A" Or sCar > "Z") Then Return ""
+  Return UCase(sClasse) & "-T" & Format(CInt(Mid(sMethode, 2, i - 2)), "00")
+
+End
+
+Private Function Meta_Texte(cMeta As Collection, sCle As String) As String
+  ''Valeur texte d'une clé de meta.json ("" si absente ou nulle).
+
+  If Not cMeta.Exist(sCle) Then Return ""
+  If IsNull(cMeta[sCle]) Then Return ""
+  Return CStr(cMeta[sCle])
+
+End
