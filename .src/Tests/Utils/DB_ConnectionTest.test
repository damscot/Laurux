'------------------------------------------------------------------------------- T08 erreurs d'Exec

Public Sub T08ErreurSql()

  Dim r As Result

  TestKit.OuvreBase()
  Try r = Utils.db.Exec("SELECT * FROM Fiches_Inexistante")
  If Error Then
    TestKit.Check("T08/erreur_sql/code", Error.Code)
    TestKit.Check("T08/erreur_sql/texte", Error.Text)
  Else
    TestKit.Check("T08/erreur_sql/code", "pas d'erreur")
  Endif
  Try r = Utils.db.Exec("SELEC version FROM Fiches_Parametres")
  If Error Then
    TestKit.Check("T08/syntaxe/code", Error.Code)
    TestKit.Check("T08/syntaxe/texte", Error.Text)
  Else
    TestKit.Check("T08/syntaxe/code", "pas d'erreur")
  Endif
  ' la connexion reste utilisable après l'erreur
  TestKit.Check("T08/apres_erreur", Lignes("SELECT version FROM Fiches_Parametres"))

End

Public Sub T08ConnexionFermee()

  TestKit.OuvreBase()
  Utils.db.Close()
  TestKit.Check("T08/fermee/opened", Utils.db.Opened)
  TestKit.Check("T08/fermee/exec", Lignes("SELECT version FROM Fiches_Parametres"))

End

'------------------------------------------------------------------------------------- T09 Lockstock

Private Sub EtatArt(Code As String) As String

  Return Lignes("SELECT art_qte, art_pmp FROM Fiches_Art WHERE art_code = &1", Code)

End

Public Sub T09Lockstock()

  Dim fQ As Float

  TestKit.OuvreBase()
  Utils.db.Exec("UPdate Fiches_Art SET art_stocke = 1, art_qte = 10, art_pmp = 5 WHERE art_code = '001'")
  Utils.db.Exec("UPdate Fiches_Art SET art_stocke = 1, art_qte = 0, art_pmp = 3 WHERE art_code = '002'")
  ' 001 : entrée avec pmp
  Try fQ = Utils.db.Lockstock("001", 5, "+", True, 8)
  If Error Then fQ = -999
  TestKit.Check("T09/entree_pmp/retour", fQ)
  TestKit.Check("T09/entree_pmp/base", EtatArt("001"))
  ' 001 : sortie sans pmp
  Try fQ = Utils.db.Lockstock("001", 3, "-")
  If Error Then fQ = -999
  TestKit.Check("T09/sortie/retour", fQ)
  TestKit.Check("T09/sortie/base", EtatArt("001"))
  ' 001 : sortie qui annule le stock, avec pmp
  Try fQ = Utils.db.Lockstock("001", 12, "-", True, 4)
  If Error Then fQ = -999
  TestKit.Check("T09/sortie_totale_pmp/retour", fQ)
  TestKit.Check("T09/sortie_totale_pmp/base", EtatArt("001"))
  ' 002 : stock nul, entrée avec pmp
  Try fQ = Utils.db.Lockstock("002", 4, "+", True, 7)
  If Error Then fQ = -999
  TestKit.Check("T09/stock_nul/retour", fQ)
  TestKit.Check("T09/stock_nul/base", EtatArt("002"))
  ' 003 : article non stocké
  Try fQ = Utils.db.Lockstock("003", 4, "+", True, 7)
  If Error Then fQ = -999
  TestKit.Check("T09/non_stocke/retour", fQ)
  TestKit.Check("T09/non_stocke/base", EtatArt("003"))
  ' article inexistant
  Try fQ = Utils.db.Lockstock("ZZZ", 1)
  If Error Then fQ = -999
  TestKit.Check("T09/inexistant/retour", fQ)

End

'---------------------------------------------------------------------------------- T10 LockIncrement

Private Sub Incremente(Cle As String, Champ As String, Optional Forme As String = "0")

  Dim r As Result

  Try r = Utils.db.LockIncrement(Champ, "Fiches_Parametres", Forme)
  If Error Then
    TestKit.Check(Cle & "/retour", "ERREUR: " & Error.Text)
  Else
    TestKit.Check(Cle & "/retour", r[Champ])
  Endif
  TestKit.Check(Cle & "/base", Lignes("SELECT " & Champ & " FROM Fiches_Parametres"))

End

Public Sub T10LockIncrement()

  TestKit.OuvreBase()
  Incremente("T10/int", "numecriture")
  Incremente("T10/int/2e", "numecriture")
  Incremente("T10/chaine_000000", "dnbon", "000000")
  Incremente("T10/chaine_defaut", "dnfac")
  Incremente("T10/chaine_null", "dncom")
  ' Table vide : Message.Error bloquant, non exercé (à faire après DB_CONNECTION-007)

End

'----------------------------------------------------------------------------------------- T11 RecArt

Private Sub Recherche(Cle As String, Art As String, Optional Four As String)

  Dim r As Result

  Try r = Utils.db.RecArt(Art, Four)
  If Error Then
    TestKit.Check(Cle, "ERREUR: " & Error.Text)
  Else If r.Available Then
    TestKit.Check(Cle, r!art_code & " (" & r.Count & ")")
  Else
    TestKit.Check(Cle, "<aucune ligne>")
  Endif

End

Public Sub T11RecArt()

  TestKit.OuvreBase()
  Utils.db.Exec("UPdate Fiches_Art SET art_cfour = 'CF-002' WHERE art_code = '002'")
  Utils.db.Exec("UPdate Fiches_Art SET art_refcentrale = 'RC-003' WHERE art_code = '003'")
  Utils.db.Exec("INSERT INTO Fiches_CdBarre (codep, codeb) VALUES ('002', '3000000000017')")
  Recherche("T11/code", "001")
  Recherche("T11/code_fournisseur", "CF-002")
  Recherche("T11/ref_centrale", "RC-003")
  Recherche("T11/code_barre_table", "*3000000000017")
  Recherche("T11/code_barre_art_code", "*001")
  Recherche("T11/code_barre_inconnu", "*9999999999999")
  Recherche("T11/inexistant", "ZZZ")
  Recherche("T11/vide", "")
  Recherche("T11/four_ok", "001", "401001")
  Recherche("T11/four_autre", "001", "999999")
  Start.LocalSettings["/Soc" & Start.Societe & "/bois"] = True
  Recherche("T11/option_B", "001")

End

'---------------------------------------------------------------------------- T12 requêtes préparées

Public Sub T12Preparees()

  Dim r As Result

  TestKit.OuvreBase()
  Try Utils.db.Prepare("req_simple", "SELECT art_code, art_design FROM Fiches_Art WHERE art_code = @code")
  If Error Then TestKit.Check("T12/simple/prepare", "ERREUR: " & Error.Text)
  Try Utils.db.Set("@code", "002")
  If Error Then TestKit.Check("T12/simple/set", "ERREUR: " & Error.Text)
  Try r = Utils.db.Execute("req_simple")
  If Error Then
    TestKit.Check("T12/simple/execute", "ERREUR: " & Error.Text)
  Else
    TestKit.Check("T12/simple/execute", r!art_code & "," & r!art_design)
  Endif
  ' Comme VarMajTar (requ_cli/requ_typ) : argument &1 substitué dans le texte quoté du PREPARE
  Try Utils.db.Prepare("req_param", "SELECT art_code FROM Fiches_Art WHERE art_code = @code AND art_four = &1", "401001")
  If Error Then TestKit.Check("T12/param/prepare", "ERREUR: " & Error.Text)
  Try r = Utils.db.Execute("req_param")
  If Error Then
    TestKit.Check("T12/param/execute", "ERREUR: " & Error.Text)
  Else
    TestKit.Check("T12/param/execute", r!art_code)
  Endif
  Try Utils.db.Set("@num", 12.5)
  If Error Then TestKit.Check("T12/set_float", "ERREUR: " & Error.Text)
  TestKit.Check("T12/set_float/relu", Lignes("SELECT @num AS v"))

End

'------------------------------------------------------------------------------------- T13 CopieTable

Public Sub T13CopieMysql()

  TestKit.OuvreBase()
  Try Utils.db.CopieTable("Fiches_Mvt1", "Fiches_CopieTest")
  If Error Then TestKit.Check("T13/mysql/erreur", Error.Text)
  TestKit.Check("T13/mysql/colonnes", Lignes("SHOW COLUMNS FROM Fiches_CopieTest"))
  TestKit.Check("T13/mysql/index", Lignes("SELECT index_name, column_name, seq_in_index FROM information_schema.statistics WHERE table_schema = DATABASE() AND table_name = 'Fiches_CopieTest' ORDER BY index_name, seq_in_index"))

End

Public Sub T13CopieSqlite()

  OuvreSqlite()
  Try Utils.db.CopieTable("Fiches_Mvt1", "Fiches_CopieTest")
  If Error Then TestKit.Check("T13/sqlite/erreur", Error.Text)
  TestKit.Check("T13/sqlite/table", Lignes("SELECT name FROM sqlite_master WHERE name LIKE 'Fiches_CopieTest%' OR name LIKE 'idx_Fiches_CopieTest%'"))

End

'------------------------------------------------------------------------------------- T14 Edit/Create9

Public Sub T14EditCreate()

  Dim r As Result

  TestKit.OuvreBase()
  r = Utils.db.Edit(Cbase.Table("TabParam"), "ind = &1", 0)
  r!devise = "Dollars"
  r.Update
  TestKit.Check("T14/edit/base", Lignes("SELECT ind, devise FROM Fiches_Parametres"))
  r = Utils.db.Edit(Cbase.Table("TabParam"), "ind = &1", 99)
  TestKit.Check("T14/edit/absent/disponible", r.Available)
  r = Utils.db.Create9("Fiches_Reglements")
  r!code = "ZZ"
  r!libel = "Règlement test"
  r!journal = "BQ"
  r!cptint = "512000"
  r!bordereaux = 0
  r!lcr = 0
  r!caisse = 1
  r!decaissement = 0
  r!regroup = 0
  r.Update
  TestKit.Check("T14/create9/base", Lignes("SELECT * FROM Fiches_Reglements ORDER BY code"))

End

